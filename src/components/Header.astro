
---
const navItems = [
  { name: "Home", href: "/" },
  { name: "Portfolio", href: "/portfolio" },
  { name: "Pakete & Preise", href: "/pakete" },
  { name: "Zusatzleistungen", href: "/zusatzleistungen" },
  { name: "Über mich", href: "/ueber-mich" },
  { name: "Bewertungen", href: "/bewertungen" },
];

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isHome = path === "/";
const isActive = (href) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
---

<header id="siteHeader" class:list={["site-header", { "is-home": isHome }]}>
  <div class="header-inner">
    <a href="/" class="logo" aria-label="VJ Production Startseite">
      <img class="logo-dark" src="/images/vj-logo-dark.png" alt="VJ Production" width="112" height="65" />
      <img class="logo-light" src="/images/vj-logo-white.png" alt="" aria-hidden="true" width="112" height="65" />
    </a>

    <nav class="desktop-nav" aria-label="Hauptnavigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={{ "is-active": isActive(item.href) }}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.name}
        </a>
      ))}
      <a
        href="/kontakt"
        class="nav-cta"
        aria-current={isActive("/kontakt") ? "page" : undefined}
      >
        Anfragen <span aria-hidden="true">↗</span>
      </a>
    </nav>

    <button
      id="menuButton"
      class="menu-button"
      type="button"
      aria-label="Menü öffnen"
      aria-controls="mobileNav"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
    </button>
  </div>

  <nav id="mobileNav" class="mobile-nav" aria-label="Mobile Navigation" hidden>
    <div class="mobile-nav-inner">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={{ "is-active": isActive(item.href) }}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.name}
        </a>
      ))}
      <a class="mobile-cta" href="/kontakt">
        Verfügbarkeit anfragen <span aria-hidden="true">↗</span>
      </a>
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    const header = document.getElementById("siteHeader");
    const button = document.getElementById("menuButton");
    const menu = document.getElementById("mobileNav");

    if (!header || !button || !menu) return;

    function updateHeader() {
      header.classList.toggle("is-scrolled", window.scrollY > 35);
    }

    function closeMenu() {
      menu.hidden = true;
      button.classList.remove("is-open");
      button.setAttribute("aria-expanded", "false");
      button.setAttribute("aria-label", "Menü öffnen");
      document.body.classList.remove("vj-mobile-menu-open");
    }

    function openMenu() {
      menu.hidden = false;
      button.classList.add("is-open");
      button.setAttribute("aria-expanded", "true");
      button.setAttribute("aria-label", "Menü schließen");
      document.body.classList.add("vj-mobile-menu-open");
    }

    updateHeader();

    window.addEventListener("scroll", updateHeader, { passive: true });
    window.addEventListener("pageshow", updateHeader);

    button.addEventListener("click", () => {
      menu.hidden ? openMenu() : closeMenu();
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !menu.hidden) {
        closeMenu();
        button.focus();
      }
    });

    document.addEventListener("pointerdown", (event) => {
      if (!menu.hidden && !header.contains(event.target)) {
        closeMenu();
      }
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth > 980) closeMenu();
    });
  })();
</script>

<style>
  .site-header {
    --ink: #17181d;
    --accent: #b46300;
    position: fixed;
    inset: 0 0 auto;
    z-index: 1100;
    height: 86px;
    background: rgba(255,255,255,.98);
    box-shadow: 0 1px 0 rgba(23,24,29,.06);
    transition: height .25s, background .25s, box-shadow .25s;
  }

  .site-header.is-scrolled {
    height: 75px;
    background: rgba(255,255,255,.97);
    box-shadow: 0 8px 30px rgba(0,0,0,.075);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
  }

  .site-header.is-home:not(.is-scrolled) {
    background: transparent;
    box-shadow: none;
  }

  .header-inner {
    width: min(1380px, calc(100% - 52px));
    height: 100%;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }

  .logo {
    flex: 0 0 112px;
    width: 112px;
    height: 65px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .logo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .logo-light { display: none !important; }

  .is-home:not(.is-scrolled) .logo-dark {
    display: none !important;
  }

  .is-home:not(.is-scrolled) .logo-light {
    display: block !important;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(13px, 1.7vw, 27px);
  }

  .desktop-nav > a:not(.nav-cta) {
    color: var(--ink);
    font-size: 14px !important;
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
    text-decoration: none;
    transition: color .2s;
  }

  .desktop-nav > a:not(.nav-cta):hover,
  .desktop-nav > a.is-active:not(.nav-cta) {
    color: var(--accent);
  }

  .is-home:not(.is-scrolled) .desktop-nav > a:not(.nav-cta) {
    color: white;
    text-shadow: 0 1px 8px rgba(0,0,0,.35);
  }

  .is-home:not(.is-scrolled) .desktop-nav > a:not(.nav-cta):hover {
    color: #ffd49b;
  }

  .desktop-nav .nav-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 43px;
    padding: 10px 19px;
    border-radius: 7px;
    background: var(--accent);
    color: white !important;
    font-size: 13px !important;
    font-weight: 800;
    white-space: nowrap;
    text-decoration: none;
    transition: background .2s, transform .2s;
  }

  .nav-cta:hover {
    background: #965000;
    transform: translateY(-1px);
  }

  .menu-button { display: none; }
  .mobile-nav { display: none; }

  .menu-button {
    position: relative;
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    border: 0;
    border-radius: 8px;
    background: var(--ink);
    cursor: pointer;
  }

  .menu-button span {
    position: absolute;
    left: 12px;
    right: 12px;
    height: 2px;
    background: white;
    border-radius: 2px;
    transition: transform .2s;
  }

  .menu-button span:first-child { top: 17px; }
  .menu-button span:last-child { top: 26px; }

  .menu-button.is-open span:first-child {
    transform: translateY(4.5px) rotate(45deg);
  }

  .menu-button.is-open span:last-child {
    transform: translateY(-4.5px) rotate(-45deg);
  }

  @media (max-width: 980px) {
    .site-header,
    .site-header.is-scrolled,
    .site-header.is-home:not(.is-scrolled) {
      height: 76px;
      background: rgba(255,255,255,.98);
      box-shadow: 0 3px 20px rgba(0,0,0,.065);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
    }

    .header-inner { width: calc(100% - 32px); }
    .logo { width: 99px; height: 58px; flex-basis: 99px; }

    .is-home:not(.is-scrolled) .logo-dark {
      display: block !important;
    }

    .is-home:not(.is-scrolled) .logo-light {
      display: none !important;
    }

    .desktop-nav { display: none; }
    .menu-button { display: block; }

    .mobile-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: block;
      max-height: calc(100dvh - 76px);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: 15px 16px 28px;
      background: rgba(255,255,255,.99);
      border-top: 1px solid #ededee;
      box-shadow: 0 20px 40px rgba(0,0,0,.11);
    }

    .mobile-nav[hidden] { display: none !important; }

    .mobile-nav-inner {
      display: flex;
      flex-direction: column;
      width: min(680px, 100%);
      margin: auto;
    }

    .mobile-nav-inner > a:not(.mobile-cta) {
      padding: 15px 10px;
      border-bottom: 1px solid #eee;
      color: var(--ink);
      font-size: 16px;
      font-weight: 600;
      text-decoration: none;
    }

    .mobile-nav-inner > a.is-active {
      color: var(--accent);
    }

    .mobile-nav .mobile-cta {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 13px;
      margin-top: 22px;
      padding: 15px 18px;
      border-radius: 8px;
      background: var(--accent);
      color: white !important;
      font-size: 15px;
      font-weight: 800;
      text-decoration: none;
    }

    :global(body.vj-mobile-menu-open) { overflow: hidden; }
  }

  @media (max-width: 620px) {
    .logo { width: 90px; height: 54px; flex-basis: 90px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header, .menu-button span, .nav-cta {
      transition: none;
    }
  }
</style>
