<div class="vj-cookie-banner" id="vjCookieBanner">
  <button class="vj-cookie-close" id="vjCookieClose" type="button" aria-label="Cookie Hinweis schließen">
    ×
  </button>

  <h2>Cookie & Datenschutz</h2>

  <p>
    Diese Website nutzt technisch notwendige Cookies sowie ggf. optionale Dienste.
    Du kannst selbst entscheiden, ob du optionale Cookies akzeptierst.
    Weitere Informationen findest du in der
    <a href="/datenschutz">Datenschutzerklärung</a>.
  </p>

  <div class="vj-cookie-actions">
    <button class="vj-cookie-button secondary" id="vjCookieReject" type="button">
      Ablehnen
    </button>

    <button class="vj-cookie-button primary" id="vjCookieAccept" type="button">
      Akzeptieren
    </button>
  </div>
</div>

<script is:inline>
  (() => {
    const STORAGE_KEY = "vj-cookie-consent";
    const banner = document.getElementById("vjCookieBanner");
    const acceptButton = document.getElementById("vjCookieAccept");
    const rejectButton = document.getElementById("vjCookieReject");
    const closeButton = document.getElementById("vjCookieClose");

    if (!banner) return;

    const savedConsent = localStorage.getItem(STORAGE_KEY);

    if (savedConsent) {
      banner.style.display = "none";
    } else {
      banner.style.display = "block";
    }

    function saveConsent(value) {
      localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify({
          value,
          date: new Date().toISOString(),
        })
      );

      banner.style.display = "none";
    }

    acceptButton?.addEventListener("click", () => saveConsent("accepted"));
    rejectButton?.addEventListener("click", () => saveConsent("rejected"));
    closeButton?.addEventListener("click", () => saveConsent("rejected"));
  })();
</script>

