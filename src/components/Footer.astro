
---
const year = new Date().getFullYear();

const navigation = [
  { label: "Home", href: "/" },
  { label: "Portfolio", href: "/portfolio" },
  { label: "Pakete & Preise", href: "/pakete" },
  { label: "Zusatzleistungen", href: "/zusatzleistungen" },
  { label: "Über mich", href: "/ueber-mich" },
  { label: "Bewertungen", href: "/bewertungen" },
  { label: "Kontakt", href: "/kontakt" },
];

const legal = [
  { label: "Impressum", href: "/impressum" },
  { label: "Datenschutz", href: "/datenschutz" },
  { label: "AGB", href: "/agb" },
  { label: "Widerrufsbelehrung", href: "/widerruf" },
];
---

<footer class="vj-footer">
  <div class="vj-footer-inner">
    <div class="vj-footer-grid">
      <div class="vj-footer-brand">
        <a href="/" class="vj-footer-logo" aria-label="VJ Production Startseite">
          <img src="/images/vj-logo-white.png" alt="VJ Production" width="118" height="80" loading="lazy" />
        </a>

        <p class="vj-footer-slogan">
          Emotionen für immer festgehalten.<br />
          Euer Tag, eure Geschichte.
        </p>

        <p class="vj-footer-location">
          Hochzeitsvideograf aus Witten.<br />
          In NRW und deutschlandweit.
        </p>

        <a class="vj-footer-button" href="/kontakt">
          Hochzeit anfragen <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="vj-footer-column">
        <h3>Entdecken</h3>
        <nav aria-label="Footernavigation">
          {navigation.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
      </div>

      <div class="vj-footer-column">
        <h3>Kontakt</h3>
        <div class="vj-contact-links">
          <a href="mailto:info@vjproduction.de">
            <span class="vj-contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <rect x="3.5" y="5.5" width="17" height="13" rx="2"></rect>
                <path d="M4.5 7.5 12 13l7.5-5.5"></path>
              </svg>
            </span>
            <span>info@vjproduction.de</span>
          </a>

          <a href="tel:+4915561237671">
            <span class="vj-contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M7.4 4.5 9.8 9c.3.6.2 1.3-.3 1.8l-1.2 1.2a13.5 13.5 0 0 0 5.7 5.7l1.2-1.2c.5-.5 1.2-.6 1.8-.3l4.5 2.4c.7.4 1 1.2.7 1.9-.4 1-1.3 2.3-3 2.3C10.1 22.8 1.2 13.9 1.2 4.8c0-1.7 1.3-2.6 2.3-3 .7-.3 1.5 0 1.9.7Z"></path>
              </svg>
            </span>
            <span>+49 1556 1237671</span>
          </a>

          <a
            href="https://www.instagram.com/v.j.production?igsh=MXh2MXIzeWJhc3U4bQ%3D%3D&utm_source=qr"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="vj-contact-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
                <circle cx="12" cy="12" r="4"></circle>
                <circle cx="17.2" cy="6.8" r="1.1"></circle>
              </svg>
            </span>
            <span>Instagram</span>
          </a>
        </div>
      </div>
    </div>

    <div class="vj-footer-bottom">
      <p class="vj-copyright">
        © {year} VJ Production. Alle Rechte vorbehalten.
      </p>

      <nav class="vj-legal-links" aria-label="Rechtliche Informationen">
        {legal.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </nav>
    </div>
  </div>
</footer>

<style>
  .vj-footer {
    background: #17181d;
    color: white;
    padding: 83px 24px 34px;
  }

  .vj-footer-inner {
    width: min(1200px, 100%);
    margin: auto;
  }

  .vj-footer-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    align-items: start;
    gap: clamp(36px, 6vw, 100px);
  }

  .vj-footer-logo {
    display: inline-flex;
    width: 118px;
    height: 80px;
    margin-bottom: 20px;
  }

  .vj-footer-logo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .vj-footer-brand p { margin: 0; }

  .vj-footer-brand .vj-footer-slogan {
    color: rgba(255,255,255,.86);
    font-size: 15px !important;
    line-height: 1.65;
  }

  .vj-footer-brand .vj-footer-location {
    margin-top: 21px;
    color: rgba(255,255,255,.56);
    font-size: 14px !important;
    line-height: 1.75;
  }

  .vj-footer-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 44px;
    margin-top: 26px;
    padding: 11px 18px;
    border: 1px solid rgba(255,180,90,.55);
    border-radius: 7px;
    color: #ffbd71;
    background: rgba(180,99,0,.12);
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    transition: background .2s;
  }

  .vj-footer-button:hover {
    background: rgba(180,99,0,.26);
  }

  .vj-footer-column h3 {
    margin: 16px 0 26px;
    color: #ffb45a;
    font-size: 12px !important;
    font-weight: 800;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  .vj-footer-column nav,
  .vj-contact-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 15px;
  }

  .vj-footer-column a,
  .vj-contact-links a {
    color: rgba(255,255,255,.69);
    font-size: 14px !important;
    line-height: 1.6;
    text-decoration: none;
    transition: color .2s;
  }

  .vj-footer-column a:hover,
  .vj-contact-links a:hover {
    color: #ffb45a;
  }

  .vj-contact-links a {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .vj-contact-links a span:last-child {
    overflow-wrap: anywhere;
  }

  .vj-contact-icon {
    display: inline-flex;
    flex: 0 0 21px;
    width: 21px;
    height: 21px;
    color: #ffb45a;
  }

  .vj-contact-icon svg {
    width: 21px;
    height: 21px;
  }

  .vj-contact-icon svg path,
  .vj-contact-icon svg rect,
  .vj-contact-icon svg circle {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .vj-footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
    margin-top: 70px;
    padding-top: 29px;
    border-top: 1px solid rgba(255,255,255,.13);
  }

  .vj-footer .vj-copyright {
    margin: 0;
    color: rgba(255,255,255,.48);
    font-size: 12px !important;
  }

  .vj-legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 13px 23px;
  }

  .vj-legal-links a {
    color: rgba(255,255,255,.62);
    font-size: 12px;
    text-decoration: none;
  }

  .vj-legal-links a:hover { color: #ffb45a; }

  @media (max-width: 850px) {
    .vj-footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 48px;
    }

    .vj-footer-brand { grid-column: 1 / -1; }
  }

  @media (max-width: 600px) {
    .vj-footer { padding: 60px 20px 30px; }

    .vj-footer-grid {
      grid-template-columns: 1fr;
      gap: 38px;
    }

    .vj-footer-brand { grid-column: auto; }
    .vj-footer-column h3 { margin: 0 0 19px; }

    .vj-footer-bottom {
      flex-direction: column-reverse;
      align-items: flex-start;
      margin-top: 52px;
    }
  }
</style>
