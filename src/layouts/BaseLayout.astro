---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";

const {
  title = "VJ Production | Hochzeitsvideograf in NRW",
  description = "Hochzeitsvideograf aus Witten für emotionale Hochzeitsfilme in NRW und deutschlandweit.",
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <link rel="apple-touch-icon" href="/favicon.jpg" />

    <title>{title}</title>
  </head>

  <body>
    <Header />

    <main id="pageContent">
      <slot />
    </main>

    <Footer />

    <CookieBanner />

    <script is:inline>
      const revealSelectors = [
        "main h1",
        "main h2",
        "main h3",
        "main p",
        "main .section-head",
        "main .video-item",
        "main .video-card",
        "main .package-card",
        "main .extra-card",
        "main .review-card",
        "main .after-card",
        "main .portfolio-offer",
        "main .cta",
        "main .step-card",
        "main .timeline-item",
        "main form",
        "main .form-grid",
        "main .option-card",
        "main .check-card"
      ];

      const revealElements = document.querySelectorAll(revealSelectors.join(","));

      revealElements.forEach((element, index) => {
        if (
          element.closest(".hero") ||
          element.closest("header") ||
          element.closest("footer") ||
          element.closest(".vj-cookie-banner") ||
          element.classList.contains("no-reveal")
        ) {
          return;
        }

        element.classList.add("reveal-on-scroll");

        const delay = Math.min(index % 6, 5) * 70;
        element.style.setProperty("--reveal-delay", `${delay}ms`);
      });

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        {
          threshold: 0.14,
          rootMargin: "0px 0px -8% 0px",
        }
      );

      document.querySelectorAll(".reveal-on-scroll").forEach((element) => {
        observer.observe(element);
      });
    </script>
  </body>
</html>

<style is:global>
  /* ============================= */
  /* VJ Production Global Reset */
  /* ============================= */

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    background: #ffffff;
    color: #17181d;
    font-size: 16px;
    line-height: 1.5;
    text-rendering: geometricPrecision;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  input,
  textarea,
  select {
    font-family: inherit;
  }

  button {
    cursor: pointer;
  }

  img,
  video,
  svg {
    max-width: 100%;
  }

  main {
    min-height: 60vh;
  }

  /* ============================= */
  /* VJ Production Typografie-System */
  /* Nur Schriftgrößen / Rhythmus */
  /* Keine Farben und kein Layout werden verändert */
  /* ============================= */

  :root {
    --font-main: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;

    /* Kleine Texte */
    --vj-text-xs: 12px;
    --vj-text-sm: 14px;
    --vj-text-base: 16px;
    --vj-text-md: 17px;
    --vj-text-lg: 18px;
    --vj-text-xl: 20px;
    --vj-text-2xl: 24px;
    --vj-text-3xl: 30px;

    /* Titel */
    --vj-title-card: clamp(20px, 1.7vw, 24px);
    --vj-title-section: clamp(34px, 4.2vw, 56px);
    --vj-title-page: clamp(42px, 5.6vw, 76px);
    --vj-title-hero: clamp(42px, 5.4vw, 72px);

    /* Zeilenhöhen */
    --vj-leading-tight: 1.05;
    --vj-leading-title: 1.08;
    --vj-leading-normal: 1.6;
    --vj-leading-relaxed: 1.72;

    /* Standard-Abstände für Textblöcke */
    --vj-section-space: 96px;
    --vj-section-space-sm: 72px;
  }

  /* Kleine orange Labels: PORTFOLIO, PREISE, BEWERTUNGEN usw. */
  .kicker,
  .section-kicker,
  .section-head p,
  .portfolio-head p,
  .prices-head p,
  .extras-head p,
  .reviews-head > p,
  .kontakt-head p,
  .late-hero .kicker,
  .hero-text p,
  .modal-kicker {
    font-size: var(--vj-text-xs) !important;
    line-height: 1.2;
  }

  /* Große Seitentitel */
  .page-title,
  .portfolio-head h1,
  .prices-head h1,
  .extras-head h1,
  .kontakt-head h1,
  .late-hero h1,
  .hero-text h1,
  .reviews-head h1,
  .modal-panel h2 {
    font-size: var(--vj-title-page) !important;
    line-height: var(--vj-leading-title);
  }

  /* Große Section-Titel */
  .section-title,
  .section-head h2,
  .process > h2,
  .packages > h2,
  .extras > h2,
  .faq-section > h2,
  .more-extras > h2,
  .story h2,
  .why h2,
  .cta h2 {
    font-size: var(--vj-title-section) !important;
    line-height: var(--vj-leading-title);
  }

  /* Card-Titel */
  .card-title,
  .video-text h2,
  .video-item h2,
  .extra-card h3,
  .package-card h2,
  .package-card h3,
  .late-card h2,
  .late-video-card h2,
  .benefit-card h2,
  .review-author strong,
  .reason-item h3 {
    font-size: var(--vj-title-card);
    line-height: 1.18;
  }

  /* Normale Texte */
  .intro p,
  .video-text p,
  .video-item p,
  .package-card li,
  .extra-card p,
  .late-card p,
  .late-video-card p,
  .notes-box p,
  .benefit-card p,
  .reason-item p,
  .modal-subtitle,
  .offer-details,
  .discount-box p {
    font-size: var(--vj-text-base);
    line-height: var(--vj-leading-normal);
  }

  /* Größere Lesetexte, aber nicht riesig */
  .hero-text span,
  .late-hero .hero-text,
  .important-box p,
  .process-item p,
  .story p {
    font-size: clamp(17px, 1.55vw, 21px) !important;
    line-height: var(--vj-leading-relaxed);
  }

  /* Bewertungen: vorher deutlich zu groß */
  .review-text,
  .review-card > p {
    font-size: clamp(17px, 1.45vw, 21px) !important;
    line-height: 1.65 !important;
    letter-spacing: -0.015em !important;
  }

  .review-author span,
  .package-subtitle,
  .subtitle,
  .prices-head span,
  .prices-head small,
  .extras-head span,
  .kontakt-head span {
    font-size: var(--vj-text-base) !important;
    line-height: var(--vj-leading-normal);
  }

  /* FAQ */
  summary {
    font-size: var(--vj-text-lg) !important;
    line-height: 1.35;
  }

  details p {
    font-size: var(--vj-text-base) !important;
    line-height: var(--vj-leading-relaxed);
  }

  /* Formulare */
  legend,
  label > span {
    font-size: var(--vj-text-md) !important;
    line-height: 1.35;
  }

  input,
  select,
  textarea {
    font-size: var(--vj-text-base) !important;
  }

  .option-card,
  .check-card,
  .contact-way label {
    font-size: var(--vj-text-lg) !important;
    line-height: 1.35;
  }

  .consent,
  .consent span {
    font-size: var(--vj-text-base) !important;
    line-height: var(--vj-leading-normal);
  }

  /* Buttons */
  button,
  .primary-button,
  .secondary-button,
  .cta a,
  .package-card a,
  .package-button,
  .submit-button,
  .submit-review,
  .details-button,
  .late-card a,
  .late-video-card a,
  .offer-toggle {
    font-size: var(--vj-text-base) !important;
    line-height: 1.2;
  }

  /* Navigation */
  .nav-link,
  .vj-nav-link,
  .desktop-nav a,
  header nav a {
    font-size: var(--vj-text-sm);
  }

  .mobile-link,
  .vj-mobile-link {
    font-size: var(--vj-text-lg);
  }

  /* Footer etwas ruhiger */
  .vj-footer-brand p,
  .vj-footer-column a,
  .vj-contact-links a {
    font-size: var(--vj-text-base) !important;
    line-height: 1.55;
  }

  .vj-footer-column h3 {
    font-size: var(--vj-text-base) !important;
  }

  .vj-copyright {
    font-size: var(--vj-text-sm) !important;
  }

  /* ============================= */
  /* Cookie Banner bleibt immer sichtbar und wird nicht animiert */
  /* ============================= */

  .vj-cookie-banner,
  .vj-cookie-banner * {
    animation: none !important;
  }

  .vj-cookie-banner {
    opacity: 1 !important;
    transform: none !important;
  }

  /* ============================= */
  /* Scroll Animation */
  /* ============================= */

  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(34px);
    transition:
      opacity 0.85s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
    will-change: opacity, transform;
  }

  .reveal-on-scroll.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .scroll-mouse,
  .mouse-scroll,
  .mouse-indicator,
  .scroll-indicator {
    animation: mouseFloat 1.65s ease-in-out infinite;
    will-change: transform;
  }

  @keyframes mouseFloat {
    0% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(12px);
    }

    100% {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    .reveal-on-scroll {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    .scroll-mouse,
    .mouse-scroll,
    .mouse-indicator,
    .scroll-indicator {
      animation: none !important;
    }
  }

  @media (max-width: 700px) {
    :root {
      --vj-title-section: clamp(32px, 9vw, 46px);
      --vj-title-page: clamp(38px, 11vw, 56px);
      --vj-title-hero: clamp(38px, 10vw, 58px);
    }

    .review-text,
    .review-card > p {
      font-size: 17px !important;
    }

    .hero-text span,
    .late-hero .hero-text,
    .important-box p,
    .process-item p,
    .story p {
      font-size: 17px !important;
    }

    .option-card,
    .check-card,
    .contact-way label {
      font-size: var(--vj-text-base) !important;
    }
  }
</style>