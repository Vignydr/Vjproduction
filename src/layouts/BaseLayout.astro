
---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";

const {
  title = "VJ Production | Hochzeitsvideograf in NRW",
  description = "Hochzeitsvideograf aus Witten für emotionale Hochzeitsfilme in NRW und deutschlandweit.",
} = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <link rel="apple-touch-icon" href="/favicon.jpg" />

    <title>{title}</title>

    <!-- GOOGLE ADS, CONSENT MODE UND META PIXEL -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];

      window.gtag =
        window.gtag ||
        function () {
          window.dataLayer.push(arguments);
        };

      function readVjCookieConsent() {
        try {
          const rawValue = localStorage.getItem("vj-cookie-consent");

          if (!rawValue) return null;

          const parsedValue = JSON.parse(rawValue);

          if (
            parsedValue?.value !== "accepted" &&
            parsedValue?.value !== "rejected"
          ) {
            return null;
          }

          return parsedValue.value;
        } catch (error) {
          console.warn(
            "Cookie-Auswahl konnte nicht gelesen werden:",
            error
          );
          return null;
        }
      }

      const storedCookieConsent = readVjCookieConsent();
      const hasAdvertisingConsent =
        storedCookieConsent === "accepted";

      const initialConsentState =
        hasAdvertisingConsent ? "granted" : "denied";

      window.gtag("consent", "default", {
        ad_storage: initialConsentState,
        analytics_storage: initialConsentState,
        ad_user_data: initialConsentState,
        ad_personalization: initialConsentState,
        wait_for_update: 500,
      });

      window.gtag("js", new Date());
      window.gtag("config", "AW-17951138748");

      const isProductionWebsite =
        window.location.hostname === "vjproduction.de" ||
        window.location.hostname === "www.vjproduction.de";

      const isContactThankYouPage =
        window.location.pathname === "/danke" ||
        window.location.pathname === "/danke/";

      let contactSubmissionTimestamp = 0;

      try {
        contactSubmissionTimestamp = Number(
          sessionStorage.getItem("vjContactFormSubmittedAt")
        );
      } catch (error) {
        console.warn(
          "Formularstatus konnte nicht gelesen werden:",
          error
        );
      }

      const contactSubmissionAge =
        Date.now() - contactSubmissionTimestamp;

      const isRecentContactSubmission =
        Number.isFinite(contactSubmissionTimestamp) &&
        contactSubmissionTimestamp > 0 &&
        contactSubmissionAge >= 0 &&
        contactSubmissionAge <= 10 * 60 * 1000;

      window.__vjValidContactSubmission =
        isProductionWebsite &&
        isContactThankYouPage &&
        isRecentContactSubmission;

      if (window.__vjValidContactSubmission) {
        window.gtag("event", "conversion", {
          send_to: "AW-17951138748/bJpgCK2RyNYcELzH4u9C",
        });

        try {
          sessionStorage.removeItem("vjContactFormSubmittedAt");
        } catch (error) {
          console.warn(
            "Formularstatus konnte nicht entfernt werden:",
            error
          );
        }
      }

      window.__vjMetaPixelLoaded = false;
      window.__vjMetaLeadSent = false;

      window.vjLoadMetaPixel = function () {
        if (window.__vjMetaPixelLoaded) return;

        window.__vjMetaPixelLoaded = true;

        !(function (f, b, e, v, n, t, s) {
          if (f.fbq) return;

          n = f.fbq = function () {
            n.callMethod
              ? n.callMethod.apply(n, arguments)
              : n.queue.push(arguments);
          };

          if (!f._fbq) f._fbq = n;

          n.push = n;
          n.loaded = true;
          n.version = "2.0";
          n.queue = [];

          t = b.createElement(e);
          t.async = true;
          t.src = v;

          s = b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t, s);
        })(
          window,
          document,
          "script",
          "https://connect.facebook.net/en_US/fbevents.js"
        );

        window.fbq("init", "1495532265309971");
        window.fbq("track", "PageView");

        if (
          window.__vjValidContactSubmission &&
          !window.__vjMetaLeadSent
        ) {
          window.__vjMetaLeadSent = true;
          window.fbq("track", "Lead");
        }

        if (
          window.location.pathname === "/danke-bewertung" ||
          window.location.pathname === "/danke-bewertung/"
        ) {
          window.fbq("track", "SubmitApplication");
        }
      };

      /*
       * Meta Pixel wird erst geladen, wenn die entsprechende
       * gespeicherte Zustimmung vorhanden ist.
       * Der CookieBanner kann vjLoadMetaPixel() nach
       * einer neu erteilten Zustimmung aufrufen.
       */
      if (hasAdvertisingConsent) {
        window.vjLoadMetaPixel();
      }
    </script>

    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=AW-17951138748"
    ></script>
    <!-- ENDE TRACKING -->
  </head>

  <body>
    <Header />

    <main id="pageContent">
      <slot />
    </main>

    <Footer />

    <CookieBanner />

    <!-- EINBLENDUNGEN BEIM SCROLLEN -->
    <script is:inline>
      (() => {
        const selectors = [
          "main h1",
          "main h2",
          "main h3",
          "main p",
          "main .video-card",
          "main .package-card",
          "main .extra-card",
          "main .review-card",
          "main .process-step",
          "main .timeline-item",
        ];

        const elements = document.querySelectorAll(
          selectors.join(",")
        );

        const reduceMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;

        if (reduceMotion) return;

        let index = 0;

        elements.forEach((element) => {
          if (
            element.closest(
              ".hero, header, footer, form, .review-modal, .vj-cookie-banner"
            ) ||
            element.classList.contains("no-reveal")
          ) {
            return;
          }

          element.classList.add("reveal-on-scroll");

          element.style.setProperty(
            "--reveal-delay",
            `${Math.min(index % 6, 5) * 70}ms`
          );

          index += 1;
        });

        const revealElements = document.querySelectorAll(
          ".reveal-on-scroll"
        );

        if ("IntersectionObserver" in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  observer.unobserve(entry.target);
                }
              });
            },
            {
              threshold: 0.12,
              rootMargin: "0px 0px -7% 0px",
            }
          );

          revealElements.forEach((element) => {
            observer.observe(element);
          });
        } else {
          revealElements.forEach((element) => {
            element.classList.add("is-visible");
          });
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  :root {
    --vj-accent: #b46300;
    --vj-accent-hover: #965000;
    --vj-accent-on-dark: #ffb45a;
    --vj-accent-soft: #fff7ee;

    --vj-ink: #17181d;
    --vj-muted: #696b73;
    --vj-surface: #f7f7f7;
    --vj-border: #e3e3e6;

    --font-main:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: white;
    color: var(--vj-ink);
    font-family: var(--font-main);
    font-size: 16px;
    line-height: 1.5;
    text-rendering: geometricPrecision;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  input,
  select,
  textarea {
    font-family: inherit;
  }

  button {
    cursor: pointer;
  }

  img,
  video,
  svg {
    max-width: 100%;
  }

  main#pageContent {
    min-height: 60vh;
  }

  :focus-visible {
    outline: 3px solid var(--vj-accent);
    outline-offset: 3px;
  }

  ::selection {
    color: white;
    background: var(--vj-accent);
  }

  /* GEMEINSAME FARBE FÜR ALLE NEUEN SEITEN */
  .home-page,
  .portfolio-page,
  .prices-page,
  .kontakt-page,
  .extras-page,
  .about-page,
  .reviews-page {
    --accent: var(--vj-accent);
  }

  /*
   * Die einzelnen Seiten steuern ihre eigene Schriftgröße.
   * Es gibt bewusst keine globalen !important-Regeln
   * für h1, h2, p, Labels oder Karten.
   */

  /* COOKIE-BANNER NICHT MIT SCROLL-ANIMATION VERSEHEN */
  .vj-cookie-banner {
    opacity: 1 !important;
    transform: none !important;
  }

  /* SCROLL-ANIMATION */
  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity .8s cubic-bezier(.22, 1, .36, 1),
      transform .8s cubic-bezier(.22, 1, .36, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }

  .reveal-on-scroll.is-visible {
    opacity: 1;
    transform: none;
  }

  /* BEWEGUNGSREDUKTION */
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    .reveal-on-scroll {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
