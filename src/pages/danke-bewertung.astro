
---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Vielen Dank für eure Bewertung | VJ Production"
  description="Vielen Dank für eure Bewertung. Sie wurde erfolgreich übermittelt und wird nach Prüfung veröffentlicht."
>
  <section
    class="vj-review-thanks-page"
    id="vjReviewThanksPage"
    aria-labelledby="review-thanks-title"
  >
    <div class="vj-review-thanks-content">

      <!-- BESTÄTIGUNGSSYMBOL -->
      <div class="vj-review-success-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path
            d="M5 12.5l4.5 4.5L19 7"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </div>

      <!-- KLEINE ÜBERSCHRIFT -->
      <p class="vj-review-thanks-eyebrow">
        Bewertung erfolgreich gesendet
      </p>

      <!-- HAUPTTITEL -->
      <h1 id="review-thanks-title">
        Vielen Dank!
      </h1>

      <!-- BESTÄTIGUNGSTEXT -->
      <p class="vj-review-thanks-description">
        Vielen Dank, dass ihr euch die Zeit genommen habt,
        eure Erfahrungen mit VJ Production zu teilen.
      </p>

      <p class="vj-review-thanks-response">
        Eure Bewertung wurde erfolgreich übermittelt.
        Ich prüfe sie und veröffentliche sie anschließend
        auf der Website.
      </p>

      <!-- TRENNLINIE -->
      <div
        class="vj-review-thanks-divider"
        aria-hidden="true"
      ></div>

      <!-- PERSÖNLICHE NACHRICHT -->
      <p class="vj-review-thanks-message">
        Eure Rückmeldungen bedeuten mir viel und helfen
        zukünftigen Hochzeitspaaren dabei,
        den passenden Videografen zu finden.
      </p>

      <!-- ZURÜCK-BUTTON -->
      <a
        href="/bewertungen"
        class="vj-review-thanks-button"
      >
        Zurück zu den Bewertungen
        <span aria-hidden="true">→</span>
      </a>

    </div>
  </section>
</BaseLayout>

<style is:global>
  /* ================================== */
  /* VJ PRODUCTION – DANKE BEWERTUNG */
  /* ================================== */

  #vjReviewThanksPage {
    --review-accent: #b46300;
    --review-accent-hover: #965000;
    --review-ink: #17181d;
    --review-muted: #696b73;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;
    min-height: 85svh;

    margin: 0;
    padding: 155px 24px 110px;

    background: #ffffff;
    color: var(--review-ink);
    text-align: center;
  }

  #vjReviewThanksPage *,
  #vjReviewThanksPage *::before,
  #vjReviewThanksPage *::after {
    box-sizing: border-box;
  }

  /* INHALT */
  #vjReviewThanksPage .vj-review-thanks-content {
    display: flex;
    flex-direction: column;
    align-items: center;

    width: min(730px, 100%);
    margin: 0 auto;
  }

  /* BESTÄTIGUNGSSYMBOL */
  #vjReviewThanksPage .vj-review-success-icon {
    display: grid;
    place-items: center;

    width: 96px;
    height: 96px;

    margin: 0 0 37px;

    border: 1px solid #ead5bb;
    border-radius: 50%;

    background: #fff7ee;
    color: var(--review-accent);
  }

  #vjReviewThanksPage .vj-review-success-icon svg {
    display: block;

    width: 47px;
    height: 47px;
  }

  /* KLEINE ÜBERSCHRIFT */
  #vjReviewThanksPage .vj-review-thanks-eyebrow {
    margin: 0 0 18px;

    color: var(--review-accent);

    font-size: 11px;
    font-weight: 800;
    line-height: 1.5;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  /* HAUPTTITEL */
  #vjReviewThanksPage h1 {
    margin: 0;

    color: var(--review-ink);

    font-size: clamp(44px, 6vw, 74px);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: -0.065em;
  }

  /* HAUPTBESCHREIBUNG */
  #vjReviewThanksPage .vj-review-thanks-description {
    max-width: 610px;

    margin: 27px auto 0;

    color: #484b53;

    font-size: clamp(17px, 1.8vw, 21px);
    font-weight: 400;
    line-height: 1.7;
  }

  /* HINWEIS ZUR VERÖFFENTLICHUNG */
  #vjReviewThanksPage .vj-review-thanks-response {
    max-width: 590px;

    margin: 18px auto 0;

    color: var(--review-muted);

    font-size: 16px;
    font-weight: 400;
    line-height: 1.7;
  }

  /* TRENNLINIE */
  #vjReviewThanksPage .vj-review-thanks-divider {
    width: 65px;
    height: 1px;

    margin: 37px auto;

    background: #d8d9de;
  }

  /* ABSCHLUSSNACHRICHT */
  #vjReviewThanksPage .vj-review-thanks-message {
    max-width: 490px;

    margin: 0;

    color: var(--review-muted);

    font-size: 15px;
    line-height: 1.75;
  }

  /* BUTTON */
  #vjReviewThanksPage .vj-review-thanks-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 17px;

    min-height: 53px;

    margin-top: 39px;
    padding: 14px 27px;

    border: 0;
    border-radius: 7px;

    background: var(--review-accent);
    color: #ffffff;

    font-size: 14px;
    font-weight: 800;
    line-height: 1.3;
    text-decoration: none;

    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  #vjReviewThanksPage .vj-review-thanks-button:hover {
    background: var(--review-accent-hover);
    transform: translateY(-2px);
  }

  #vjReviewThanksPage .vj-review-thanks-button:focus-visible {
    outline: 3px solid var(--review-accent);
    outline-offset: 4px;
  }

  /* TABLET */
  @media (max-width: 850px) {
    #vjReviewThanksPage {
      min-height: 80svh;
      padding: 140px 24px 90px;
    }
  }

  /* HANDY */
  @media (max-width: 620px) {
    #vjReviewThanksPage {
      min-height: 75svh;
      padding: 135px 22px 85px;
    }

    #vjReviewThanksPage .vj-review-success-icon {
      width: 82px;
      height: 82px;
      margin-bottom: 31px;
    }

    #vjReviewThanksPage .vj-review-success-icon svg {
      width: 40px;
      height: 40px;
    }

    #vjReviewThanksPage h1 {
      font-size: clamp(42px, 11vw, 55px);
    }

    #vjReviewThanksPage .vj-review-thanks-description {
      margin-top: 24px;
      font-size: 17px;
    }

    #vjReviewThanksPage .vj-review-thanks-response {
      font-size: 15px;
    }

    #vjReviewThanksPage .vj-review-thanks-divider {
      margin: 30px auto;
    }

    #vjReviewThanksPage .vj-review-thanks-message {
      font-size: 14px;
    }

    #vjReviewThanksPage .vj-review-thanks-button {
      width: 100%;
      margin-top: 34px;
    }
  }

  /* REDUZIERTE BEWEGUNG */
  @media (prefers-reduced-motion: reduce) {
    #vjReviewThanksPage .vj-review-thanks-button {
      transition: none;
    }
  }
</style>
