---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Vielen Dank für eure Bewertung | VJ Production"
  description="Vielen Dank für eure Bewertung. Sie wurde erfolgreich übermittelt und wird nach Prüfung veröffentlicht."
>
  <section class="thanks-page">
    <div class="success-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24">
        <path d="M20 6 9 17l-5-5"></path>
        <path d="M21 12a9 9 0 1 1-3.2-6.9"></path>
      </svg>
    </div>

    <p class="kicker">Bewertung gesendet</p>

    <h1>Vielen Dank!</h1>

    <p class="thanks-text">
      Eure Bewertung wurde erfolgreich übermittelt. Ich prüfe sie kurz und veröffentliche sie anschließend auf der Website.
    </p>

    <a href="/bewertungen" class="home-button">Zurück zu den Bewertungen</a>
  </section>
</BaseLayout>

<style>
  :global(body) {
    background: white;
  }

  .thanks-page {
    min-height: 100vh;
    padding: 180px 20px 120px;
    display: grid;
    justify-items: center;
    align-content: center;
    text-align: center;
    background: white;
    color: #17181d;
  }

  .success-icon {
    width: 140px;
    height: 140px;
    margin-bottom: 44px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    background: #d9fbe2;
  }

  .success-icon svg {
    width: 78px;
    height: 78px;
  }

  .success-icon path {
    fill: none;
    stroke: #18a64a;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .kicker {
    margin: 0 0 24px;
    color: #df7b00;
    text-transform: uppercase;
    letter-spacing: 0.34em;
    font-size: 13px;
    font-weight: 700;
  }

  h1 {
    margin: 0;
    color: #17181d;
    font-size: clamp(54px, 7vw, 86px);
    font-weight: 300;
    letter-spacing: -0.07em;
    line-height: 1;
  }

  .thanks-text {
    max-width: 820px;
    margin: 38px auto 0;
    color: #777984;
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.45;
  }

  .home-button {
    margin-top: 72px;
    min-width: 320px;
    height: 62px;
    padding: 0 34px;
    border-radius: 9px;
    border: 1px solid #dedfe3;
    background: white;
    color: #17181d;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    font-weight: 700;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
  }

  .home-button:hover {
    border-color: #df7b00;
    color: #df7b00;
  }

  @media (max-width: 620px) {
    .thanks-page {
      padding: 150px 18px 90px;
    }

    .success-icon {
      width: 110px;
      height: 110px;
      margin-bottom: 36px;
    }

    .success-icon svg {
      width: 60px;
      height: 60px;
    }

    .thanks-text {
      font-size: 21px;
    }

    .home-button {
      width: 100%;
      min-width: 0;
      font-size: 18px;
    }
  }
</style>