---
import BaseLayout from "../layouts/BaseLayout.astro";

const today = new Date().toISOString().split("T")[0];

const icons = {
  drone: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="5" cy="5" r="2.4"></circle>
    <circle cx="19" cy="5" r="2.4"></circle>
    <circle cx="5" cy="19" r="2.4"></circle>
    <circle cx="19" cy="19" r="2.4"></circle>
    <path d="M7 7l3.1 3.1"></path>
    <path d="M17 7l-3.1 3.1"></path>
    <path d="M7 17l3.1-3.1"></path>
    <path d="M17 17l-3.1-3.1"></path>
    <rect x="9.7" y="9.7" width="4.6" height="4.6" rx="1.1"></rect>
    <path d="M12 9.7V7.8"></path>
    <path d="M12 14.3v1.9"></path>
    <path d="M9.7 12H7.8"></path>
    <path d="M14.3 12h1.9"></path>
  </svg>`,

  secondVideographer: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <rect x="3" y="7" width="11" height="9" rx="2"></rect>
    <path d="m14 10 5-3v9l-5-3"></path>
    <circle cx="7" cy="11.5" r="1.7"></circle>
    <path d="M18.5 4.5v4"></path>
    <path d="M16.5 6.5h4"></path>
  </svg>`,
};
---

<BaseLayout
  title="Kontakt | Hochzeitsvideograf Witten & NRW | VJ Production"
  description="Kontaktiere VJ Production für deinen Hochzeitsfilm. Anfrage für Hochzeitsvideo, Verlobungsvideo, nachträgliches Hochzeitsvideoshooting oder Zusatzleistungen."
>
  <section class="kontakt-page">
    <section class="kontakt-head">
      <p>Anfrage</p>
      <h1>Kontakt</h1>
      <span>Erzählt mir von eurem Tag</span>
    </section>

    <form
      class="kontakt-form"
      id="kontaktForm"
      action="https://api.web3forms.com/submit"
      method="POST"
    >
      <input
        type="hidden"
        name="access_key"
        value="d7e13ef0-2a0f-4bba-bf3b-386b61afe972"
      />

      <input
        type="hidden"
        name="subject"
        value="Neue Anfrage über vjproduction.de"
      />

      <input
        type="hidden"
        name="from_name"
        value="VJ Production Website"
      />

      <input
        type="hidden"
        name="redirect"
        value="https://vjproduction.de/danke"
      />

      <fieldset class="choice-section">
        <legend>Was ist der Anlass? <span>*</span></legend>

        <label class="option-card">
          <input
            type="radio"
            name="Anlass"
            value="Hochzeit"
            required
          />

          <span class="line-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="8" cy="7" r="3"></circle>
              <circle cx="16" cy="7" r="3"></circle>
              <path d="M4.5 20v-2.2A5.5 5.5 0 0 1 10 12.3"></path>
              <path d="M19.5 20v-2.2A5.5 5.5 0 0 0 14 12.3"></path>
              <path d="M8.8 14.5c1.7 1.6 4.7 1.6 6.4 0"></path>
              <path d="M10.2 13.2 12 15l1.8-1.8"></path>
            </svg>
          </span>

          <span class="option-text">Hochzeit</span>
        </label>

        <label class="option-card">
          <input
            type="radio"
            name="Anlass"
            value="Verlobung"
          />

          <span class="line-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M9 8h6l2 3-5 8-5-8 2-3Z"></path>
              <path d="M9 8 12 4l3 4"></path>
              <path d="M7 11h10"></path>
              <circle cx="12" cy="15.5" r="4.5"></circle>
            </svg>
          </span>

          <span class="option-text">Verlobung</span>
        </label>

        <label class="option-card">
          <input
            type="radio"
            name="Anlass"
            value="Nachträgliches Hochzeitsvideoshooting"
          />

          <span class="line-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 4h16v16H4z"></path>
              <path d="M8 4v16"></path>
              <path d="M16 4v16"></path>
              <path d="M4 8h4"></path>
              <path d="M4 12h4"></path>
              <path d="M4 16h4"></path>
              <path d="M16 8h4"></path>
              <path d="M16 12h4"></path>
              <path d="M16 16h4"></path>
            </svg>
          </span>

          <span class="option-text">
            Nachträgliches Hochzeitsvideoshooting
          </span>
        </label>
      </fieldset>

      <div class="form-grid">
        <label>
          <span>Datum</span>

          <input
            class="date-input"
            type="date"
            name="Datum"
            value={today}
          />
        </label>

        <label>
          <span>Location / Ort</span>

          <input
            type="text"
            name="Location"
            placeholder="z. B. Witten, Dortmund, Essen..."
          />
        </label>
      </div>

      <label>
        <span>Paket *</span>

        <select name="Paket" required>
          <option value="" disabled selected>
            Paket auswählen...
          </option>

          <option value="Basic">Basic</option>
          <option value="Classic">Classic</option>
          <option value="Premium">Premium</option>
          <option value="Individuell">Individuell</option>
        </select>
      </label>

      <label>
        <span>Investitionsrahmen *</span>

        <select name="Investitionsrahmen" required>
          <option value="" disabled selected>
            Investitionsrahmen auswählen...
          </option>

          <option value="Ab 1.290 Euro">
            ab 1.290 € – Basic
          </option>

          <option value="Ab 1.990 Euro">
            ab 1.990 € – Classic
          </option>

          <option value="Ab 2.390 Euro">
            ab 2.390 € – Premium
          </option>

          <option value="3.000 Euro oder mehr">
            3.000 €+
          </option>
        </select>
      </label>

      <fieldset class="choice-section">
        <legend>Zusatzleistungen optional</legend>

        <label class="check-card second-videographer-card">
          <input
            type="checkbox"
            name="Zweiter Videograf"
            value="Interesse"
          />

          <span
            class="line-icon second-videographer-icon"
            set:html={icons.secondVideographer}
          ></span>

          <span class="option-copy">
            <strong>Zweiter Videograf · ab 350 €</strong>
            <small>
              Für zusätzliche Perspektiven und parallel eingefangene Momente.
            </small>
          </span>
        </label>

        <label class="check-card">
          <input
            type="checkbox"
            name="Zusatzleistungen"
            value="Drohnenaufnahmen"
          />

          <span
            class="line-icon drone-icon"
            set:html={icons.drone}
          ></span>

          <span class="option-text">Drohnenaufnahmen</span>
        </label>

        <label class="check-card">
          <input
            type="checkbox"
            name="Zusatzleistungen"
            value="Express-Lieferung"
          />

          <span class="line-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M13 2 4 14h7l-1 8 10-13h-7l0-7Z"></path>
            </svg>
          </span>

          <span class="option-text">Express-Lieferung</span>
        </label>

        <label class="check-card">
          <input
            type="checkbox"
            name="Zusatzleistungen"
            value="Social Media Reel"
          />

          <span class="line-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M7 3h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z"></path>
              <path d="M10 9.5v5l5-2.5-5-2.5Z"></path>
            </svg>
          </span>

          <span class="option-text">Social Media Reel</span>
        </label>
      </fieldset>

      <div class="separator"></div>

      <label>
        <span>Ihr Name *</span>

        <input
          type="text"
          name="Name"
          placeholder="Anna & Max Mustermann"
          autocomplete="name"
          required
        />
      </label>

      <div class="form-grid">
        <label>
          <span>E-Mail</span>

          <input
            type="email"
            name="email"
            placeholder="ihre@email.de"
            autocomplete="email"
          />
        </label>

        <label>
          <span>Telefon *</span>

          <input
            type="tel"
            name="Telefon"
            placeholder="+49 123 456789"
            autocomplete="tel"
            required
          />
        </label>
      </div>

      <fieldset class="contact-way">
        <legend>Bevorzugter Kontaktweg</legend>

        <label>
          <input
            type="radio"
            name="Bevorzugter Kontaktweg"
            value="E-Mail"
          />
          E-Mail
        </label>

        <label>
          <input
            type="radio"
            name="Bevorzugter Kontaktweg"
            value="Telefon"
            checked
          />
          Telefon
        </label>

        <label>
          <input
            type="radio"
            name="Bevorzugter Kontaktweg"
            value="WhatsApp"
          />
          WhatsApp
        </label>
      </fieldset>

      <label>
        <span>Nachricht</span>

        <textarea
          name="Nachricht"
          rows="7"
          placeholder="Erzählt mir kurz von euch, eurem Anlass und was euch wichtig ist..."
        ></textarea>
      </label>

      <div class="separator"></div>

      <label class="consent">
        <input
          type="checkbox"
          name="Datenschutz akzeptiert"
          value="Ja"
          required
        />

        <span>
          Ich habe die
          <a href="/datenschutz">Datenschutzerklärung</a>
          gelesen und akzeptiere sie. *
        </span>
      </label>

      <label class="consent">
        <input
          type="checkbox"
          name="Kontakt erlaubt"
          value="Ja"
          required
        />

        <span>
          Ich willige ein, dass du mich zur Anfrage kontaktieren darfst. *
        </span>
      </label>

      <button class="submit-button" type="submit">
        Anfrage absenden
        <span>→</span>
      </button>
    </form>
  </section>

  <script is:inline>
    const contactForm = document.getElementById("kontaktForm");

    if (contactForm instanceof HTMLFormElement) {
      const submitButton = contactForm.querySelector(
        'button[type="submit"]'
      );

      sessionStorage.removeItem("vjContactFormSubmittedAt");

      contactForm.addEventListener("submit", async (event) => {
        event.preventDefault();

        const originalButtonContent =
          submitButton instanceof HTMLButtonElement
            ? submitButton.innerHTML
            : "";

        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = true;
          submitButton.textContent = "Anfrage wird gesendet …";
        }

        try {
          const formData = new FormData(contactForm);

          formData.delete("redirect");

          const response = await fetch(
            "https://api.web3forms.com/submit",
            {
              method: "POST",
              body: formData,
              headers: {
                Accept: "application/json",
              },
            }
          );

          const result = await response.json();

          if (!response.ok || result.success !== true) {
            throw new Error(
              result.message ||
                "Die Anfrage konnte nicht gesendet werden."
            );
          }

          sessionStorage.setItem(
            "vjContactFormSubmittedAt",
            String(Date.now())
          );

          window.location.assign("/danke");
        } catch (error) {
          console.error(
            "Fehler beim Senden des Kontaktformulars:",
            error
          );

          alert(
            "Leider konnte die Anfrage gerade nicht gesendet werden. Bitte versucht es erneut oder kontaktiert mich telefonisch."
          );

          if (submitButton instanceof HTMLButtonElement) {
            submitButton.disabled = false;
            submitButton.innerHTML = originalButtonContent;
          }
        }
      });
    }
  </script>
</BaseLayout>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    background: white;
  }

  .kontakt-page {
    background: white;
    color: #17181d;
    padding: 135px 20px 108px;
  }

  .kontakt-head {
    width: min(900px, 100%);
    margin: 0 auto 60px;
    text-align: center;
  }

  .kontakt-head p {
    margin: 0 0 18px;
    color: #df7b00;
    text-transform: uppercase;
    letter-spacing: 0.34em;
    font-size: 12px;
    font-weight: 700;
  }

  .kontakt-head h1 {
    margin: 0;
    font-size: clamp(40px, 5.4vw, 72px);
    font-weight: 300;
    letter-spacing: -0.07em;
    line-height: 1.05;
  }

  .kontakt-head span {
    display: block;
    margin-top: 22px;
    color: #777984;
    font-size: 17px;
    line-height: 1.6;
  }

  .kontakt-form {
    width: min(900px, 100%);
    margin: 0 auto;
    display: grid;
    gap: 26px;
  }

  .kontakt-form > label,
  .form-grid > label {
    display: block;
    width: 100%;
    min-width: 0;
  }

  fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .choice-section {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  legend {
    display: block;
    width: 100%;
    max-width: none;
    min-width: 0;
    margin: 0 0 12px;
    padding: 0;
    color: #17181d;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.35;
    white-space: normal;
  }

  legend span {
    color: inherit;
  }

  label > span:not(.line-icon):not(.option-text):not(.option-copy) {
    display: block;
    margin-bottom: 12px;
    color: #17181d;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.35;
  }

  .option-card,
  .check-card {
    min-height: 76px;
    padding: 16px 22px;
    border-radius: 14px;
    border: 2px solid #e1e2e6;
    background: white;
    display: flex;
    align-items: center;
    gap: 20px;
    color: #17181d;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.25;
    cursor: pointer;
  }

  .option-text {
    display: block;
    min-width: 0;
  }

  .option-copy {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    margin: 0;
  }

  .option-copy strong {
    color: #17181d;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.3;
  }

  .option-copy small {
    color: #777984;
    font-size: 14px;
    font-weight: 500;
    line-height: 1.45;
  }

  .option-card input,
  .check-card input,
  .consent input {
    width: 20px;
    height: 20px;
    accent-color: #df7b00;
    flex: 0 0 auto;
  }

  .line-icon {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    display: grid;
    place-items: center;
    color: #df7b00;
  }

  .line-icon svg {
    width: 28px;
    height: 28px;
    display: block;
  }

  .line-icon svg path,
  .line-icon svg circle,
  .line-icon svg rect {
    fill: none;
    stroke: #df7b00;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .drone-icon,
  .second-videographer-icon {
    background: transparent;
    border-radius: 0;
  }

  :global(.drone-icon svg),
  :global(.second-videographer-icon svg) {
    width: 28px !important;
    height: 28px !important;
    display: block !important;
    overflow: visible !important;
  }

  :global(.drone-icon svg path),
  :global(.drone-icon svg rect),
  :global(.drone-icon svg circle),
  :global(.second-videographer-icon svg path),
  :global(.second-videographer-icon svg rect),
  :global(.second-videographer-icon svg circle) {
    fill: none !important;
    stroke: #df7b00 !important;
    stroke-width: 1.8 !important;
    stroke-linecap: round !important;
    stroke-linejoin: round !important;
  }

  .form-grid {
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 20px;
  }

  input,
  select,
  textarea {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    border: 1px solid #dedfe3;
    border-radius: 8px;
    background: white;
    color: #17181d;
    font: inherit;
    font-size: 16px;
    outline: none;
  }

  input,
  select {
    height: 50px;
    min-height: 50px;
    padding: 0 18px;
  }

  textarea {
    padding: 18px;
    resize: vertical;
  }

  input[type="date"] {
    display: block;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    height: 50px;
    min-height: 50px;
    padding: 0 18px;
    border: 1px solid #dedfe3;
    border-radius: 8px;
    background: white;
    color: #17181d;
    font-size: 16px;
    line-height: normal;
    appearance: none;
    -webkit-appearance: none;
  }

  input[type="date"]::-webkit-date-and-time-value {
    width: 100%;
    min-height: 50px;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    text-align: left;
  }

  input[type="date"]::-webkit-datetime-edit {
    width: 100%;
    padding: 0;
    text-align: left;
  }

  input[type="date"]::-webkit-calendar-picker-indicator {
    margin-left: auto;
    cursor: pointer;
  }

  input:focus,
  select:focus,
  textarea:focus,
  .option-card:has(input:checked),
  .check-card:has(input:checked) {
    border-color: #df7b00;
    box-shadow: 0 0 0 4px rgba(223, 123, 0, 0.08);
  }

  .contact-way {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 22px;
  }

  .contact-way legend {
    flex: 0 0 100%;
    width: 100%;
    margin-bottom: 0;
  }

  .contact-way label {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 18px;
    line-height: 1.35;
    cursor: pointer;
  }

  .contact-way input {
    width: 20px;
    height: 20px;
    accent-color: #17181d;
  }

  .separator {
    margin: 14px 0 0;
    height: 1px;
    background: #dedfe3;
  }

  .consent {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    font-size: 16px;
    line-height: 1.55;
  }

  .consent span {
    margin: 0;
    font-size: 16px;
    font-weight: 500;
  }

  .consent a {
    color: #df7b00;
    text-decoration: underline;
  }

  .submit-button {
    justify-self: end;
    margin-top: 20px;
    height: 52px;
    padding: 0 34px;
    border: 0;
    border-radius: 7px;
    background: #df7b00;
    color: white;
    display: inline-flex;
    align-items: center;
    gap: 18px;
    font: inherit;
    font-size: 16px;
    font-weight: 800;
    cursor: pointer;
  }

  .submit-button:disabled {
    cursor: wait;
    opacity: 0.7;
  }

  @media (max-width: 700px) {
    .kontakt-page {
      padding: 120px 14px 80px;
    }

    .kontakt-head {
      margin-bottom: 46px;
    }

    .form-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 26px;
    }

    .form-grid > label,
    .kontakt-form > label {
      width: 100%;
      min-width: 0;
      max-width: 100%;
    }

    input,
    select,
    textarea,
    input[type="date"] {
      width: 100%;
      min-width: 0;
      max-width: 100%;
      border-radius: 8px;
      font-size: 16px;
    }

    input,
    select,
    input[type="date"] {
      height: 50px;
      min-height: 50px;
    }

    input[type="date"] {
      display: block;
      padding: 0 18px;
      overflow: hidden;
    }

    input[type="date"]::-webkit-date-and-time-value {
      width: 100%;
      min-height: 50px;
      display: flex;
      align-items: center;
      text-align: left;
    }

    .option-card,
    .check-card {
      min-height: 72px;
      padding: 16px;
      gap: 16px;
      font-size: 16px;
    }

    .line-icon {
      width: 32px;
      height: 32px;
      flex-basis: 32px;
    }

    .line-icon svg,
    .drone-icon svg,
    .second-videographer-icon svg {
      width: 26px;
      height: 26px;
    }

    .option-copy strong {
      font-size: 16px;
    }

    .option-copy small {
      font-size: 13px;
      line-height: 1.4;
    }

    .contact-way {
      gap: 16px 22px;
    }

    .contact-way label {
      font-size: 16px;
    }

    .submit-button {
      width: 100%;
      justify-content: center;
    }
  }
</style>