
---
import BaseLayout from "../layouts/BaseLayout.astro";

const additionalServices = [
  {
    name: "Zweiter Videograf",
    value: "Interesse",
    label: "Zweiter Videograf",
  },
  {
    name: "Zusatzleistungen",
    value: "Drohnenaufnahmen",
    label: "Drohnenaufnahmen",
  },
  {
    name: "Zusatzleistungen",
    value: "Express-Lieferung",
    label: "Express-Lieferung",
  },
  {
    name: "Zusatzleistungen",
    value: "Social Media Reel",
    label: "Social Media Reel",
  },
];

const sources = [
  { value: "Google-Suche", label: "Google-Suche (organisch)" },
  { value: "Google-Werbung (Google Ads)", label: "Google-Werbung (Google Ads)" },
  { value: "Instagram", label: "Instagram" },
  { value: "Facebook", label: "Facebook" },
  { value: "Bark.com", label: "Bark.com" },
  {
    value: "Empfehlung von Freunden/Bekannten",
    label: "Empfehlung von Freunden/Bekannten",
  },
  {
    value: "Empfehlung durch Fotografen oder Dienstleister",
    label: "Empfehlung durch Fotografen oder Dienstleister",
  },
  { value: "TikTok", label: "TikTok" },
  { value: "Sonstiges", label: "Sonstiges" },
];
---

<BaseLayout
  title="Hochzeit anfragen | Hochzeitsvideograf NRW | VJ Production"
  description="Fragt VJ Production unverbindlich für eure Hochzeit an. Hochzeitsvideograf aus Witten für emotionale Hochzeitsfilme in NRW und deutschlandweit."
>
  <section class="kontakt-page">
    <header class="kontakt-head">
      <p class="eyebrow">VJ Production · Hochzeit anfragen</p>
      <h1>Erzählt mir von eurem Tag.</h1>
      <p class="head-description">
        Ich freue mich auf eure Pläne. Füllt das Formular aus und
        ich melde mich persönlich bei euch. Eure Anfrage ist unverbindlich.
      </p>
    </header>

    <form
      class="kontakt-form"
      id="kontaktForm"
      action="https://api.web3forms.com/submit"
      method="POST"
    >
      <input type="hidden" name="access_key" value="d7e13ef0-2a0f-4bba-bf3b-386b61afe972" />
      <input type="hidden" name="subject" value="Neue Hochzeitsanfrage über vjproduction.de" />
      <input type="hidden" name="from_name" value="VJ Production Website" />
      <input type="hidden" name="redirect" value="https://vjproduction.de/danke" />
      <input type="hidden" name="Anlass" value="Hochzeit" />

      <input
        type="checkbox"
        name="botcheck"
        tabindex="-1"
        autocomplete="off"
        class="honeypot"
      />

      <!-- 01 / EURE HOCHZEIT -->
      <section class="form-section" aria-labelledby="event-heading">
        <div class="section-heading">
          <span class="section-number" aria-hidden="true">01</span>
          <div>
            <h2 id="event-heading">Eure Hochzeit</h2>
            <p>Wann und wo feiert ihr?</p>
          </div>
        </div>

        <div class="form-grid">
          <label class="field">
            <span>Hochzeitsdatum</span>
            <input type="date" name="Datum" aria-describedby="date-note" />
            <small id="date-note">
              Falls noch nicht bekannt, einfach freilassen.
            </small>
          </label>

          <label class="field">
            <span>Location / Ort</span>
            <input
              type="text"
              name="Location"
              placeholder="z. B. Witten, Dortmund, Essen …"
            />
          </label>
        </div>

        <div class="form-grid">
          <label class="field">
            <span>Paket <span class="required">*</span></span>
            <select name="Paket" required>
              <option value="" disabled selected>Paket auswählen …</option>
              <option value="Basic">Basic</option>
              <option value="Classic">Classic</option>
              <option value="Premium">Premium</option>
              <option value="Individuell">Individuell</option>
            </select>
          </label>

          <label class="field">
            <span>Investitionsrahmen <span class="required">*</span></span>
            <select name="Investitionsrahmen" required>
              <option value="" disabled selected>
                Investitionsrahmen auswählen …
              </option>
              <option value="Ab 1.290 Euro">ab 1.290 € – Basic</option>
              <option value="Ab 1.990 Euro">ab 1.990 € – Classic</option>
              <option value="Ab 2.390 Euro">ab 2.390 € – Premium</option>
              <option value="3.000 Euro oder mehr">3.000 €+</option>
            </select>
          </label>
        </div>

        <p class="form-note">
          Die Paket- und Budgetauswahl hilft mir,
          eure Anfrage passend einzuschätzen.
        </p>

        <fieldset>
          <legend>
            Zusatzleistungen <span class="optional">(optional)</span>
          </legend>

          <div class="choice-grid extras-grid">
            {additionalServices.map((service) => (
              <label class="choice-card">
                <input
                  type="checkbox"
                  name={service.name}
                  value={service.value}
                />
                <span>{service.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
      </section>

      <!-- 02 / KONTAKT -->
      <section class="form-section" aria-labelledby="contact-heading">
        <div class="section-heading">
          <span class="section-number" aria-hidden="true">02</span>
          <div>
            <h2 id="contact-heading">So erreiche ich euch</h2>
            <p>Damit ich persönlich auf eure Anfrage antworten kann.</p>
          </div>
        </div>

        <label class="field">
          <span>Euer Name <span class="required">*</span></span>
          <input
            type="text"
            name="Name"
            placeholder="Anna & Max Mustermann"
            autocomplete="name"
            required
          />
        </label>

        <div class="form-grid">
          <label class="field">
            <span>E-Mail</span>
            <input
              id="kontaktEmail"
              type="email"
              name="email"
              placeholder="eure@email.de"
              autocomplete="email"
              aria-describedby="email-note"
            />
            <small id="email-note">
              Pflichtfeld, wenn ihr E-Mail als Kontaktweg auswählt.
            </small>
          </label>

          <label class="field">
            <span>Telefon <span class="required">*</span></span>
            <input
              type="tel"
              name="Telefon"
              placeholder="+49 123 456789"
              autocomplete="tel"
              required
            />
          </label