---
import BaseLayout from "../layouts/BaseLayout.astro";

const featuredVideo = {
  couple: "Phelina & Mert",
  type: "Highlightfilm · 8 Minuten",
  text: "Eine emotionale und cineastische Zusammenfassung ihres Hochzeitstages mit echten Momenten, persönlichen Worten und der besonderen Atmosphäre des gesamten Tages.",
  src: "https://galleries.vidflow.co/videos/h7wkezfr",
};

const videos = [
  {
    couple: "Melisa & Adis",
    type: "Wedding Teaser",
    text: "Ein lebendiger Einblick in ihren Hochzeitstag mit echten Emotionen, besonderen Augenblicken und ausgelassener Stimmung.",
    src: "https://galleries.vidflow.co/videos/ci2k0ber",
  },
  {
    couple: "Jana & Stefan",
    type: "Wedding Film",
    text: "Eine ausführliche Erinnerung an ihren Hochzeitstag mit Atmosphäre, Reden und all den kleinen Momenten dazwischen.",
    src: "https://galleries.vidflow.co/videos/kx680fsh",
  },
  {
    couple: "Aleyna & Güven",
    type: "Verlobungsfilm",
    text: "Ein emotionaler Film über ihren besonderen Moment, natürlich, persönlich und cineastisch festgehalten.",
    src: "https://galleries.vidflow.co/videos/r29jufq6",
  },
  {
    couple: "Melisa & Adis",
    type: "Paarshooting",
    text: "Ruhige und natürliche Paaraufnahmen mit viel Nähe, Bewegung und Atmosphäre.",
    src: "https://galleries.vidflow.co/videos/b2ayyew1",
  },
];
---

<BaseLayout
  title="Portfolio | Hochzeitsvideograf Witten & NRW | VJ Production"
  description="Ausgewählte Hochzeitsfilme, Wedding Teaser, Verlobungsfilme und Paarshootings von VJ Production. Hochzeitsvideograf aus Witten für NRW und deutschlandweit."
>
  <main class="portfolio-page">
    <section class="portfolio-head">
      <p>Portfolio</p>

      <h1>Ausgewählte Hochzeitsfilme</h1>

      <span>
        Echte Momente. Ruhig begleitet. Cineastisch erzählt.
      </span>
    </section>

    <section class="featured-section">
      <article class="featured-project">
        <div class="featured-frame">
          <iframe
            src={featuredVideo.src}
            title={`${featuredVideo.type} | ${featuredVideo.couple}`}
            frameborder="0"
            allowfullscreen
            webkitallowfullscreen
            mozallowfullscreen
            allow="autoplay; fullscreen; picture-in-picture"
          ></iframe>
        </div>

        <div class="featured-text">
          <span class="video-type">{featuredVideo.type}</span>

          <h2>{featuredVideo.couple}</h2>

          <p>{featuredVideo.text}</p>
        </div>
      </article>
    </section>

    <section class="more-work">
      <div class="more-work-head">
        <p>Weitere Arbeiten</p>

        <h2>Mehr echte Geschichten</h2>
      </div>

      <div class="video-grid">
        {videos.map((video) => (
          <article class="video-item">
            <div class="video-frame">
              <iframe
                src={video.src}
                title={`${video.type} | ${video.couple}`}
                frameborder="0"
                allowfullscreen
                webkitallowfullscreen
                mozallowfullscreen
                allow="autoplay; fullscreen; picture-in-picture"
                loading="lazy"
              ></iframe>
            </div>

            <div class="video-text">
              <span class="video-type">{video.type}</span>

              <h3>{video.couple}</h3>

              <p>{video.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="personal-films">
      <p>
        Weitere ausgewählte Arbeiten zeige ich euch gerne im persönlichen Gespräch.
      </p>

      <a href="/kontakt">
        Persönlich kennenlernen
        <span>→</span>
      </a>
    </section>

    <section class="cta">
      <div class="cta-inner">
        <h2>Bereit für euren Film?</h2>

        <p>
          Lasst uns in einem unverbindlichen Gespräch herausfinden, wie ich euren Tag
          am besten festhalte.
        </p>

        <a href="/kontakt">
          Verfügbarkeit anfragen
          <span>→</span>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  :global(body) {
    background: white;
  }

  .portfolio-page {
    padding: 150px 20px 120px;
    background: white;
    color: #17181d;
  }

  .portfolio-head {
    width: min(1180px, 100%);
    margin: 0 auto 82px;
    text-align: center;
  }

  .portfolio-head p {
    margin: 0 0 26px;
    color: #df7b00;
    text-transform: uppercase;
    letter-spacing: 0.34em;
    font-size: 12px;
    font-weight: 800;
  }

  .portfolio-head h1 {
    margin: 0;
    color: #17181d;
    font-size: clamp(44px, 6vw, 72px);
    font-weight: 300;
    letter-spacing: -0.075em;
    line-height: 0.98;
  }

  .portfolio-head span {
    display: block;
    margin-top: 34px;
    color: #777984;
    font-size: 16px;
    line-height: 1.5;
  }

  .featured-section {
    width: min(1180px, 100%);
    margin: 0 auto 118px;
  }

  .featured-project {
    min-width: 0;
  }

  .featured-frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 30px;
    background: #111216;
    aspect-ratio: 16 / 9;
    box-shadow: 0 34px 90px rgba(23, 24, 29, 0.18);
  }

  .featured-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .featured-text {
    width: min(850px, 100%);
    padding-top: 38px;
  }

  .video-type {
    display: block;
    margin-bottom: 12px;
    color: #df7b00;
    text-transform: uppercase;
    letter-spacing: 0.19em;
    font-size: 11px;
    font-weight: 800;
    line-height: 1.4;
  }

  .featured-text h2 {
    margin: 0;
    color: #17181d;
    font-size: clamp(38px, 4.2vw, 56px);
    font-weight: 300;
    letter-spacing: -0.06em;
    line-height: 1.04;
  }

  .featured-text p {
    max-width: 780px;
    margin: 22px 0 0;
    color: #5f626d;
    font-size: 17px;
    line-height: 1.72;
  }

  .more-work {
    width: min(1180px, 100%);
    margin: 0 auto 104px;
    padding-top: 92px;
    border-top: 1px solid #e4e4e7;
  }

  .more-work-head {
    margin-bottom: 54px;
    text-align: center;
  }

  .more-work-head p {
    margin: 0 0 18px;
    color: #df7b00;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    font-size: 11px;
    font-weight: 800;
  }

  .more-work-head h2 {
    margin: 0;
    color: #17181d;
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 300;
    letter-spacing: -0.06em;
    line-height: 1.05;
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 72px 42px;
  }

  .video-item {
    min-width: 0;
  }

  .video-frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 24px;
    background: #111216;
    aspect-ratio: 16 / 9;
    box-shadow: 0 24px 65px rgba(23, 24, 29, 0.12);
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .video-text {
    padding-top: 26px;
  }

  .video-text h3 {
    margin: 0;
    color: #17181d;
    font-size: clamp(27px, 2.8vw, 36px);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1.08;
  }

  .video-text p {
    max-width: 560px;
    margin: 17px 0 0;
    color: #5f626d;
    font-size: 15px;
    line-height: 1.66;
  }

  .personal-films {
    width: min(920px, 100%);
    margin: 0 auto 86px;
    padding: 27px 0;
    border-top: 1px solid #e4e4e7;
    border-bottom: 1px solid #e4e4e7;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .personal-films p {
    margin: 0;
    color: #5f626d;
    font-size: 16px;
    line-height: 1.6;
  }

  .personal-films a {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 13px;
    color: #df7b00;
    font-size: 15px;
    font-weight: 800;
    text-decoration: none;
  }

  .personal-films a span {
    font-size: 18px;
    line-height: 1;
    transition: transform 180ms ease;
  }

  .personal-films a:hover span {
    transform: translateX(4px);
  }

  .cta {
    width: min(1220px, 100%);
    margin: 0 auto;
  }

  .cta-inner {
    padding: 74px 30px;
    border-radius: 28px;
    background: #17181d;
    color: white;
    text-align: center;
  }

  .cta h2 {
    margin: 0;
    font-size: clamp(36px, 4vw, 52px);
    font-weight: 300;
    letter-spacing: -0.045em;
  }

  .cta p {
    max-width: 760px;
    margin: 26px auto 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: 18px;
    line-height: 1.62;
  }

  .cta a {
    margin-top: 40px;
    display: inline-flex;
    height: 56px;
    padding: 0 38px;
    border-radius: 7px;
    background: #df7b00;
    color: white;
    align-items: center;
    justify-content: center;
    gap: 18px;
    font-size: 16px;
    font-weight: 800;
    text-decoration: none;
    transition:
      transform 180ms ease,
      background 180ms ease,
      box-shadow 180ms ease;
  }

  .cta a:hover {
    transform: translateY(-2px);
    background: #ef8500;
    box-shadow: 0 14px 32px rgba(223, 123, 0, 0.24);
  }

  .cta a span {
    font-size: 18px;
    line-height: 1;
    transition: transform 180ms ease;
  }

  .cta a:hover span {
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .portfolio-page {
      padding-top: 135px;
    }

    .featured-section,
    .more-work {
      width: min(760px, 100%);
    }

    .featured-text {
      width: 100%;
    }

    .video-grid {
      gap: 60px 30px;
    }
  }

  @media (max-width: 780px) {
    .portfolio-head {
      margin-bottom: 66px;
    }

    .featured-section {
      margin-bottom: 92px;
    }

    .featured-text {
      padding-top: 30px;
    }

    .more-work {
      margin-bottom: 84px;
      padding-top: 74px;
    }

    .more-work-head {
      margin-bottom: 46px;
    }

    .video-grid {
      grid-template-columns: 1fr;
      gap: 64px;
      width: min(720px, 100%);
      margin: 0 auto;
    }

    .video-text p {
      max-width: 680px;
    }
  }

  @media (max-width: 620px) {
    .portfolio-page {
      padding: 120px 14px 80px;
    }

    .portfolio-head {
      margin-bottom: 54px;
    }

    .portfolio-head p {
      margin-bottom: 21px;
      font-size: 10px;
      letter-spacing: 0.3em;
    }

    .portfolio-head h1 {
      font-size: clamp(38px, 12vw, 52px);
      letter-spacing: -0.06em;
      line-height: 1.02;
    }

    .portfolio-head span {
      margin-top: 25px;
      font-size: 15px;
      line-height: 1.55;
    }

    .featured-section {
      margin-bottom: 76px;
    }

    .featured-frame {
      border-radius: 20px;
      box-shadow: 0 22px 58px rgba(23, 24, 29, 0.15);
    }

    .featured-text {
      padding-top: 25px;
    }

    .video-type {
      margin-bottom: 9px;
      font-size: 10px;
      letter-spacing: 0.16em;
    }

    .featured-text h2 {
      font-size: 34px;
      line-height: 1.06;
    }

    .featured-text p {
      margin-top: 17px;
      font-size: 15px;
      line-height: 1.68;
    }

    .more-work {
      margin-bottom: 70px;
      padding-top: 62px;
    }

    .more-work-head {
      margin-bottom: 40px;
    }

    .more-work-head p {
      margin-bottom: 15px;
      font-size: 10px;
      letter-spacing: 0.26em;
    }

    .more-work-head h2 {
      font-size: 36px;
    }

    .video-grid {
      gap: 56px;
    }

    .video-frame {
      border-radius: 18px;
      box-shadow: 0 20px 52px rgba(23, 24, 29, 0.11);
    }

    .video-text {
      padding-top: 21px;
    }

    .video-text h3 {
      font-size: 27px;
      line-height: 1.1;
    }

    .video-text p {
      margin-top: 14px;
      font-size: 15px;
      line-height: 1.62;
    }

    .personal-films {
      margin-bottom: 64px;
      padding: 23px 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 15px;
    }

    .personal-films p {
      font-size: 15px;
    }

    .cta-inner {
      padding: 54px 22px;
      border-radius: 22px;
    }

    .cta h2 {
      font-size: 36px;
      line-height: 1.08;
    }

    .cta p {
      margin-top: 22px;
      font-size: 16px;
      line-height: 1.6;
    }

    .cta a {
      width: 100%;
      height: 52px;
      margin-top: 34px;
      padding: 0 22px;
      font-size: 15px;
    }
  }
</style>