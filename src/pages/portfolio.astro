
---
import BaseLayout from "../layouts/BaseLayout.astro";

const featuredFilm = {
  names: "Phelina & Mert",
  label: "Highlightfilm",
  src: "https://galleries.vidflow.co/videos/h7wkezfr",
};

const weddingStories = [
  {
    names: "Nina & Kevin",
    videos: [
      {
        label: "Wedding Teaser",
        src: "https://galleries.vidflow.co/videos/wf8ljusx",
      },
      {
        label: "Paarmomente",
        src: "https://galleries.vidflow.co/videos/klappejw",
      },
    ],
  },
  {
    names: "Melisa & Adis",
    videos: [
      {
        label: "Wedding Teaser",
        src: "https://galleries.vidflow.co/videos/n0p8pq7w",
      },
      {
        label: "Paarmomente",
        src: "https://galleries.vidflow.co/videos/yajaab4f",
      },
    ],
  },
  {
    names: "Aleyna & Güven",
    videos: [
      {
        label: "Paarmomente",
        src: "https://galleries.vidflow.co/videos/gtv6l0mx",
      },
    ],
  },
];
---

<BaseLayout
  title="Portfolio | Hochzeitsfilme von VJ Production"
  description="Entdeckt emotionale Hochzeitsgeschichten und cineastische Hochzeitsfilme von VJ Production. Hochzeitsvideograf aus Witten für NRW und deutschlandweit."
>
  <div id="vjPortfolio" class="vj-portfolio-page">

    <!-- EINSTIEG -->
    <header class="vj-portfolio-hero">
      <p class="vj-eyebrow">
        VJ Production · Portfolio
      </p>

      <h1>
        Jede Liebe erzählt<br />
        ihre eigene Geschichte.
      </h1>

      <p class="vj-hero-description">
        Echte Momente. Große Gefühle. Erinnerungen, die bleiben.
      </p>
    </header>

    <!-- AUSGEWÄHLTER HOCHZEITSFILM -->
    <section
      class="vj-featured-section"
      aria-labelledby="vjFeaturedTitle"
    >
      <div class="vj-featured-video">
        <iframe
          src={featuredFilm.src}
          title={`${featuredFilm.label} – ${featuredFilm.names}`}
          loading="eager"
          allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
          allowfullscreen
        ></iframe>
      </div>

      <div class="vj-featured-caption">
        <h2 id="vjFeaturedTitle">
          {featuredFilm.names}
        </h2>

        <span>{featuredFilm.label}</span>
      </div>
    </section>

    <!-- HOCHZEITSGESCHICHTEN -->
    <section
      class="vj-stories-section"
      aria-labelledby="vjStoriesTitle"
    >
      <div class="vj-section-intro">
        <p class="vj-eyebrow">
          Ausgewählte Arbeiten
        </p>

        <h2 id="vjStoriesTitle">
          Weitere Hochzeitsgeschichten
        </h2>
      </div>

      <div class="vj-stories-list">
        {weddingStories.map((story) => (
          <article class="vj-story">

            <div class="vj-story-heading">
              <h3>{story.names}</h3>
            </div>

            <div
              class:list={[
                "vj-story-videos",
                { "vj-story-videos--single": story.videos.length === 1 },
              ]}
            >
              {story.videos.map((video) => (
                <div class="vj-story-film">
                  <div class="vj-video-frame">
                    <iframe
                      src={video.src}
                      title={`${video.label} – ${story.names}`}
                      loading="lazy"
                      allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
                      allowfullscreen
                    ></iframe>
                  </div>

                  <p class="vj-film-caption">
                    {video.label}
                  </p>
                </div>
              ))}
            </div>

          </article>
        ))}
      </div>
    </section>

    <!-- FOTO UND VIDEO ALS TEAM -->
    <section
      class="vj-partner-section"
      id="foto-video-team"
      aria-labelledby="vjPartnerTitle"
    >
      <div class="vj-partner-content">

        <p class="vj-eyebrow">
          Foto &amp; Video als Team
        </p>

        <h2 id="vjPartnerTitle">
          Zwei Perspektiven.<br />
          Eine Geschichte.
        </h2>

        <p>
          Gemeinsam mit Julia von
          <strong>Junique Photography</strong>
          begleite ich Hochzeiten auch als eingespieltes
          Foto- und Videoteam. So können Fotos und Film
          aufeinander abgestimmt entstehen, ohne dass ihr
          euren Tag für die Kamera unterbrechen müsst.
        </p>

        <a
          href="https://juniquephotography.de"
          class="vj-partner-link"
          target="_blank"
          rel="noopener noreferrer"
        >
          Junique Photography entdecken
          <span aria-hidden="true">↗</span>
        </a>

      </div>
    </section>

    <!-- KONTAKTBEREICH -->
    <section
      class="vj-portfolio-cta"
      aria-labelledby="vjPortfolioCtaTitle"
    >
      <p class="vj-eyebrow">
        Eure Geschichte
      </p>

      <h2 id="vjPortfolioCtaTitle">
        Und wie soll eure<br />
        Geschichte aussehen?
      </h2>

      <p>
        Erzählt mir von euren Plänen.
        Ich freue mich darauf, euch kennenzulernen
        und euren Hochzeitstag in bewegten Bildern
        festzuhalten.
      </p>

      <a href="/kontakt" class="vj-cta-button">
        Verfügbarkeit anfragen
        <span aria-hidden="true">→</span>
      </a>
    </section>

  </div>
</BaseLayout>

<style is:global>
  /* ================================= */
  /* VJ PRODUCTION – PORTFOLIO */
  /* ================================= */

  #vjPortfolio {
    --portfolio-orange: #b46300;
    --portfolio-orange-hover: #965000;
    --portfolio-ink: #17181d;
    --portfolio-muted: #696b73;
    --portfolio-line: #e5e5e8;

    display: block;
    width: 100%;
    margin: 0;
    padding: 151px 24px 105px;

    background: #ffffff;
    color: var(--portfolio-ink);
  }

  #vjPortfolio *,
  #vjPortfolio *::before,
  #vjPortfolio *::after {
    box-sizing: border-box;
  }

  #vjPortfolio a {
    text-decoration: none;
  }

  #vjPortfolio a:focus-visible {
    outline: 3px solid var(--portfolio-orange);
    outline-offset: 5px;
  }

  #vjPortfolio .vj-eyebrow {
    margin: 0;

    color: var(--portfolio-orange);
    font-size: 11px;
    font-weight: 800;
    line-height: 1.5;
    letter-spacing: .2em;
    text-transform: uppercase;
  }

  #vjPortfolio .vj-featured-section,
  #vjPortfolio .vj-stories-section,
  #vjPortfolio .vj-partner-section,
  #vjPortfolio .vj-portfolio-cta {
    width: min(1180px, 100%);
    margin-left: auto;
    margin-right: auto;
  }

  /* ============================ */
  /* HERO */
  /* ============================ */

  #vjPortfolio .vj-portfolio-hero {
    max-width: 940px;
    margin: 0 auto 70px;
    text-align: center;
  }

  #vjPortfolio .vj-portfolio-hero .vj-eyebrow {
    margin-bottom: 21px;
  }

  #vjPortfolio .vj-portfolio-hero h1 {
    margin: 0;

    color: var(--portfolio-ink);
    font-size: clamp(40px, 5.6vw, 76px);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: -.065em;
  }

  #vjPortfolio .vj-hero-description {
    margin: 25px auto 0;

    color: var(--portfolio-muted);
    font-size: 16px;
    line-height: 1.7;
  }

  /* ============================ */
  /* VIDEOFORMAT 16:9 */
  /* ============================ */

  #vjPortfolio .vj-featured-video,
  #vjPortfolio .vj-video-frame {
    position: relative;
    display: block;

    width: 100%;
    aspect-ratio: 16 / 9;

    overflow: hidden;

    border-radius: 12px;
    background: #111216;
  }

  #vjPortfolio .vj-featured-video iframe,
  #vjPortfolio .vj-video-frame iframe {
    position: absolute;
    inset: 0;

    display: block;
    width: 100%;
    height: 100%;

    padding: 0;
    margin: 0;
    border: 0;
  }

  /* ============================ */
  /* HAUPTFILM */
  /* ============================ */

  #vjPortfolio .vj-featured-section {
    padding-bottom: 107px;
    border-bottom: 1px solid var(--portfolio-line);
  }

  #vjPortfolio .vj-featured-video {
    border-radius: 19px;
    box-shadow: 0 20px 65px rgba(23, 24, 29, .11);
  }

  #vjPortfolio .vj-featured-caption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;

    padding: 27px 2px 0;
  }

  #vjPortfolio .vj-featured-caption h2 {
    margin: 0;

    color: var(--portfolio-ink);
    font-size: clamp(35px, 4.5vw, 53px);
    font-weight: 350;
    line-height: 1.12;
    letter-spacing: -.055em;
  }

  #vjPortfolio .vj-featured-caption > span {
    color: var(--portfolio-muted);
    font-size: 13px;
    line-height: 1.5;
  }

  /* ============================ */
  /* WEITERE HOCHZEITSGESCHICHTEN */
  /* ============================ */

  #vjPortfolio .vj-stories-section {
    padding-top: 105px;
    padding-bottom: 106px;
  }

  #vjPortfolio .vj-section-intro {
    max-width: 800px;
    margin: 0 auto 75px;
    text-align: center;
  }

  #vjPortfolio .vj-section-intro .vj-eyebrow {
    margin-bottom: 17px;
  }

  #vjPortfolio .vj-section-intro h2 {
    margin: 0;

    color: var(--portfolio-ink);
    font-size: clamp(34px, 4.4vw, 52px);
    font-weight: 350;
    line-height: 1.12;
    letter-spacing: -.055em;
  }

  #vjPortfolio .vj-stories-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 86px;
  }

  #vjPortfolio .vj-story {
    width: 100%;
    min-width: 0;
  }

  /* PAARNAMEN */

  #vjPortfolio .vj-story-heading {
    margin-bottom: 27px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--portfolio-line);
  }

  #vjPortfolio .vj-story-heading h3 {
    margin: 0;

    color: var(--portfolio-ink);
    font-size: clamp(34px, 4vw, 48px);
    font-weight: 350;
    line-height: 1.15;
    letter-spacing: -.055em;
  }

  /* ZWEI VIDEOS PRO PAAR */

  #vjPortfolio .vj-story-videos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 25px;
    align-items: start;
  }

  #vjPortfolio .vj-story-film {
    min-width: 0;
  }

  /* EINZELNES VIDEO */

  #vjPortfolio .vj-story-videos--single {
    grid-template-columns: minmax(0, 1fr);
    width: min(850px, 100%);
    margin: 0 auto;
  }

  /* MINIMALISTISCHE BESCHRIFTUNG */

  #vjPortfolio .vj-film-caption {
    margin: 17px 2px 0;

    color: var(--portfolio-muted);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.5;
  }

  /* ============================ */
  /* FOTO UND VIDEO ALS TEAM */
  /* ============================ */

  #vjPortfolio .vj-partner-section {
    padding: 50px 55px;
    margin-bottom: 95px;

    border: 1px solid #e8e8e9;
    border-radius: 18px;
    background: #f7f7f6;

    scroll-margin-top: 110px;
  }

  #vjPortfolio .vj-partner-content {
    max-width: 800px;
  }

  #vjPortfolio .vj-partner-content .vj-eyebrow {
    margin-bottom: 18px;
  }

  #vjPortfolio .vj-partner-content h2 {
    margin: 0;

    color: var(--portfolio-ink);
    font-size: clamp(33px, 4vw, 47px);
    font-weight: 350;
    line-height: 1.12;
    letter-spacing: -.055em;
  }

  #vjPortfolio .vj-partner-content > p:not(.vj-eyebrow) {
    margin: 21px 0 0;

    color: var(--portfolio-muted);
    font-size: 15px;
    line-height: 1.8;
  }

  #vjPortfolio .vj-partner-content strong {
    color: var(--portfolio-ink);
    font-weight: 700;
  }

  #vjPortfolio .vj-partner-link {
    display: inline-flex;
    align-items: center;
    gap: 13px;

    min-height: 45px;
    margin-top: 27px;

    border-bottom: 1px solid var(--portfolio-orange);

    color: var(--portfolio-ink);
    font-size: 14px;
    font-weight: 750;

    transition: color .2s ease;
  }

  #vjPortfolio .vj-partner-link:hover {
    color: var(--portfolio-orange);
  }

  #vjPortfolio .vj-partner-link span {
    color: var(--portfolio-orange);
  }

  /* ============================ */
  /* KONTAKTBEREICH */
  /* ============================ */

  #vjPortfolio .vj-portfolio-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    padding: 76px 30px;
    border-radius: 19px;

    background: var(--portfolio-ink);
    color: #ffffff;
    text-align: center;
  }

  #vjPortfolio .vj-portfolio-cta .vj-eyebrow {
    margin-bottom: 20px;
    color: #ffb45a;
  }

  #vjPortfolio .vj-portfolio-cta h2 {
    margin: 0;

    color: #ffffff;
    font-size: clamp(37px, 5vw, 59px);
    font-weight: 350;
    line-height: 1.12;
    letter-spacing: -.055em;
  }

  #vjPortfolio .vj-portfolio-cta > p:not(.vj-eyebrow) {
    max-width: 630px;
    margin: 23px auto 0;

    color: rgba(255, 255, 255, .75);
    font-size: 15px;
    line-height: 1.8;
  }

  #vjPortfolio .vj-cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 17px;

    min-height: 54px;
    margin-top: 32px;
    padding: 13px 27px;

    border: 0;
    border-radius: 7px;

    background: var(--portfolio-orange);
    color: #ffffff;

    font-size: 14px;
    font-weight: 800;
    line-height: 1.3;

    transition:
      background .2s ease,
      transform .2s ease;
  }

  #vjPortfolio .vj-cta-button:hover {
    background: var(--portfolio-orange-hover);
    transform: translateY(-2px);
  }

  /* ============================ */
  /* TABLET */
  /* ============================ */

  @media (max-width: 900px) {
    #vjPortfolio .vj-story-videos {
      gap: 19px;
    }

    #vjPortfolio .vj-stories-list {
      gap: 73px;
    }
  }

  /* ============================ */
  /* HANDY */
  /* ============================ */

  @media (max-width: 700px) {
    #vjPortfolio {
      padding: 121px 17px 80px;
    }

    #vjPortfolio .vj-portfolio-hero {
      margin-bottom: 47px;
    }

    #vjPortfolio .vj-portfolio-hero h1 {
      font-size: clamp(37px, 9vw, 54px);
    }

    #vjPortfolio .vj-portfolio-hero h1 br,
    #vjPortfolio .vj-partner-content h2 br,
    #vjPortfolio .vj-portfolio-cta h2 br {
      display: none;
    }

    #vjPortfolio .vj-hero-description {
      margin-top: 20px;
      font-size: 15px;
    }

    #vjPortfolio .vj-featured-video {
      border-radius: 10px;
      box-shadow: none;
    }

    #vjPortfolio .vj-featured-section {
      padding-bottom: 73px;
    }

    #vjPortfolio .vj-featured-caption {
      padding-top: 20px;
    }

    #vjPortfolio .vj-featured-caption h2 {
      font-size: 34px;
    }

    #vjPortfolio .vj-stories-section {
      padding-top: 73px;
      padding-bottom: 77px;
    }

    #vjPortfolio .vj-section-intro {
      margin-bottom: 48px;
    }

    #vjPortfolio .vj-section-intro h2 {
      font-size: 35px;
    }

    #vjPortfolio .vj-stories-list {
      gap: 65px;
    }

    #vjPortfolio .vj-story-heading {
      margin-bottom: 22px;
      padding-bottom: 17px;
    }

    #vjPortfolio .vj-story-heading h3 {
      font-size: 35px;
    }

    #vjPortfolio .vj-story-videos {
      grid-template-columns: minmax(0, 1fr);
      gap: 35px;
    }

    #vjPortfolio .vj-video-frame {
      border-radius: 9px;
    }

    #vjPortfolio .vj-film-caption {
      margin-top: 13px;
    }

    #vjPortfolio .vj-partner-section {
      padding: 35px 28px;
      margin-bottom: 75px;
    }

    #vjPortfolio .vj-portfolio-cta {
      padding: 61px 23px;
    }
  }

  /* ============================ */
  /* KLEINE HANDYS */
  /* ============================ */

  @media (max-width: 480px) {
    #vjPortfolio {
      padding: 117px 14px 68px;
    }

    #vjPortfolio .vj-portfolio-hero h1 {
      font-size: clamp(36px, 9.5vw, 44px);
    }

    #vjPortfolio .vj-featured-caption {
      align-items: flex-start;
      flex-direction: column;
      gap: 7px;
    }

    #vjPortfolio .vj-featured-caption h2 {
      font-size: 35px;
    }

    #vjPortfolio .vj-section-intro h2 {
      font-size: 32px;
    }

    #vjPortfolio .vj-story-heading h3 {
      font-size: 34px;
    }

    #vjPortfolio .vj-partner-section {
      padding: 30px 23px;
      border-radius: 14px;
    }

    #vjPortfolio .vj-portfolio-cta {
      padding: 53px 20px;
      border-radius: 15px;
    }

    #vjPortfolio .vj-portfolio-cta h2 {
      font-size: 37px;
    }

    #vjPortfolio .vj-cta-button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #vjPortfolio .vj-partner-link,
    #vjPortfolio .vj-cta-button {
      transition: none;
    }
  }
</style>
