---
import BaseLayout from "../layouts/BaseLayout.astro";

const featuredVideos = [
  {
    couple: "Phelina & Mert",
    type: "Wedding Teaser",
    text: "Ein emotionaler Vorgeschmack auf ihren Hochzeitstag, kompakt, cineastisch und voller echter Momente.",
    src: "https://galleries.vidflow.co/videos/mxd73jvr",
  },
  {
    couple: "Melisa & Adis",
    type: "Wedding Teaser",
    text: "Ein lebendiger Einblick in ihren Hochzeitstag mit echten Emotionen, besonderen Augenblicken und ausgelassener Stimmung.",
    src: "https://galleries.vidflow.co/videos/ci2k0ber",
  },
];

const videos = [
  {
    couple: "Jana & Stefan",
    type: "Wedding Film",
    text: "Eine ausführliche Erinnerung an ihren Hochzeitstag mit Atmosphäre, Reden und all den kleinen Momenten dazwischen.",
    src: "https://galleries.vidflow.co/videos/kx680fsh",
  },
  {
    couple: "Aleyna & Güven",
    type: "Verlobungsfilm",
    text: "Ein emotionaler Film über ihren besonderen Moment, natürlich, persönlich und cineastisch festgehalten.",
    src: "https://galleries.vidflow.co/videos/r29jufq6",
  },
  {
    couple: "Melisa & Adis",
    type: "Paarshooting",
    text: "Ruhige und natürliche Paaraufnahmen mit viel Nähe, Bewegung und Atmosphäre.",
    src: "https://galleries.vidflow.co/videos/b2ayyew1",
  },
];
---

<BaseLayout
  title="Portfolio | Hochzeitsvideograf Witten & NRW | VJ Production"
  description="Ausgewählte Hochzeitsfilme, Wedding Teaser, Verlobungsfilme und Paarshootings von VJ Production. Hochzeitsvideograf aus Witten für NRW und deutschlandweit."
>
  <section class="portfolio-page">
    <section class="portfolio-head">
      <p>Portfolio</p>
      <h1>Ausgewählte Hochzeitsfilme</h1>
      <span>Echte Momente. Ruhig begleitet. Cineastisch erzählt.</span>
    </section>

    <section class="featured-grid">
      {featuredVideos.map((video, index) => (
        <article class="featured-project">
          <div class="featured-frame">
            <iframe
              src={video.src}
              title={`${video.type} | ${video.couple}`}
              frameborder="0"
              allowfullscreen
              webkitallowfullscreen
              mozallowfullscreen
              loading={index === 0 ? "eager" : "lazy"}
            ></iframe>
          </div>

          <div class="featured-text">
            <span class="video-type">{video.type}</span>
            <h2>{video.couple}</h2>
            <p>{video.text}</p>
          </div>
        </article>
      ))}
    </section>

    <section class="video-grid">
      {videos.map((video) => (
        <article class="video-item">
          <div class="video-frame">
            <iframe
              src={video.src}
              title={`${video.type} | ${video.couple}`}
              frameborder="0"
              allowfullscreen
              webkitallowfullscreen
              mozallowfullscreen
              loading="lazy"
            ></iframe>
          </div>

          <div class="video-text">
            <span class="video-type">{video.type}</span>
            <h2>{video.couple}</h2>
            <p>{video.text}</p>
          </div>
        </article>
      ))}
    </section>

    <section class="more-films">
      <p>
        Weitere ausgewählte Arbeiten zeige ich euch gerne im persönlichen Gespräch.
      </p>

      <a href="/kontakt">
        Weitere Filme ansehen
        <span>→</span>
      </a>
    </section>

    <section class="cta">
      <div>
        <h2>Bereit für euren Film?</h2>

        <p>
          Lasst uns in einem unverbindlichen Gespräch herausfinden, wie ich euren Tag
          am besten festhalte.
        </p>

        <a href="/kontakt">
          Verfügbarkeit anfragen
          <span>→</span>
        </a>
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  :global(body) {
    background: white;
  }

  .portfolio-page {
    padding: 150px 20px 120px;
    background: white;
    color: #17181d;
  }

  .portfolio-head {
    width: min(1180px, 100%);
    margin: 0 auto 82px;
    text-align: center;
  }

  .portfolio-head p {
    margin: 0 0 26px;
    color: #df7b00;
    text-transform: uppercase;
    letter-spacing: 0.34em;
    font-size: 12px;
    font-weight: 800;
  }

  .portfolio-head h1 {
    margin: 0;
    color: #17181d;
    font-size: clamp(44px, 6vw, 72px);
    font-weight: 300;
    letter-spacing: -0.075em;
    line-height: 0.98;
  }

  .portfolio-head span {
    display: block;
    margin-top: 34px;
    color: #777984;
    font-size: 16px;
    line-height: 1.5;
  }

  .featured-grid {
    width: min(1320px, 100%);
    margin: 0 auto 110px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 44px;
  }

  .featured-project {
    min-width: 0;
  }

  .featured-frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 28px;
    background: #f3f3f4;
    aspect-ratio: 16 / 9;
    box-shadow: 0 30px 80px rgba(23, 24, 29, 0.14);
  }

  .featured-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .featured-text {
    padding-top: 28px;
  }

  .video-type {
    display: block;
    margin-bottom: 10px;
    color: #df7b00;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 11px;
    font-weight: 800;
    line-height: 1.3;
  }

  .featured-text h2 {
    margin: 0;
    color: #17181d;
    font-size: clamp(30px, 3vw, 42px);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1.08;
  }

  .featured-text p {
    max-width: 600px;
    margin: 18px 0 0;
    color: #5f626d;
    font-size: 16px;
    line-height: 1.65;
  }

  .video-grid {
    width: min(1320px, 100%);
    margin: 0 auto 96px;
    padding-top: 84px;
    border-top: 1px solid #e4e4e7;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 58px 34px;
  }

  .video-item {
    min-width: 0;
  }

  .video-frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 24px;
    background: #f3f3f4;
    aspect-ratio: 16 / 9;
    box-shadow: 0 22px 60px rgba(23, 24, 29, 0.1);
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .video-text {
    padding-top: 24px;
  }

  .video-text h2 {
    margin: 0;
    color: #17181d;
    font-size: clamp(22px, 2vw, 28px);
    font-weight: 400;
    letter-spacing: -0.045em;
    line-height: 1.15;
  }

  .video-text p {
    max-width: 620px;
    margin: 16px 0 0;
    color: #5f626d;
    font-size: 15px;
    line-height: 1.6;
  }

  .more-films {
    width: min(920px, 100%);
    margin: 0 auto 82px;
    padding: 25px 0;
    border-top: 1px solid #e4e4e7;
    border-bottom: 1px solid #e4e4e7;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .more-films p {
    margin: 0;
    color: #5f626d;
    font-size: 16px;
    line-height: 1.6;
  }

  .more-films a {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: #df7b00;
    font-size: 15px;
    font-weight: 800;
    text-decoration: none;
  }

  .more-films a span {
    font-size: 18px;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  .more-films a:hover span {
    transform: translateX(4px);
  }

  .cta {
    width: min(1220px, 100%);
    margin: 0 auto;
  }

  .cta > div {
    padding: 74px 30px;
    border-radius: 28px;
    background: #17181d;
    color: white;
    text-align: center;
  }

  .cta h2 {
    margin: 0;
    font-size: clamp(36px, 4vw, 52px);
    font-weight: 300;
    letter-spacing: -0.045em;
  }

  .cta p {
    max-width: 760px;
    margin: 26px auto 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: 18px;
    line-height: 1.62;
  }

  .cta a {
    margin-top: 40px;
    display: inline-flex;
    height: 56px;
    padding: 0 38px;
    border-radius: 7px;
    background: #df7b00;
    color: white;
    align-items: center;
    gap: 18px;
    font-size: 16px;
    font-weight: 800;
    text-decoration: none;
  }

  .cta a span {
    font-size: 18px;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  .cta a:hover span {
    transform: translateX(4px);
  }

  @media (max-width: 1050px) {
    .featured-grid {
      gap: 30px;
    }

    .video-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .video-item:last-child {
      grid-column: 1 / -1;
      width: min(640px, 100%);
      justify-self: center;
    }
  }

  @media (max-width: 780px) {
    .featured-grid {
      grid-template-columns: 1fr;
      width: min(720px, 100%);
      gap: 72px;
    }

    .featured-text p {
      max-width: 680px;
    }

    .video-grid {
      grid-template-columns: 1fr;
      gap: 54px;
      width: min(720px, 100%);
    }

    .video-item:last-child {
      grid-column: auto;
      width: 100%;
    }
  }

  @media (max-width: 620px) {
    .portfolio-page {
      padding: 120px 14px 80px;
    }

    .portfolio-head {
      margin-bottom: 58px;
    }

    .portfolio-head h1 {
      font-size: clamp(38px, 12vw, 52px);
      letter-spacing: -0.06em;
      line-height: 1.02;
    }

    .portfolio-head span {
      margin-top: 26px;
      font-size: 16px;
    }

    .featured-grid {
      margin-bottom: 78px;
      gap: 68px;
    }

    .featured-project {
      position: relative;
    }

    .featured-project + .featured-project::before {
      content: "";
      position: absolute;
      top: -34px;
      left: 50%;
      width: 46px;
      height: 1px;
      background: #dedfe3;
      transform: translateX(-50%);
    }

    .featured-frame {
      border-radius: 22px;
      box-shadow: 0 24px 60px rgba(23, 24, 29, 0.13);
    }

    .featured-text {
      padding-top: 24px;
    }

    .video-type {
      margin-bottom: 9px;
      font-size: 10px;
      letter-spacing: 0.17em;
    }

    .featured-text h2 {
      font-size: 30px;
      line-height: 1.08;
    }

    .featured-text p {
      margin-top: 15px;
      font-size: 15px;
      line-height: 1.65;
    }

    .video-grid {
      margin-bottom: 68px;
      padding-top: 64px;
      gap: 56px;
    }

    .video-frame {
      border-radius: 20px;
    }

    .video-text {
      padding-top: 20px;
    }

    .video-text h2 {
      font-size: 24px;
      line-height: 1.15;
    }

    .video-text p {
      margin-top: 14px;
      font-size: 15px;
      line-height: 1.6;
    }

    .more-films {
      margin-bottom: 64px;
      padding: 22px 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }

    .more-films p {
      font-size: 15px;
    }

    .cta > div {
      padding: 54px 22px;
      border-radius: 22px;
    }

    .cta p {
      font-size: 16px;
    }

    .cta a {
      width: 100%;
      height: 52px;
      padding: 0 22px;
      justify-content: center;
      font-size: 15px;
    }
  }
</style>