---
import BaseLayout from "../layouts/BaseLayout.astro";

const featuredVideo = {
  couple: "Phelina & Mert",
  type: "Highlightfilm",
  text: "Eine emotionale und cineastische Zusammenfassung ihres Hochzeitstages mit echten Momenten, persönlichen Worten und der besonderen Atmosphäre des gesamten Tages.",
  src: "https://galleries.vidflow.co/videos/h7wkezfr",
};

const videos = [
  {
    couple: "Melisa & Adis",
    type: "Wedding Teaser",
    text: "Ein lebendiger Einblick in ihren Hochzeitstag mit echten Emotionen, besonderen Augenblicken und ausgelassener Stimmung.",
    src: "https://galleries.vidflow.co/videos/ci2k0ber",
  },
  {
    couple: "Jana & Stefan",
    type: "Wedding Film",
    text: "Eine ausführliche Erinnerung an ihren Hochzeitstag mit Atmosphäre, Reden und all den kleinen Momenten dazwischen.",
    src: "https://galleries.vidflow.co/videos/kx680fsh",
  },
  {
    couple: "Aleyna & Güven",
    type: "Verlobungsfilm",
    text: "Ein emotionaler Film über ihren besonderen Moment, natürlich, persönlich und cineastisch festgehalten.",
    src: "https://galleries.vidflow.co/videos/r29jufq6",
  },
  {
    couple: "Melisa & Adis",
    type: "Paarshooting",
    text: "Ruhige und natürliche Paaraufnahmen mit viel Nähe, Bewegung und Atmosphäre.",
    src: "https://galleries.vidflow.co/videos/b2ayyew1",
  },
];
---

<BaseLayout
  title="Portfolio | Hochzeitsvideograf Witten & NRW | VJ Production"
  description="Ausgewählte Hochzeitsfilme, Wedding Teaser, Verlobungsfilme und Paarshootings von VJ Production. Hochzeitsvideograf aus Witten für NRW und deutschlandweit."
>
  <main class="portfolio-page">
    <section class="portfolio-head">
      <p>Portfolio</p>

      <h1>Ausgewählte Hochzeitsfilme</h1>

      <span>
        Echte Momente. Ruhig begleitet. Cineastisch erzählt.
      </span>
    </section>

    <section class="featured-section">
      <article class="featured-project">
        <div class="featured-frame">
          <iframe
            class="vidflow-player"
            src={featuredVideo.src}
            title={`${featuredVideo.type} | ${featuredVideo.couple}`}
            frameborder="0"
            scrolling="no"
            allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
            allowfullscreen
            webkitallowfullscreen="true"
            mozallowfullscreen="true"
          ></iframe>
        </div>

        <div class="featured-text">
          <span class="video-type">{featuredVideo.type}</span>

          <h2>{featuredVideo.couple}</h2>

          <p>{featuredVideo.text}</p>
        </div>
      </article>
    </section>

    <section class="more-work">
      <div class="more-work-head">
        <p>Weitere Arbeiten</p>

        <h2>Mehr echte Geschichten</h2>
      </div>

      <div class="video-grid">
        {videos.map((video) => (
          <article class="video-item">
            <div class="video-frame">
              <iframe
                class="vidflow-player"
                src={video.src}
                title={`${video.type} | ${video.couple}`}
                frameborder="0"
                scrolling="no"
                allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
                allowfullscreen
                webkitallowfullscreen="true"
                mozallowfullscreen="true"
                loading="lazy"
              ></iframe>
            </div>

            <div class="video-text">
              <span class="video-type">{video.type}</span>

              <h3>{video.couple}</h3>

              <p>{video.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="personal-films">
      <p>
        Weitere ausgewählte Arbeiten zeige ich euch gerne im persönlichen Gespräch.
      </p>

      <a href="/kontakt">
        Persönlich kennenlernen
        <span>→</span>
      </a>
    </section>

    <section
      class="partner-recommendation"
      id="foto-video-team"
    >
      <div class="partner-card">
        <div class="partner-content">
          <p class="partner-kicker">Foto & Video als Team</p>

          <h2>Hochzeitsfotografie passend zu eurem Film</h2>

          <p>
            Gemeinsam mit Julia von <strong>Junique Photography</strong> arbeite ich
            bei vielen Hochzeiten als eingespieltes Foto- und Videoteam zusammen.
            Dadurch können wir uns am Hochzeitstag optimal aufeinander abstimmen und
            natürliche Momente aus unterschiedlichen Perspektiven festhalten, ohne
            euch unnötig aus dem Geschehen herauszuholen.
          </p>

          <p>
            So entstehen Hochzeitsfotos und Hochzeitsfilme, die nicht nur einzeln
            funktionieren, sondern euren Tag gemeinsam authentisch und harmonisch
            erzählen.
          </p>
        </div>

        <a
          class="partner-link"
          href="https://juniquephotography.de"
          target="_blank"
          rel="noopener noreferrer"
        >
          Junique Photography ansehen
          <span>→</span>
        </a>
      </div>
    </section>

    <section class="cta">
      <div class="cta-inner">
        <h2>Bereit für euren Film?</h2>

        <p>
          Lasst uns in einem unverbindlichen Gespräch herausfinden, wie ich euren Tag
          am besten festhalte.
        </p>

        <a href="/kontakt">
          Verfügbarkeit anfragen
          <span>→</span>
        </a>
      </div>
    </section>
  </main>

  <aside
    class="photo-video-hint"
    id="photoVideoHint"
    aria-label="Hinweis zu Foto und Video als Team"
    aria-hidden="true"
  >
    <button
      class="photo-video-hint-close"
      id="photoVideoHintClose"
      type="button"
      aria-label="Hinweis schließen"
    >
      ×
    </button>

    <a
      class="photo-video-hint-link"
      id="photoVideoHintLink"
      href="#foto-video-team"
    >
      <span class="photo-video-hint-kicker">
        Foto & Video als Team
      </span>

      <strong>
        Eingespielt mit Junique Photography
      </strong>

      <span class="photo-video-hint-more">
        Mehr erfahren <span>→</span>
      </span>
    </a>
  </aside>
</BaseLayout>

<script is:inline>
  const photoVideoHint = document.getElementById("photoVideoHint");
  const photoVideoHintClose = document.getElementById("photoVideoHintClose");
  const photoVideoHintLink = document.getElementById("photoVideoHintLink");
  const photoVideoPartnerSection = document.getElementById("foto-video-team");

  if (
    photoVideoHint instanceof HTMLElement &&
    photoVideoPartnerSection instanceof HTMLElement
  ) {
    let dismissed = false;
    let partnerVisible = false;
    let partnerOpened = false;
    let autoHidden = false;
    let autoHideTimer = null;

    try {
      dismissed =
        sessionStorage.getItem("vjPhotoVideoHintDismissed:portfolio") === "1";
    } catch {
      dismissed = false;
    }

    const setHintVisible = (visible) => {
      photoVideoHint.classList.toggle("is-visible", visible);
      photoVideoHint.setAttribute(
        "aria-hidden",
        visible ? "false" : "true"
      );
    };

    const clearAutoHideTimer = () => {
      if (autoHideTimer !== null) {
        window.clearTimeout(autoHideTimer);
        autoHideTimer = null;
      }
    };

    const startAutoHideTimer = () => {
      if (
        autoHideTimer !== null ||
        autoHidden ||
        dismissed ||
        partnerOpened
      ) {
        return;
      }

      autoHideTimer = window.setTimeout(() => {
        autoHidden = true;
        setHintVisible(false);
      }, 8000);
    };

    const updatePhotoVideoHint = () => {
      const pageScrollableHeight =
        document.documentElement.scrollHeight - window.innerHeight;

      const scrollProgress =
        pageScrollableHeight > 0
          ? window.scrollY / pageScrollableHeight
          : 0;

      const shouldShow =
        !dismissed &&
        !autoHidden &&
        !partnerVisible &&
        !partnerOpened &&
        scrollProgress >= 0.28;

      setHintVisible(shouldShow);

      if (shouldShow) {
        startAutoHideTimer();
      }
    };

    if (photoVideoHintClose instanceof HTMLButtonElement) {
      photoVideoHintClose.addEventListener("click", () => {
        dismissed = true;
        clearAutoHideTimer();

        try {
          sessionStorage.setItem(
            "vjPhotoVideoHintDismissed:portfolio",
            "1"
          );
        } catch {}

        setHintVisible(false);
      });
    }

    if (photoVideoHintLink instanceof HTMLAnchorElement) {
      photoVideoHintLink.addEventListener("click", (event) => {
        event.preventDefault();

        partnerOpened = true;
        clearAutoHideTimer();
        setHintVisible(false);

        const reduceMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;

        photoVideoPartnerSection.scrollIntoView({
          behavior: reduceMotion ? "auto" : "smooth",
          block: "start",
        });
      });
    }

    if ("IntersectionObserver" in window) {
      const partnerObserver = new IntersectionObserver(
        (entries) => {
          const entry = entries[0];

          if (!entry) {
            return;
          }

          partnerVisible = entry.isIntersecting;

          if (partnerVisible) {
            setHintVisible(false);
          } else {
            updatePhotoVideoHint();
          }
        },
        {
          threshold: 0.18,
        }
      );

      partnerObserver.observe(photoVideoPartnerSection);
    }

    window.addEventListener("scroll", updatePhotoVideoHint, {
      passive: true,
    });

    window.addEventListener("resize", updatePhotoVideoHint, {
      passive: true,
    });

    window.addEventListener("pageshow", updatePhotoVideoHint);

    updatePhotoVideoHint();
  }
</script>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    background: white;
  }

  .portfolio-page {
    padding: 150px 20px 120px;
    background: white;
    color: #17181d;
  }

  .portfolio-head {
    width: min(1180px, 100%);
    margin: 0 auto 82px;
    text-align: center;
  }

  .portfolio-head p {
    margin: 0 0 26px;
    color: #df7b00;
    text-transform: uppercase;
    letter-spacing: 0.34em;
    font-size: 12px;
    font-weight: 800;
  }

  .portfolio-head h1 {
    margin: 0;
    color: #17181d;
    font-size: clamp(44px, 6vw, 72px);
    font-weight: 300;
    letter-spacing: -0.075em;
    line-height: 0.98;
  }

  .portfolio-head span {
    display: block;
    margin-top: 34px;
    color: #777984;
    font-size: 16px;
    line-height: 1.5;
  }

  .featured-section {
    width: min(1180px, 100%);
    margin: 0 auto 118px;
  }

  .featured-project {
    min-width: 0;
  }

  .featured-frame,
  .video-frame {
    position: relative;
    isolation: isolate;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #111216;
    transform: translateZ(0);
    -webkit-transform: translateZ(0);
  }

  .featured-frame {
    overflow: hidden;
    border-radius: 30px;
    box-shadow: 0 34px 90px rgba(23, 24, 29, 0.18);
  }

  .video-frame {
    overflow: hidden;
    border-radius: 24px;
    box-shadow: 0 24px 65px rgba(23, 24, 29, 0.12);
  }

  .featured-frame iframe,
  .video-frame iframe,
  .vidflow-player {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    min-width: 100%;
    min-height: 100%;
    border: 0;
    display: block;
    pointer-events: auto !important;
    touch-action: auto !important;
    user-select: auto;
    -webkit-user-select: auto;
  }

  .featured-text {
    width: min(850px, 100%);
    padding-top: 38px;
  }

  .video-type {
    display: block;
    margin-bottom: 12px;
    color: #df7b00;
    text-transform: uppercase;
    letter-spacing: 0.19em;
    font-size: 11px;
    font-weight: 800;
    line-height: 1.4;
  }

  .featured-text h2 {
    margin: 0;
    color: #17181d;
    font-size: clamp(38px, 4.2vw, 56px);
    font-weight: 300;
    letter-spacing: -0.06em;
    line-height: 1.04;
  }

  .featured-text p {
    max-width: 780px;
    margin: 22px 0 0;
    color: #5f626d;
    font-size: 17px;
    line-height: 1.72;
  }

  .more-work {
    width: min(1180px, 100%);
    margin: 0 auto 104px;
    padding-top: 92px;
    border-top: 1px solid #e4e4e7;
  }

  .more-work-head {
    margin-bottom: 54px;
    text-align: center;
  }

  .more-work-head p {
    margin: 0 0 18px;
    color: #df7b00;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    font-size: 11px;
    font-weight: 800;
  }

  .more-work-head h2 {
    margin: 0;
    color: #17181d;
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 300;
    letter-spacing: -0.06em;
    line-height: 1.05;
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 72px 42px;
  }

  .video-item {
    min-width: 0;
  }

  .video-text {
    padding-top: 26px;
  }

  .video-text h3 {
    margin: 0;
    color: #17181d;
    font-size: clamp(27px, 2.8vw, 36px);
    font-weight: 400;
    letter-spacing: -0.05em;
    line-height: 1.08;
  }

  .video-text p {
    max-width: 560px;
    margin: 17px 0 0;
    color: #5f626d;
    font-size: 15px;
    line-height: 1.66;
  }

  .personal-films {
    width: min(920px, 100%);
    margin: 0 auto 86px;
    padding: 27px 0;
    border-top: 1px solid #e4e4e7;
    border-bottom: 1px solid #e4e4e7;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .personal-films p {
    margin: 0;
    color: #5f626d;
    font-size: 16px;
    line-height: 1.6;
  }

  .personal-films a {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 13px;
    color: #df7b00;
    font-size: 15px;
    font-weight: 800;
    text-decoration: none;
  }

  .personal-films a span {
    font-size: 18px;
    line-height: 1;
    transition: transform 180ms ease;
  }

  .personal-films a:hover span {
    transform: translateX(4px);
  }

  .partner-recommendation {
    width: min(1180px, 100%);
    margin: 0 auto 84px;
    scroll-margin-top: 110px;
  }

  .partner-card {
    padding: 48px 52px;
    border: 1px solid #e3e3e6;
    border-radius: 22px;
    background: #f8f8f7;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 56px;
  }

  .partner-content {
    max-width: 790px;
  }

  .partner-kicker {
    margin: 0 0 16px;
    color: #df7b00;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    font-size: 10px;
    font-weight: 800;
  }

  .partner-content h2 {
    margin: 0;
    color: #17181d;
    font-size: clamp(30px, 3.3vw, 42px);
    font-weight: 300;
    letter-spacing: -0.05em;
    line-height: 1.1;
  }

  .partner-content > p:not(.partner-kicker) {
    margin: 20px 0 0;
    color: #5f626d;
    font-size: 16px;
    line-height: 1.7;
  }

  .partner-content strong {
    color: #3f4048;
    font-weight: 800;
  }

  .partner-link {
    display: inline-flex;
    min-height: 46px;
    padding: 0 22px;
    border-radius: 7px;
    border: 1px solid #d9d9dd;
    background: white;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: #17181d;
    font-size: 14px;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.04);
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      box-shadow 180ms ease;
  }

  .partner-link:hover {
    transform: translateY(-2px);
    border-color: #df7b00;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.07);
  }

  .partner-link span {
    color: #df7b00;
    transition: transform 180ms ease;
  }

  .partner-link:hover span {
    transform: translateX(3px);
  }

  .photo-video-hint {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 80;
    width: min(340px, calc(100vw - 48px));
    overflow: hidden;
    border: 1px solid rgba(23, 24, 29, 0.12);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.97);
    box-shadow: 0 18px 46px rgba(23, 24, 29, 0.16);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(18px);
    transition:
      opacity 220ms ease,
      transform 220ms ease,
      visibility 220ms ease;
  }

  .photo-video-hint.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .photo-video-hint::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: #df7b00;
  }

  .photo-video-hint-close {
    position: absolute;
    top: 9px;
    right: 10px;
    z-index: 2;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #898a91;
    display: grid;
    place-items: center;
    font: inherit;
    font-size: 22px;
    font-weight: 300;
    line-height: 1;
    cursor: pointer;
  }

  .photo-video-hint-close:hover {
    background: #f0f0f1;
    color: #17181d;
  }

  .photo-video-hint-link {
    min-height: 124px;
    padding: 20px 48px 20px 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    color: #17181d;
    text-decoration: none;
  }

  .photo-video-hint-kicker {
    margin-bottom: 6px;
    color: #df7b00;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 10px;
    font-weight: 800;
    line-height: 1.4;
  }

  .photo-video-hint-link strong {
    padding-right: 6px;
    color: #17181d;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.35;
  }

  .photo-video-hint-more {
    margin-top: 10px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #df7b00;
    font-size: 12px;
    font-weight: 800;
    line-height: 1.3;
  }

  .photo-video-hint-more span {
    transition: transform 180ms ease;
  }

  .photo-video-hint-link:hover .photo-video-hint-more span {
    transform: translateX(3px);
  }

  .cta {
    width: min(1220px, 100%);
    margin: 0 auto;
  }

  .cta-inner {
    padding: 74px 30px;
    border-radius: 28px;
    background: #17181d;
    color: white;
    text-align: center;
  }

  .cta h2 {
    margin: 0;
    font-size: clamp(36px, 4vw, 52px);
    font-weight: 300;
    letter-spacing: -0.045em;
  }

  .cta p {
    max-width: 760px;
    margin: 26px auto 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: 18px;
    line-height: 1.62;
  }

  .cta a {
    margin-top: 40px;
    display: inline-flex;
    height: 56px;
    padding: 0 38px;
    border-radius: 7px;
    background: #df7b00;
    color: white;
    align-items: center;
    justify-content: center;
    gap: 18px;
    font-size: 16px;
    font-weight: 800;
    text-decoration: none;
    transition:
      transform 180ms ease,
      background 180ms ease,
      box-shadow 180ms ease;
  }

  .cta a:hover {
    transform: translateY(-2px);
    background: #ef8500;
    box-shadow: 0 14px 32px rgba(223, 123, 0, 0.24);
  }

  .cta a span {
    font-size: 18px;
    line-height: 1;
    transition: transform 180ms ease;
  }

  .cta a:hover span {
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .portfolio-page {
      padding-top: 135px;
    }

    .featured-section,
    .more-work {
      width: min(760px, 100%);
    }

    .featured-text {
      width: 100%;
    }

    .video-grid {
      gap: 60px 30px;
    }

    .partner-card {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .partner-link {
      width: fit-content;
    }
  }

  @media (max-width: 780px) {
    .portfolio-head {
      margin-bottom: 66px;
    }

    .featured-section {
      margin-bottom: 92px;
    }

    .featured-text {
      padding-top: 30px;
    }

    .more-work {
      margin-bottom: 84px;
      padding-top: 74px;
    }

    .more-work-head {
      margin-bottom: 46px;
    }

    .video-grid {
      grid-template-columns: 1fr;
      gap: 64px;
      width: min(720px, 100%);
      margin: 0 auto;
    }

    .video-text p {
      max-width: 680px;
    }
  }

  @media (max-width: 620px) {
    .portfolio-page {
      padding: 120px 14px 80px;
    }

    .portfolio-head {
      margin-bottom: 54px;
    }

    .portfolio-head p {
      margin-bottom: 21px;
      font-size: 10px;
      letter-spacing: 0.3em;
    }

    .portfolio-head h1 {
      font-size: clamp(38px, 12vw, 52px);
      letter-spacing: -0.06em;
      line-height: 1.02;
    }

    .portfolio-head span {
      margin-top: 25px;
      font-size: 15px;
      line-height: 1.55;
    }

    .featured-section {
      margin-bottom: 76px;
    }

    .featured-frame,
    .video-frame {
      width: 100%;
      aspect-ratio: 16 / 9;
      overflow: visible;
      border-radius: 0;
      isolation: isolate;
      touch-action: auto !important;
    }

    .featured-frame {
      box-shadow: 0 22px 58px rgba(23, 24, 29, 0.15);
