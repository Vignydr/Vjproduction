
---
import BaseLayout from "../layouts/BaseLayout.astro";

const featuredFilm = {
  names: "Phelina & Mert",
  label: "Highlightfilm",
  video: "https://galleries.vidflow.co/videos/h7wkezfr",
};

const weddingStories = [
  {
    names: "Nina & Kevin",
    description:
      "Die großen Emotionen und die leisen Momente – zwei Perspektiven auf ihre Geschichte.",
    mainVideo: {
      label: "Wedding Teaser",
      src: "https://galleries.vidflow.co/videos/wf8ljusx",
    },
    coupleVideo: {
      label: "Paarmomente",
      src: "https://galleries.vidflow.co/videos/klappejw",
    },
  },
  {
    names: "Melisa & Adis",
    description:
      "Ein Hochzeitstag voller besonderer Augenblicke – ergänzt durch persönliche Aufnahmen der beiden.",
    mainVideo: {
      label: "Wedding Teaser",
      src: "https://galleries.vidflow.co/videos/n0p8pq7w",
    },
    coupleVideo: {
      label: "Paarmomente",
      src: "https://galleries.vidflow.co/videos/yajaab4f",
    },
  },
];

const additionalFilm = {
  names: "Aleyna & Güven",
  label: "Filmische Paarmomente",
  src: "https://galleries.vidflow.co/videos/gtv6l0mx",
};
---

<BaseLayout
  title="Portfolio | Hochzeitsfilme von VJ Production"
  description="Entdeckt emotionale Hochzeitsgeschichten und cineastische Hochzeitsfilme von VJ Production. Hochzeitsvideograf aus Witten für NRW und deutschlandweit."
>
  <div id="vjPortfolio" class="vj-portfolio-page">

    <!-- HERO -->
    <header class="vj-portfolio-hero">
      <p class="vj-eyebrow">
        VJ Production · Portfolio
      </p>

      <h1>
        Jede Liebe erzählt<br />
        ihre eigene Geschichte.
      </h1>

      <p class="vj-hero-description">
        Keine Hochzeit gleicht der anderen. Deshalb verdient
        jede Geschichte einen Film, der so einzigartig ist
        wie die Menschen dahinter.
      </p>
    </header>

    <!-- AUSGEWÄHLTER HAUPTFILM -->
    <section
      class="vj-featured-section"
      aria-labelledby="vjFeaturedTitle"
    >
      <div class="vj-featured-video">
        <iframe
          src={featuredFilm.video}
          title={`${featuredFilm.label} – ${featuredFilm.names}`}
          loading="eager"
          allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
          allowfullscreen
        ></iframe>
      </div>

      <div class="vj-featured-info">
        <div>
          <p class="vj-video-label">
            Ausgewählte Hochzeitsgeschichte
          </p>

          <h2 id="vjFeaturedTitle">
            {featuredFilm.names}
          </h2>
        </div>

        <p class="vj-featured-description">
          Ein Film über echte Gefühle, besondere Menschen
          und Augenblicke, die für immer bleiben.
        </p>
      </div>
    </section>

    <!-- WEITERE HOCHZEITSGESCHICHTEN -->
    <section
      class="vj-stories-section"
      aria-labelledby="vjStoriesTitle"
    >
      <div class="vj-section-intro">
        <p class="vj-eyebrow">
          Weitere Geschichten
        </p>

        <h2 id="vjStoriesTitle">
          Liebe in bewegten Bildern.
        </h2>

        <p>
          Ein Hochzeitstag besteht aus unzähligen Momenten.
          Neben den großen Ereignissen sind es oft die
          kleinen, persönlichen Augenblicke, die eine
          Geschichte besonders machen.
        </p>
      </div>

      <div class="vj-stories-list">
        {weddingStories.map((story, index) => (
          <article class="vj-story">

            <!-- PAAR UND BESCHREIBUNG -->
            <div class="vj-story-heading">
              <div class="vj-story-heading-main">
                <span class="vj-story-number">
                  {String(index + 1).padStart(2, "0")}
                </span>

                <div>
                  <p class="vj-story-kicker">
                    Eine Hochzeitsgeschichte
                  </p>

                  <h3>{story.names}</h3>
                </div>
              </div>

              <p class="vj-story-description">
                {story.description}
              </p>
            </div>

            <!-- BEIDE VIDEOS DES PAARES -->
            <div class="vj-story-videos">

              <div class="vj-story-video-item">
                <div class="vj-video-frame">
                  <iframe
                    src={story.mainVideo.src}
                    title={`${story.mainVideo.label} – ${story.names}`}
                    loading="lazy"
                    allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
                    allowfullscreen
                  ></iframe>
                </div>

                <div class="vj-video-caption">
                  <div>
                    <p class="vj-video-label">
                      Film 01
                    </p>

                    <h4>{story.mainVideo.label}</h4>
                  </div>

                  <span class="vj-video-caption-detail">
                    Die Geschichte ihres Tages
                  </span>
                </div>
              </div>

              <div class="vj-story-video-item">
                <div class="vj-video-frame">
                  <iframe
                    src={story.coupleVideo.src}
                    title={`${story.coupleVideo.label} – ${story.names}`}
                    loading="lazy"
                    allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
                    allowfullscreen
                  ></iframe>
                </div>

                <div class="vj-video-caption">
                  <div>
                    <p class="vj-video-label">
                      Film 02
                    </p>

                    <h4>{story.coupleVideo.label}</h4>
                  </div>

                  <span class="vj-video-caption-detail">
                    Die persönlichen Augenblicke
                  </span>
                </div>
              </div>

            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- WEITERER FILMISCHER EINBLICK -->
    <section
      class="vj-additional-section"
      aria-labelledby="vjAdditionalTitle"
    >
      <div class="vj-section-intro">
        <p class="vj-eyebrow">
          Ein weiterer Einblick
        </p>

        <h2 id="vjAdditionalTitle">
          Die kleinen Momente zählen.
        </h2>

        <p>
          Manchmal braucht es keine großen Worte.
          Ein Blick, eine Berührung und die Nähe
          zwischen zwei Menschen erzählen bereits
          eine ganze Geschichte.
        </p>
      </div>

      <article class="vj-additional-film">
        <div class="vj-video-frame">
          <iframe
            src={additionalFilm.src}
            title={`${additionalFilm.label} – ${additionalFilm.names}`}
            loading="lazy"
            allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
            allowfullscreen
          ></iframe>
        </div>

        <div class="vj-additional-caption">
          <div>
            <p class="vj-video-label">
              Persönliche Momente
            </p>

            <h3>{additionalFilm.names}</h3>
          </div>

          <span class="vj-additional-type">
            {additionalFilm.label}
          </span>
        </div>
      </article>
    </section>

    <!-- JULIA / FOTO UND VIDEO -->
    <section
      class="vj-partner-section"
      id="foto-video-team"
      aria-labelledby="vjPartnerTitle"
    >
      <div class="vj-partner-content">
        <p class="vj-eyebrow">
          Foto &amp; Video als Team
        </p>

        <h2 id="vjPartnerTitle">
          Zwei Perspektiven.<br />
          Eine Geschichte.
        </h2>

        <p>
          Gemeinsam mit Julia von
          <strong>Junique Photography</strong>
          begleite ich Hochzeiten auch als eingespieltes
          Foto- und Videoteam.
        </p>

        <p>
          So können Fotos und Film aufeinander abgestimmt
          entstehen, ohne dass ihr euren Tag für die Kamera
          unterbrechen müsst.
        </p>

        <a
          href="https://juniquephotography.de"
          class="vj-partner-link"
          target="_blank"
          rel="noopener noreferrer"
        >
          Junique Photography entdecken
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <!-- ABSCHLUSS / KONTAKT -->
    <section
      class="vj-portfolio-cta"
      aria-labelledby="vjPortfolioCtaTitle"
    >
      <p class="vj-eyebrow">
        Eure Geschichte
      </p>

      <h2 id="vjPortfolioCtaTitle">
        Und wie soll eure<br />
        Geschichte aussehen?
      </h2>

      <p>
        Erzählt mir von euren Plänen.
        Ich freue mich darauf, euch kennenzulernen
        und die besonderen Momente eures Hochzeitstags
        in einem persönlichen Film festzuhalten.
      </p>

      <a href="/kontakt" class="vj-cta-button">
        Verfügbarkeit anfragen
        <span aria-hidden="true">→</span>
      </a>
    </section>

  </div>
</BaseLayout>

<style is:global>
  /* ================================= */
  /* VJ PRODUCTION – NEUES PORTFOLIO */
  /* ================================= */

  #vjPortfolio {
    --portfolio-orange: #b46300;
    --portfolio-orange-hover: #965000;
    --portfolio-ink: #17181d;
    --portfolio-muted: #696b73;
    --portfolio-line: #e5e5e8;

    display: block;
    width: 100%;
    margin: 0;
    padding: 151px 24px 105px;

    background: #ffffff;
    color: var(--portfolio-ink);
  }

  #vjPortfolio *,
  #vjPortfolio *::before,
  #vjPortfolio *::after {
    box-sizing: border-box;
  }

  #vjPortfolio a {
    text-decoration: none;
  }

  #vjPortfolio a:focus-visible {
    outline: 3px solid var(--portfolio-orange);
    outline-offset: 5px;
  }

  #vjPortfolio .vj-eyebrow,
  #vjPortfolio .vj-video-label,
  #vjPortfolio .vj-story-kicker {
    margin: 0;
    color: var(--portfolio-orange);

    font-size: 11px;
    font-weight: 800;
    line-height: 1.5;
    letter-spacing: .2em;
    text-transform: uppercase;
  }

  #vjPortfolio .vj-featured-section,
  #vjPortfolio .vj-stories-section,
  #vjPortfolio .vj-additional-section,
  #vjPortfolio .vj-partner-section,
  #vjPortfolio .vj-portfolio-cta {
    width: min(1180px, 100%);
    margin-left: auto;
    margin-right: auto;
  }

  /* HERO */

  #vjPortfolio .vj-portfolio-hero {
    max-width: 930px;
    margin: 0 auto 68px;
    text-align: center;
  }

  #vjPortfolio .vj-portfolio-hero .vj-eyebrow {
    margin-bottom: 20px;
  }

  #vjPortfolio .vj-portfolio-hero h1 {
    margin: 0;
    color: var(--portfolio-ink);

    font-size: clamp(40px, 5.6vw, 76px);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: -.065em;
  }

  #vjPortfolio .vj-hero-description {
    max-width: 650px;
    margin: 26px auto 0;

    color: var(--portfolio-muted);
    font-size: 17px;
    line-height: 1.8;
  }

  /* EINHEITLICHES VIDEOFORMAT */

  #vjPortfolio .vj-featured-video,
  #vjPortfolio .vj-video-frame {
    position: relative;
    display: block;

    width: 100%;
    aspect-ratio: 16 / 9;

    overflow: hidden;

    background: #111216;
    border-radius: 13px;
  }

  #vjPortfolio .vj-featured-video iframe,
  #vjPortfolio .vj-video-frame iframe {
    position: absolute;
    inset: 0;

    display: block;
    width: 100%;
    height: 100%;

    padding: 0;
    margin: 0;
    border: 0;
  }

  /* HAUPTFILM */

  #vjPortfolio .vj-featured-section {
    padding-bottom: 105px;
    border-bottom: 1px solid var(--portfolio-line);
  }

  #vjPortfolio .vj-featured-video {
    border-radius: 19px;
    box-shadow: 0 20px 65px rgba(23, 24, 29, .12);
  }

  #vjPortfolio .vj-featured-info {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 35px;

    padding-top: 27px;
  }

  #vjPortfolio .vj-featured-info .vj-video-label {
    margin-bottom: 9px;
  }

  #vjPortfolio .vj-featured-info h2 {
    margin: 0;

    font-size: clamp(35px, 4.5vw, 54px);
    font-weight: 350;
    line-height: 1.1;
    letter-spacing: -.05em;
  }

  #vjPortfolio .vj-featured-description {
    max-width: 390px;
    margin: 0 0 3px;

    color: var(--portfolio-muted);
    font-size: 15px;
    line-height: 1.75;
  }

  /* ABSCHNITTSÜBERSCHRIFTEN */

  #vjPortfolio .vj-section-intro {
    max-width: 760px;
    margin: 0 auto 57px;
    text-align: center;
  }

  #vjPortfolio .vj-section-intro .vj-eyebrow {
    margin-bottom: 17px;
  }

  #vjPortfolio .vj-section-intro h2 {
    margin: 0;

    font-size: clamp(34px, 4.4vw, 52px);
    font-weight: 350;
    line-height: 1.12;
    letter-spacing: -.055em;
  }

  #vjPortfolio .vj-section-intro > p:last-child {
    max-width: 650px;
    margin: 21px auto 0;

    color: var(--portfolio-muted);
    font-size: 15px;
    line-height: 1.8;
  }

  /* HOCHZEITSGESCHICHTEN */

  #vjPortfolio .vj-stories-section {
    padding-top: 102px;
    padding-bottom: 100px;
    border-bottom: 1px solid var(--portfolio-line);
  }

  #vjPortfolio .vj-stories-list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 80px;
  }

  #vjPortfolio .vj-story {
    display: block;
    width: 100%;
    min-width: 0;
  }

  #vjPortfolio .vj-story-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 26px;

    margin-bottom: 25px;
    padding-bottom: 22px;

    border-bottom: 1px solid var(--portfolio-line);
  }

  #vjPortfolio .vj-story-heading-main {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    min-width: 0;
  }

  #vjPortfolio .vj-story-number {
    display: inline-block;
    padding-top: 5px;

    color: var(--portfolio-orange);
    font-size: 14px;
    font-weight: 800;
  }

  #vjPortfolio .vj-story-kicker {
    margin-bottom: 8px;
    font-size: 10px;
  }

  #vjPortfolio .vj-story-heading h3 {
    margin: 0;

    font-size: clamp(32px, 3.8vw, 47px);
    font-weight: 350;
    line-height: 1.15;
    letter-spacing: -.055em;
  }

  #vjPortfolio .vj-story-description {
    max-width: 400px;
    margin: 0 0 3px;

    color: var(--portfolio-muted);
    font-size: 14px;
    line-height: 1.75;
  }

  /* ZWEI FILME EINER HOCHZEIT */

  #vjPortfolio .vj-story-videos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  #vjPortfolio .vj-story-video-item {
    min-width: 0;
  }

  #vjPortfolio .vj-video-caption {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;

    padding: 19px 2px 0;
  }

  #vjPortfolio .vj-video-caption .vj-video-label {
    margin-bottom: 6px;
    font-size: 10px;
  }

  #vjPortfolio .vj-video-caption h4 {
    margin: 0;

    color: var(--portfolio-ink);
    font-size: 23px;
    font-weight: 450;
    line-height: 1.2;
    letter-spacing: -.035em;
  }

  #vjPortfolio .vj-video-caption-detail {
    max-width: 165px;
    margin-top: 3px;

    color: var(--portfolio-muted);
    font-size: 12px;
    line-height: 1.6;
    text-align: right;
  }

  /* WEITERER EINBLICK */

  #vjPortfolio .vj-additional-section {
    padding-top: 103px;
    padding-bottom: 107px;
  }

  #vjPortfolio .vj-additional-film {
    display: block;
    width: min(850px, 100%);
    margin: 0 auto;
  }

  #vjPortfolio .vj-additional-caption {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;

    padding-top: 22px;
  }

  #vjPortfolio .vj-additional-caption .vj-video-label {
    margin-bottom: 7px;
  }

  #vjPortfolio .vj-additional-caption h3 {
    margin: 0;

    font-size: clamp(32px, 4vw, 43px);
    font-weight: 350;
    line-height: 1.15;
    letter-spacing: -.05em;
  }

  #vjPortfolio .vj-additional-type {
    margin-bottom: 4px;
    color: var(--portfolio-muted);
    font-size: 13px;
  }

  /* FOTO UND VIDEO ALS TEAM */

  #vjPortfolio .vj-partner-section {
    padding: 49px 55px;
    margin-bottom: 95px;

    border: 1px solid #e8e8e9;
    border-radius: 18px;
    background: #f7f7f6;

    scroll-margin-top: 110px;
  }

  #vjPortfolio .vj-partner-content {
    max-width: 800px;
  }

  #vjPortfolio .vj-partner-content .vj-eyebrow {
    margin-bottom: 17px;
  }

  #vjPortfolio .vj-partner-content h2 {
    margin: 0;

    font-size: clamp(33px, 4vw, 47px);
    font-weight: 350;
    line-height: 1.12;
    letter-spacing: -.055em;
  }

  #vjPortfolio .vj-partner-content > p:not(.vj-eyebrow) {
    margin: 19px 0 0;

    color: var(--portfolio-muted);
    font-size: 15px;
    line-height: 1.75;
  }

  #vjPortfolio .vj-partner-content strong {
    color: var(--portfolio-ink);
    font-weight: 700;
  }

  #vjPortfolio .vj-partner-link {
    display: inline-flex;
    align-items: center;
    gap: 13px;

    min-height: 45px;
    margin-top: 27px;

    border-bottom: 1px solid var(--portfolio-orange);

    color: var(--portfolio-ink);
    font-size: 14px;
    font-weight: 750;

    transition: color .2s ease;
  }

  #vjPortfolio .vj-partner-link:hover {
    color: var(--portfolio-orange);
  }

  #vjPortfolio .vj-partner-link span {
    color: var(--portfolio-orange);
  }

  /* ABSCHLUSS MIT KONTAKTAUFFORDERUNG */

  #vjPortfolio .vj-portfolio-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    padding: 76px 30px;
    border-radius: 19px;

    background: var(--portfolio-ink);
    color: #ffffff;
    text-align: center;
  }

  #vjPortfolio .vj-portfolio-cta .vj-eyebrow {
    margin-bottom: 19px;
    color: #ffb45a;
  }

  #vjPortfolio .vj-portfolio-cta h2 {
    margin: 0;

    color: #ffffff;
    font-size: clamp(37px, 5vw, 59px);
    font-weight: 350;
    line-height: 1.13;
    letter-spacing: -.055em;
  }

  #vjPortfolio .vj-portfolio-cta > p:not(.vj-eyebrow) {
    max-width: 640px;
    margin: 23px auto 0;

    color: rgba(255, 255, 255, .75);
    font-size: 15px;
    line-height: 1.85;
  }

  #vjPortfolio .vj-cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 17px;

    min-height: 54px;
    margin-top: 32px;
    padding: 13px 27px;

    border-radius: 7px;
    background: var(--portfolio-orange);
    color: #ffffff;

    font-size: 14px;
    font-weight: 800;
    line-height: 1.3;

    transition:
      background .2s ease,
      transform .2s ease;
  }

  #vjPortfolio .vj-cta-button:hover {
    background: var(--portfolio-orange-hover);
    transform: translateY(-2px);
  }

  /* TABLET */

  @media (max-width: 900px) {
    #vjPortfolio .vj-story-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 17px;
    }

    #vjPortfolio .vj-story-description {
      max-width: 640px;
      margin-left: 40px;
    }

    #vjPortfolio .vj-video-caption {
      flex-direction: column;
      gap: 6px;
    }

    #vjPortfolio .vj-video-caption-detail {
      max-width: none;
      text-align: left;
    }
  }

  /* HANDY */

  @media (max-width: 700px) {
    #vjPortfolio {
      padding: 121px 17px 80px;
    }

    #vjPortfolio .vj-portfolio-hero {
      margin-bottom: 45px;
    }

    #vjPortfolio .vj-portfolio-hero h1 {
      font-size: clamp(37px, 9vw, 54px);
    }

    #vjPortfolio .vj-portfolio-hero h1 br,
    #vjPortfolio .vj-partner-content h2 br,
    #vjPortfolio .vj-portfolio-cta h2 br {
      display: none;
    }

    #vjPortfolio .vj-hero-description {
      margin-top: 21px;
      font-size: 15px;
    }

    #vjPortfolio .vj-featured-video {
      border-radius: 9px;
      box-shadow: none;
    }

    #vjPortfolio .vj-featured-section {
      padding-bottom: 70px;
    }

    #vjPortfolio .vj-featured-info {
      display: block;
      padding-top: 21px;
    }

    #vjPortfolio .vj-featured-description {
      margin-top: 13px;
    }

    #vjPortfolio .vj-stories-section {
      padding-top: 70px;
      padding-bottom: 72px;
    }

    #vjPortfolio .vj-section-intro {
      margin-bottom: 40px;
    }

    #vjPortfolio .vj-section-intro h2 {
      font-size: 35px;
    }

    #vjPortfolio .vj-stories-list {
      gap: 65px;
    }

    #vjPortfolio .vj-story-heading-main {
      gap: 12px;
    }

    #vjPortfolio .vj-story-description {
      margin-left: 27px;
    }

    #vjPortfolio .vj-story-videos {
      grid-template-columns: minmax(0, 1fr);
      gap: 30px;
    }

    #vjPortfolio .vj-video-frame {
      border-radius: 8px;
    }

    #vjPortfolio .vj-video-caption {
      flex-direction: row;
      align-items: flex-start;
    }

    #vjPortfolio .vj-video-caption-detail {
      max-width: 150px;
      text-align: right;
    }

    #vjPortfolio .vj-additional-section {
      padding-top: 73px;
      padding-bottom: 80px;
    }

