---
import BaseLayout from "../layouts/BaseLayout.astro";

const benefitIcons = {
  heart: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M20.8 5.6a5.1 5.1 0 0 0-7.2 0L12 7.2l-1.6-1.6a5.1 5.1 0 0 0-7.2 7.2L12 21.5l8.8-8.7a5.1 5.1 0 0 0 0-7.2Z"></path>
  </svg>`,

  camera: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M7 7h2l1.3-2h3.4L15 7h2a3 3 0 0 1 3 3v7a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3v-7a3 3 0 0 1 3-3Z"></path>
    <circle cx="12" cy="13.5" r="3.2"></circle>
  </svg>`,

  film: `<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <rect x="4" y="4" width="16" height="16" rx="1.5"></rect>
    <path d="M8 4v16"></path>
    <path d="M16 4v16"></path>
    <path d="M4 8h4"></path>
    <path d="M4 12h4"></path>
    <path d="M4 16h4"></path>
    <path d="M16 8h4"></path>
    <path d="M16 12h4"></path>
    <path d="M16 16h4"></path>
  </svg>`,
};

const benefits = [
  {
    icon: "heart",
    title: "Eure Geschichte",
    text: "Nicht die perfekte Kopie, sondern ein authentischer Film, der eure einzigartige Verbindung feiert.",
  },
  {
    icon: "camera",
    title: "Entspannte Atmosphäre",
    text: "Ohne den Stress einer echten Hochzeit – ihr habt alle Zeit der Welt für die schönsten Aufnahmen.",
  },
  {
    icon: "film",
    title: "Cineastisches Ergebnis",
    text: "Ein professionell produzierter Film mit emotionaler Tiefe und künstlerischem Anspruch.",
  },
];

const steps = [
  {
    number: "1",
    title: "Beratungsgespräch & Konzept",
    text: "Wir besprechen eure Geschichte, eure Wünsche und entwickeln gemeinsam ein Konzept. Welche Location passt zu euch? Welche Momente sollen im Fokus stehen? Was ist euch wichtig?",
  },
  {
    number: "2",
    title: "Planung & Vorbereitung",
    text: "Ich kümmere mich um die technische Planung, während ihr euch um Outfits und Details kümmert. Gemeinsam legen wir den perfekten Zeitpunkt und Ablauf fest.",
  },
  {
    number: "3",
    title: "Der Drehtag",
    text: "In entspannter Atmosphäre entstehen authentische, cineastische Aufnahmen. Keine Hektik, kein Zeitdruck – nur ihr zwei und eure Geschichte.",
  },
  {
    number: "4",
    title: "Euer persönlicher Film",
    text: "Ich schneide und bearbeite das Material zu einem emotionalen Film, der eure Liebe feiert. Das Ergebnis: eine zeitlose Erinnerung an eure Verbindung.",
  },
];

const faqs = [
  {
    question: "Was ist ein nachträgliches Hochzeitsvideoshooting?",
    answer:
      "Ein nachträgliches Hochzeitsvideoshooting ist ein bewusst geplantes Shooting nach eurer Hochzeit. Dabei entstehen emotionale, cineastische Aufnahmen, aus denen ein persönlicher Hochzeitsfilm geschnitten wird.",
  },
  {
    question: "Was ist der 'Hochzeitsblues' und wie kann ein nachträgliches Shooting helfen?",
    answer:
      "Viele Paare merken nach der Hochzeit, wie schnell der Tag vergangen ist. Ein nachträgliches Shooting gibt euch die Möglichkeit, dieses Gefühl noch einmal bewusst zu erleben und in einem Film festzuhalten.",
  },
  {
    question: "Ist das Video eine 1:1-Kopie meiner Hochzeit?",
    answer:
      "Nein. Es geht nicht darum, eure Hochzeit exakt nachzustellen. Vielmehr entsteht ein künstlerischer Film, der eure Verbindung, eure Nähe und die wichtigsten Emotionen aufgreift.",
  },
  {
    question: "Wie läuft so ein nachträgliches Hochzeitsvideoshooting ab?",
    answer:
      "Nach einem Beratungsgespräch planen wir Location, Stimmung und Ablauf. Am Drehtag entstehen in entspannter Atmosphäre die Aufnahmen. Danach schneide ich daraus euren persönlichen Film.",
  },
  {
    question: "Was kostet ein nachträgliches Hochzeitsvideoshooting?",
    answer:
      "Der Preis hängt vom Umfang, der gewünschten Filmlänge und der Location ab. Ich erstelle euch nach einem kurzen Gespräch ein individuelles Angebot.",
  },
  {
    question: "Für wen eignet sich ein nachträgliches Hochzeitsvideoshooting?",
    answer:
      "Es eignet sich für Paare, die am Hochzeitstag keinen Videografen hatten, ihren Tag noch einmal bewusst erleben möchten oder sich einen emotionalen Film als Erinnerung wünschen.",
  },
];
---

<BaseLayout
  title="Nachträgliches Hochzeitsvideo | Hochzeitsvideograf Witten & NRW | VJ Production"
  description="Nachträgliches Hochzeitsvideoshooting von VJ Production: Für Paare, die nach der Hochzeit einen emotionalen Hochzeitsfilm erstellen möchten."
>
  <section class="late-page">
    <section class="late-hero">
      <div class="hero-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M20 7v5h-5"></path>
          <path d="M4 17v-5h5"></path>
          <path d="M18.1 9A7 7 0 0 0 6.2 6.8L4 9"></path>
          <path d="M5.9 15A7 7 0 0 0 17.8 17.2L20 15"></path>
        </svg>
      </div>

      <p class="kicker">Besonderes Angebot</p>
      <h1>Nachträgliches Hochzeitsvideoshooting</h1>
      <p class="hero-text">
        Ihr habt bereits geheiratet, aber ohne Videograf? Viele Paare erleben nach der Hochzeit
        einen Hochzeitsblues und merken, wie schnell der Tag vorbeigegangen ist. Ich erschaffe
        mit euch zusammen euren persönlichen Hochzeitsfilm – mit neu inszenierten, emotionalen
        Momenten an einer Location eurer Wahl.
      </p>
    </section>

    <section class="benefit-grid">
      {benefits.map((benefit) => (
        <article class="benefit-card">
          <div class="benefit-icon" set:html={benefitIcons[benefit.icon]}></div>
          <h2>{benefit.title}</h2>
          <p>{benefit.text}</p>
        </article>
      ))}
    </section>

    <section class="process-box">
      <h2>So läuft's ab</h2>

      <div class="process-list">
        {steps.map((step) => (
          <article class="process-item">
            <div class="process-number">{step.number}</div>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="important-box">
      <div class="important-title">
        <span>✓</span>
        <h2>Wichtig zu wissen</h2>
      </div>

      <p>
        Ein nachträgliches Hochzeitsvideoshooting ist keine 1:1-Kopie eurer Hochzeit,
        sondern ein bewusstes Nachstellen der Highlights eurer Geschichte. Es geht nicht darum,
        die Realität zu imitieren, sondern die Essenz eurer Verbindung künstlerisch einzufangen.
        Das Ergebnis ist ein authentischer „Re-Live“-Film, der eure Liebe auf cineastische Weise erzählt.
      </p>
    </section>

    <section class="faq-section">
      <h2>Häufige Fragen</h2>

      <div class="faq-list">
        {faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="cta">
      <div>
        <h2>Bereit für euren Film?</h2>
        <p>
          Lasst uns in einem unverbindlichen Gespräch herausfinden, wie ich euren Tag
          am besten festhalte.
        </p>
        <a href="/kontakt">Verfügbarkeit anfragen <span>→</span></a>
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  :global(body) {
    background: white;
  }

  .late-page {
    background: white;
    color: #17181d;
    padding: 150px 20px 120px;
  }

  .late-hero {
    width: min(1120px, 100%);
    margin: 0 auto 90px;
    text-align: center;
  }

  .hero-icon {
    width: 86px;
    height: 86px;
    margin: 0 auto 38px;
    border-radius: 20px;
    display: grid;
    place-items: center;
    background: #fbf0e8;
    color: #df7b00;
  }

  .hero-icon svg {
    width: 38px;
    height: 38px;
    display: block;
  }

  .hero-icon svg path {
    fill: none;
    stroke: #df7b00;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .kicker {
    margin: 0 0 28px;
    color: #df7b00;
    text-transform: uppercase;
    letter-spacing: 0.34em;
    font-size: 14px;
    font-weight: 700;
  }

  .late-hero h1 {
    max-width: 980px;
    margin: 0 auto;
    font-size: clamp(52px, 7vw, 96px);
    font-weight: 300;
    letter-spacing: -0.07em;
    line-height: 1.02;
  }

  .hero-text {
    max-width: 1080px;
    margin: 42px auto 0;
    color: #5f6068;
    font-size: clamp(22px, 2.4vw, 30px);
    line-height: 1.62;
  }

  .benefit-grid {
    width: min(1420px, 100%);
    margin: 0 auto 120px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 42px;
  }

  .benefit-card {
    min-height: 300px;
    padding: 44px 34px;
    border-radius: 18px;
    background: #f8f8f9;
    text-align: center;
    display: grid;
    align-content: center;
    justify-items: center;
  }

  .benefit-icon {
    width: 66px;
    height: 66px;
    margin-bottom: 28px;
    border-radius: 16px;
    display: grid;
    place-items: center;
    background: #fbf0e8;
    color: #df7b00;
  }

  :global(.benefit-icon svg) {
    width: 34px !important;
    height: 34px !important;
    display: block !important;
  }

  :global(.benefit-icon svg path),
  :global(.benefit-icon svg rect),
  :global(.benefit-icon svg circle) {
    fill: none !important;
    stroke: #df7b00 !important;
    stroke-width: 1.9 !important;
    stroke-linecap: round !important;
    stroke-linejoin: round !important;
  }

  .benefit-card h2 {
    margin: 0 0 22px;
    font-size: 24px;
    font-weight: 700;
  }

  .benefit-card p {
    max-width: 350px;
    margin: 0;
    color: #5f6068;
    font-size: 18px;
    line-height: 1.55;
  }

  .process-box {
    width: min(1360px, 100%);
    margin: 0 auto 115px;
    padding: 70px 110px;
    border-radius: 24px;
    background: #fff9e8;
  }

  .process-box > h2 {
    margin: 0 0 70px;
    text-align: center;
    font-size: clamp(38px, 4.4vw, 58px);
    font-weight: 300;
    letter-spacing: -0.055em;
  }

  .process-list {
    display: grid;
    gap: 54px;
  }

  .process-item {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 42px;
    align-items: start;
  }

  .process-number {
    width: 64px;
    height: 64px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    background: #df7b00;
    color: white;
    font-size: 26px;
    font-weight: 500;
  }

  .process-item h3 {
    margin: 0 0 16px;
    font-size: 24px;
    font-weight: 700;
  }

  .process-item p {
    margin: 0;
    color: #5f6068;
    font-size: 22px;
    line-height: 1.58;
  }

  .important-box {
    width: min(1420px, 100%);
    margin: 0 auto 110px;
    padding: 44px 50px;
    border-radius: 8px;
    border-left: 6px solid #df7b00;
    border-right: 1px solid #f0d4b3;
    background: #f8f8f9;
  }

  .important-title {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 22px;
  }

  .important-title span {
    color: #df7b00;
    font-size: 28px;
  }

  .important-title h2 {
    margin: 0;
    font-size: 24px;
  }

  .important-box p {
    margin: 0;
    color: #5f6068;
    font-size: 22px;
    line-height: 1.6;
  }

  .faq-section {
    width: min(1040px, 100%);
    margin: 0 auto 105px;
  }

  .faq-section > h2 {
    margin: 0 0 50px;
    text-align: center;
    font-size: clamp(38px, 4vw, 54px);
    font-weight: 300;
    letter-spacing: -0.055em;
  }

  .faq-list {
    display: grid;
    gap: 22px;
  }

  details {
    border: 1px solid #dedfe3;
    border-radius: 16px;
    background: white;
    overflow: hidden;
  }

  summary {
    cursor: pointer;
    list-style: none;
    padding: 30px 34px;
    font-size: 22px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
  }

  summary::after {
    content: "⌄";
    color: #9a9ba3;
    font-size: 26px;
  }

  details[open] summary::after {
    transform: rotate(180deg);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  details p {
    margin: 0;
    padding: 0 34px 32px;
    color: #5f6068;
    font-size: 19px;
    line-height: 1.7;
  }

  .cta {
    width: min(1440px, 100%);
    margin: 0 auto;
  }

  .cta > div {
    padding: 78px 30px;
    border-radius: 28px;
    background: #17181d;
    color: white;
    text-align: center;
  }

  .cta h2 {
    margin: 0;
    font-size: clamp(36px, 4vw, 54px);
    font-weight: 300;
    letter-spacing: -0.045em;
  }

  .cta p {
    max-width: 760px;
    margin: 28px auto 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: 22px;
    line-height: 1.62;
  }

  .cta a {
    margin-top: 42px;
    display: inline-flex;
    height: 58px;
    padding: 0 42px;
    border-radius: 7px;
    background: #df7b00;
    color: white;
    align-items: center;
    gap: 18px;
    font-size: 18px;
    font-weight: 800;
  }

  @media (max-width: 950px) {
    .benefit-grid {
      grid-template-columns: 1fr;
    }

    .process-box {
      padding: 46px 28px;
    }

    .process-item {
      grid-template-columns: 1fr;
      gap: 18px;
    }
  }

  @media (max-width: 620px) {
    .late-page {
      padding: 130px 14px 80px;
    }

    .hero-icon {
      width: 72px;
      height: 72px;
    }

    .hero-icon svg {
      width: 34px;
      height: 34px;
    }

    .hero-text,
    .process-item p,
    .important-box p,
    .cta p {
      font-size: 18px;
    }

    .important-box {
      padding: 30px 24px;
    }

    summary {
      padding: 24px;
      font-size: 18px;
    }
  }
