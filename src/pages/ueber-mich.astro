    color: #5f6068;
    font-size: 16px;
    line-height: 1.7;
  }

  .photo-partner-link {
    display: inline-flex;
    min-height: 46px;
    padding: 0 22px;
    border-radius: 7px;
    border: 1px solid #d9d9dd;
    background: white;
    align-items: center;
