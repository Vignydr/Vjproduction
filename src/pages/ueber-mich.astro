    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.07);
  }

  .photo-partner-link span {
    color: #df7b00;
    transition: transform 180ms ease;
  }

  .photo-partner-link:hover span {
    transform: translateX(3px);
  }

  .photo-video-hint {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 80;
    width: min(340px, calc(100vw - 48px));
    overflow: hidden;
    border: 1px solid rgba(23, 24, 29, 0.12);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.97);
    box-shadow: 0 18px 46px rgba(23, 24, 29, 0.16);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);

    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(18px);

    transition:
      opacity 220ms ease,
      transform 220ms ease,
      visibility 220ms ease;
  }

  .photo-video-hint.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .photo-video-hint::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: #df7b00;
  }

  .photo-video-hint-close {
    position: absolute;
    top: 9px;
    right: 10px;
    z-index: 2;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: #898a91;
    display: grid;
    place-items: center;
    font: inherit;
    font-size: 22px;
    font-weight: 300;
    line-height: 1;
    cursor: pointer;
    transition:
      color 160ms ease,
      background 160ms ease;
  }

  .photo-video-hint-close:hover {
    background: #f0f0f1;
    color: #17181d;
  }

  .photo-video-hint-link {
    min-height: 124px;
    padding: 20px 48px 20px 24px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    color: #17181d;
    text-decoration: none;
  }

  .photo-video-hint-kicker {
    margin-bottom: 6px;
    color: #df7b00;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 10px;
    font-weight: 800;
    line-height: 1.4;
  }

  .photo-video-hint-link strong {
    padding-right: 6px;
    color: #17181d;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.35;
  }

  .photo-video-hint-more {
    margin-top: 10px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #df7b00;
    font-size: 12px;
    font-weight: 800;
    line-height: 1.3;
  }

  .photo-video-hint-more span {
    transition: transform 180ms ease;
  }

  .photo-video-hint-link:hover .photo-video-hint-more span {
    transform: translateX(3px);
  }

  .cta {
    width: min(1180px, 100%);
    margin: 0 auto;
  }

  .cta > div {
    padding: 62px 28px;
    border-radius: 28px;
    background: #17181d;
    color: white;
    text-align: center;
  }

  .cta h2 {
    margin: 0;
    font-size: clamp(32px, 3.5vw, 44px);
    font-weight: 300;
    letter-spacing: -0.045em;
  }

  .cta p {
    max-width: 740px;
    margin: 26px auto 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: 17px;
    line-height: 1.6;
  }

  .cta a {
    margin-top: 40px;
    display: inline-flex;
    height: 50px;
    padding: 0 38px;
    border-radius: 7px;
    background: #df7b00;
    color: white;
    align-items: center;
    gap: 18px;
    font-size: 15px;
    font-weight: 800;
    text-decoration: none;
  }

