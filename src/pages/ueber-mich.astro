    }

    .photo-partner-card {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .photo-partner-link {
      width: fit-content;
    }
  }

  @media (max-width: 620px) {
    .about-page {
      padding: 112px 14px 80px;
    }

    .about-hero {
      margin-bottom: 42px;
      gap: 34px;
    }

    .about-content {
      gap: 46px;
      margin-bottom: 72px;
    }

    .story h2,
    .why h2 {
      margin-bottom: 28px;
    }

    .story p {
