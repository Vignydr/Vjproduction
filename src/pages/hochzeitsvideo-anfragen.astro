
---
import BaseLayout from "../layouts/BaseLayout.astro";

// Hochzeitsfilm von Phelina & Mert
const weddingTeaser =
  "https://galleries.vidflow.co/videos/b6w58mek";

// Aktuelle Paketpreise
const packages = [
  {
    name: "Basic",
    price: "1.290 €",
    duration: "4 Stunden Begleitung",
    description:
      "Für Paare, die ihre wichtigsten Momente als Film bewahren möchten.",
  },
  {
    name: "Classic",
    price: "1.990 €",
    duration: "7 Stunden Begleitung",
    description:
      "Mehr Raum für eure Geschichte – inklusive Kurzfilm für Social Media.",
    featured: true,
  },
  {
    name: "Premium",
    price: "2.390 €",
    duration: "Bis zu 12 Stunden Begleitung",
    description:
      "Für die ausführliche Begleitung eures Tages – inklusive Drohnenaufnahmen.",
  },
];
---

<BaseLayout
  title="Euren Hochzeitsfilm anfragen | VJ Production – Hochzeitsvideograf NRW"
  description="Euer Hochzeitstag als cineastischer Film: Entdeckt den Hochzeitsfilm von Phelina & Mert, die Pakete ab 1.290 € und fragt euren Termin bei VJ Production unverbindlich an."
>
  <section
    class="vj-landing"
    aria-labelledby="vj-landing-title"
  >
    <!-- EINSTIEG -->
    <header class="landing-hero wrap">
      <p class="eyebrow">
        VJ Production · Hochzeitsvideografie in NRW
      </p>

      <h1 id="vj-landing-title">
        Euer Tag vergeht.<br />
        <em>Das Gefühl bleibt.</em>
      </h1>

      <p class="hero-description">
        Die leisen Blicke, das Lachen, die Stimmen eurer
        Liebsten – all die Momente, die euren Hochzeitstag
        einzigartig machen. Ich halte sie in einem
        persönlichen, cineastischen Hochzeitsfilm fest.
      </p>

      <div class="hero-actions">
        <a
          class="button button-primary"
          href="#anfrage"
        >
          Wunschtermin anfragen
          <span aria-hidden="true">→</span>
        </a>

        <a
          class="button button-secondary"
          href="#film"
        >
          Hochzeitsfilm ansehen
          <span aria-hidden="true">↘</span>
        </a>
      </div>

      <p class="hero-note">
        Persönliche Begleitung aus Witten ·
        NRW & deutschlandweit ·
        Ab 1.290 € zzgl. ggf. Reisekosten
      </p>
    </header>

    <!-- HOCHZEITSFILM -->
    <section
      class="film-section wrap"
      id="film"
      aria-labelledby="film-title"
    >
      <div class="section-heading section-heading-left">
        <div>
          <p class="eyebrow">
            Ein Film. Eine echte Geschichte.
          </p>

          <h2 id="film-title">
            Phelina <span>&</span> Mert
          </h2>
        </div>

        <p>
          So erzähle ich Hochzeiten: nicht als Aneinanderreihung
          schöner Bilder, sondern als Geschichte voller Gefühl.
        </p>
      </div>

      <div class="film-frame">
        <iframe
          src={weddingTeaser}
          title="Hochzeitsfilm von Phelina und Mert – VJ Production"
          loading="eager"
          scrolling="no"
          allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
          allowfullscreen
        ></iframe>
      </div>

      <div class="film-bottom">
        <div>
          <strong>
            Hochzeitsfilm · Phelina & Mert
          </strong>

          <span>
            Ein Einblick in meine Bildsprache
            und meinen Filmschnitt.
          </span>
        </div>

        <a
          class="subtle-link"
          href="/portfolio"
        >
          Weitere Hochzeitsfilme
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="film-cta">
        <p>
          Ihr könnt euch vorstellen, euren Tag
          so festhalten zu lassen?
        </p>

        <a
          class="button button-primary"
          href="#anfrage"
        >
          Verfügbarkeit prüfen
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- PERSÖNLICHE VORSTELLUNG -->
    <section
      class="about-section wrap"
      aria-labelledby="about-title"
    >
      <div class="about-image">
        <img
          src="/images/Vigny.png"
          alt="Vigny, Hochzeitsvideograf von VJ Production"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="about-copy">
        <p class="eyebrow">
          Der Mensch hinter der Kamera
        </p>

        <h2 id="about-title">
          Hallo, ich bin Vigny.
        </h2>

        <p>
          Ich glaube, dass die schönsten Momente entstehen,
          wenn ihr euren Tag einfach genießen könnt.
          Deshalb begleite ich euch ruhig und unaufdringlich –
          und bin da, wenn aus einem Augenblick
          eine Erinnerung wird.
        </p>

        <p>
          Jeder Film entsteht individuell. Musik, Schnitt
          und Bildsprache richte ich nach euch und der
          Atmosphäre eurer Hochzeit aus.
          Kein Film von der Stange.
        </p>

        <a
          class="subtle-link subtle-link-light"
          href="/ueber-mich"
        >
          Mehr über mich erfahren
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <!-- PAKETE -->
    <section
      class="packages-section"
      aria-labelledby="packages-title"
    >
      <div class="wrap">
        <div class="section-heading">
          <p class="eyebrow">
            Transparent von Anfang an
          </p>

          <h2 id="packages-title">
            Der passende Rahmen für eure Geschichte.
          </h2>

          <p>
            Ihr sollt schon vor eurer Anfrage wissen,
            womit ihr planen könnt. Gemeinsam finden wir
            die Begleitung, die zu eurem Tag passt.
          </p>
        </div>

        <div class="packages-grid">
          {packages.map((item) => (
            <article
              class:list={[
                "package-card",
                { "is-featured": item.featured },
              ]}
            >
              {item.featured && (
                <span class="package-label">
                  Häufig gewählt
                </span>
              )}

              <h3>{item.name}</h3>

              <p class="package-duration">
                {item.duration}
              </p>

              <p class="package-price">
                {item.price}
              </p>

              <p class="package-description">
                {item.description}
              </p>

              <a
                href="#anfrage"
                class="package-action"
                data-select-package={item.name}
              >
                Paket anfragen
                <span aria-hidden="true">→</span>
              </a>
            </article>
          ))}
        </div>

        <!-- INDIVIDUELLES ANGEBOT -->
        <div
          class="individual-offer"
          aria-labelledby="individual-offer-title"
        >
          <div class="individual-offer-copy">
            <p class="eyebrow">
              Auf euch zugeschnitten
            </p>

            <h3 id="individual-offer-title">
              Ihr habt andere Vorstellungen?
            </h3>

            <p>
              Nicht jede Hochzeit passt in ein festes Paket.
              Ob eine andere Begleitungsdauer, besondere
              Filmwünsche oder zusätzliche Leistungen:
              Gerne erstelle ich euch ein individuelles
              Angebot, das zu euch und eurem Hochzeitstag passt.
            </p>
          </div>

          <a
            href="#anfrage"
            class="button button-primary individual-offer-button"
            data-select-package="Individuell / noch unsicher"
          >
            Individuelles Angebot anfragen
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <p class="price-note">
          Preise gemäß § 19 UStG ohne Umsatzsteuerausweis.
          Gegebenenfalls fallen zusätzliche Reisekosten an.
          Individuelle Angebote sind auf Anfrage möglich.
        </p>

        <a
          class="subtle-link packages-link"
          href="/pakete"
        >
          Alle Leistungen und Paketdetails ansehen
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <!-- KUNDENBEWERTUNG -->
    <section
      class="review-section wrap"
      aria-labelledby="review-title"
    >
      <div class="review-head">
        <p class="eyebrow">
          Worte, die bleiben
        </p>

        <h2 id="review-title">
          Wenn der Film mehr zurückbringt als Bilder.
        </h2>
      </div>

      <div class="review-content">
        <img
          src="/images/Phelina & Mert .jpg"
          alt="Phelina und Mert an ihrem Hochzeitstag"
          loading="lazy"
          decoding="async"
        />

        <div>
          <p
            class="review-stars"
            aria-label="5 von 5 Sternen"
          >
            ★★★★★
          </p>

          <blockquote>
            „Wir sind unendlich dankbar, dass Vigny
            unseren großen Tag so wunderschön und
            emotional festgehalten hat! Die Videos
            sind einfach traumhaft geworden und wir
            könnten nicht glücklicher damit sein.“
          </blockquote>

          <p class="review-name">
            Phelina & Mert
            <span>· Dortmund</span>
          </p>

          <a
            class="subtle-link"
            href="/bewertungen"
          >
            Weitere Erfahrungen lesen
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ANFRAGEFORMULAR -->
    <section
      class="request-section"
      id="anfrage"
      aria-labelledby="request-title"
    >
      <div class="wrap request-layout">

        <div class="request-intro">
          <p class="eyebrow">
            Eure Geschichte beginnt hier
          </p>

          <h2 id="request-title">
            Erzählt mir von eurem Tag.
          </h2>

          <p>
            Ob euer Ablauf schon feststeht oder ihr
            noch mitten in der Planung steckt:
            Schreibt mir ein paar Eckdaten.
            Ich prüfe euren Wunschtermin und melde
            mich persönlich bei euch zurück.
          </p>

          <div class="request-points">
            <span>
              <i aria-hidden="true">✓</i>
              Unverbindliche Anfrage
            </span>

            <span>
              <i aria-hidden="true">✓</i>
              Persönliche Rückmeldung
            </span>

            <span>
              <i aria-hidden="true">✓</i>
              Transparente Pakete & Preise
            </span>
          </div>

          <p class="request-alternative">
            Ihr möchtet euch erst umsehen?
            <a href="/portfolio">Portfolio</a>,
            <a href="/pakete">Pakete</a> oder
            <a href="/">Startseite</a> entdecken.
          </p>
        </div>

        <form
          class="request-form"
          id="vjLandingForm"
          action="https://api.web3forms.com/submit"
          method="POST"
        >
          <!-- WEB3FORMS -->
          <input
            type="hidden"
            name="access_key"
            value="d7e13ef0-2a0f-4bba-bf3b-386b61afe972"
          />

          <input
            type="hidden"
            name="subject"
            value="Neue Hochzeitsanfrage über VJ Production Landingpage"
          />

          <input
            type="hidden"
            name="from_name"
            value="VJ Production Website"
          />

          <input
            type="hidden"
            name="redirect"
            value="https://vjproduction.de/danke"
          />

          <input
            type="hidden"
            name="Quelle"
            value="Landingpage Hochzeitsvideo anfragen"
          />

          <input
            type="hidden"
            name="Kampagne"
            id="vjCampaign"
            value=""
          />

          <!-- SPAMSCHUTZ -->
          <div
            class="honeypot"
            aria-hidden="true"
          >
            <label>
              Dieses Feld bitte leer lassen
              <input
                type="checkbox"
                name="botcheck"
                tabindex="-1"
                autocomplete="off"
              />
            </label>
          </div>

          <!-- NAME UND EMAIL -->
          <div class="field-row">
            <label class="field">
              <span>
                Euer Name <em>*</em>
              </span>

              <input
                type="text"
                name="Name"
                placeholder="z. B. Anna & Max"
                autocomplete="name"
                required
              />
            </label>

            <label class="field">
              <span>
                E-Mail-Adresse <em>*</em>
              </span>

              <input
                type="email"
                name="email"
                placeholder="eure@email.de"
                autocomplete="email"
                required
              />
            </label>
          </div>

          <!-- DATUM UND ORT -->
          <div class="field-row">
            <label class="field">
              <span>Hochzeitsdatum</span>

              <input
                type="date"
                name="Datum"
              />
            </label>

            <label class="field">
              <span>Hochzeitsort</span>

              <input
                type="text"
                name="Location"
                placeholder="Stadt / Location, falls bekannt"
              />
            </label>
          </div>

          <!-- PAKET UND BUDGET -->
          <div class="field-row">
            <label class="field">
              <span>
                Welches Paket interessiert euch?
                <em>*</em>
              </span>

              <select
                name="Paket"
                id="vjPackageSelect"
                required
              >
                <option
                  value=""
                  disabled
                  selected
                >
                  Bitte auswählen
                </option>

                <option value="Basic">
                  Basic · 1.290 €
                </option>

                <option value="Classic">
                  Classic · 1.990 €
                </option>

                <option value="Premium">
                  Premium · 2.390 €
                </option>

                <option value="Individuell / noch unsicher">
                  Individuell / noch unsicher
                </option>
              </select>
            </label>

            <label class="field">
              <span>
                Euer Investitionsrahmen <em>*</em>
              </span>

              <select
                name="Investitionsrahmen"
                required
              >
                <option
                  value=""
                  disabled
                  selected
                >
                  Bitte auswählen
                </option>

                <option value="1.290–1.989 €">
                  1.290–1.989 €
                </option>

                <option value="1.990–2.389 €">
                  1.990–2.389 €
                </option>

                <option value="2.390–3.499 €">
                  2.390–3.499 €
                </option>

                <option value="3.500 € oder mehr">
                  3.500 € oder mehr
                </option>
              </select>
            </label>
          </div>

          <!-- TELEFON -->
          <label class="field">
            <span>
              Telefonnummer
              <small>(optional)</small>
            </span>

            <input
              type="tel"
              name="Telefon"
              placeholder="Für ein persönliches Kennenlerngespräch"
              autocomplete="tel"
            />
          </label>

          <!-- NACHRICHT -->
          <label class="field">
            <span>
              Was sollte ich über euren Tag wissen?
            </span>

            <textarea
              name="Nachricht"
              rows="4"
              placeholder="Erzählt mir gerne von euren Plänen, eurer Location oder euren Wünschen ..."
            ></textarea>
          </label>

          <!-- DATENSCHUTZ -->
          <label class="consent-row">
            <input
              type="checkbox"
              name="Datenschutz akzeptiert"
              value="Ja"
              required
            />

            <span>
              Ich habe die
              <a
                href="/datenschutz"
                target="_blank"
                rel="noopener noreferrer"
              >
                Datenschutzerklärung
              </a>
              gelesen und bin mit der Verarbeitung meiner
              Angaben zur Beantwortung meiner Anfrage
              einverstanden. <em>*</em>
            </span>
          </label>

          <p class="required-note">
            * Pflichtfelder ·
            Unverbindlich und ohne Buchungsverpflichtung
          </p>

          <button
            type="submit"
            class="button button-primary submit-button"
            id="vjSubmitButton"
          >
            Wunschtermin unverbindlich anfragen
            <span aria-hidden="true">→</span>
          </button>

          <p
            id="vjFormMessage"
            class="form-message"
            role="status"
            aria-live="polite"
          ></p>
        </form>
      </div>
    </section>

    <!-- WEITERE SEITEN ENTDECKEN -->
    <nav
      class="explore-section wrap"
      aria-label="Weitere Bereiche der Website"
    >
      <p>
        Ihr möchtet VJ Production noch besser kennenlernen?
      </p>

      <div>
        <a href="/portfolio">
          Alle Filme
          <span aria-hidden="true">↗</span>
        </a>

        <a href="/pakete">
          Pakete & Preise
          <span aria-hidden="true">↗</span>
        </a>

        <a href="/ueber-mich">
          Über mich
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </nav>
  </section>

  <!-- FORMULAR UND META-LEAD-TRACKING -->
  <script is:inline>
    (() => {
      const form = document.getElementById("vjLandingForm");
      const button = document.getElementById("vjSubmitButton");
      const message = document.getElementById("vjFormMessage");
      const campaign = document.getElementById("vjCampaign");
      const packageSelect = document.getElementById(
        "vjPackageSelect"
      );

      if (!(form instanceof HTMLFormElement)) return;

      // UTM-Parameter für die Werbeauswertung
      const params = new URLSearchParams(
        window.location.search
      );

      if (campaign instanceof HTMLInputElement) {
        const keys = [
          "utm_source",
          "utm_medium",
          "utm_campaign",
          "utm_content",
        ];

        campaign.value = keys
          .filter((key) => params.has(key))
          .map(
            (key) =>
              `${key}: ${params.get(key)}`
          )
          .join(" | ");
      }

      // Paket bei Klick automatisch auswählen
      document
        .querySelectorAll("[data-select-package]")
        .forEach((link) => {
          link.addEventListener("click", () => {
            if (
              !(packageSelect instanceof HTMLSelectElement)
            ) {
              return;
            }

            const selected = link.getAttribute(
              "data-select-package"
            );

            if (selected) {
              packageSelect.value = selected;

              packageSelect.dispatchEvent(
                new Event("change", {
                  bubbles: true,
                })
              );
            }
          });
        });

      // Formular nur einmal absenden
      let submitting = false;

      form.addEventListener(
        "submit",
        async (event) => {
          event.preventDefault();

          if (submitting) return;
          if (!form.reportValidity()) return;

          submitting = true;

          if (
            button instanceof HTMLButtonElement
          ) {
            button.disabled = true;
            button.setAttribute(
              "aria-busy",
              "true"
            );
          }

          if (message) {
            message.textContent =
              "Eure Anfrage wird gesendet ...";
          }

          try {
            const response = await fetch(
              form.action,
              {
                method: "POST",
                body: new FormData(form),
                headers: {
                  Accept: "application/json",
                },
              }
            );

            const result = await response.json();

            if (
              !response.ok ||
              result.success !== true
            ) {
              throw new Error(
                "Die Anfrage konnte nicht gesendet werden."
              );
            }

            // Markierung erst NACH erfolgreichem Versand.
            // BaseLayout.astro löst auf /danke
            // das Meta-Lead-Event aus.
            try {
              sessionStorage.setItem(
                "vjContactFormSubmittedAt",
                String(Date.now())
              );
            } catch (error) {
              console.warn(
                "Tracking-Markierung konnte nicht gespeichert werden.",
                error
              );
            }

            window.location.assign("/danke");
          } catch (error) {
            submitting = false;

            if (message) {
              message.textContent =
                "Das Senden hat leider nicht geklappt. Bitte versucht es erneut oder nutzt die Kontaktseite.";
            }

            if (
              button instanceof HTMLButtonElement
            ) {
              button.disabled = false;
              button.removeAttribute(
                "aria-busy"
              );
            }
          }
        }
      );
    })();
  </script>
</BaseLayout>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  .vj-landing {
    --ink: #17181d;
    --accent: #b46300;
    --accent-dark: #995200;
    --muted: #62656e;
    --line: #e8e5e1;

    color: var(--ink);
    background: #fff;
    overflow-x: clip;
  }

  .vj-landing *,
  .vj-landing *::before,
  .vj-landing *::after {
    box-sizing: border-box;
  }

  .vj-landing a {
    text-decoration: none;
  }

  .vj-landing a:focus-visible,
  .vj-landing button:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  .wrap {
    width: min(1120px, calc(100% - 48px));
    margin-inline: auto;
  }

  .eyebrow {
    margin: 0 0 18px;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 800;
    line-height: 1.5;
    color: var(--accent);
  }

  .button {
    display: inline-flex;
    min-height: 52px;
    padding: 13px 22px;
    align-items: center;
    justify-content: center;
    gap: 16px;
    border-radius: 7px;
    border: 1px solid transparent;
    font-size: 14px;
    font-weight: 750;
    text-align: center;
    line-height: 1.35;
    transition:
      background 0.2s,
      transform 0.2s,
      border-color 0.2s;
    cursor: pointer;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: var(--accent);
    color: #fff;
  }

  .button-primary:hover {
    background: var(--accent-dark);
  }

  .button-secondary {
    background: transparent;
    color: var(--ink);
    border-color: #d7d4d0;
  }

  .button-secondary:hover {
    border-color: var(--accent);
  }

  .subtle-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--accent);
    font-size: 14px;
    font-weight: 750;
    line-height: 1.5;
  }

  .subtle-link:hover {
    text-decoration: underline;
  }

  /* HERO */
  .landing-hero {
    padding: 132px 0 67px;
    text-align: center;
  }

  .landing-hero h1 {
    max-width: 860px;
    margin: 0 auto;
    font-size: clamp(46px, 6.2vw, 82px);
    font-weight: 300;
    line-height: 1.04;
    letter-spacing: -0.065em;
    text-wrap: balance;
  }

  .landing-hero h1 em {
    font-style: normal;
    font-weight: 500;
  }

  .hero-description {
    max-width: 700px;
    margin: 24px auto 0;
    color: var(--muted);
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.75;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 29px;
  }

  .hero-note {
    margin: 24px auto 0;
    color: #7c7d83;
    font-size: 12px;
    line-height: 1.65;
  }

  /* FILM */
  .film-section {
    padding-bottom: 102px;
    scroll-margin-top: 100px;
  }

  .section-heading {
    max-width: 790px;
    margin: 0 auto 37px;
    text-align: center;
