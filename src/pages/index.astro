    text: "Vigny, wir möchten uns von Herzen bei dir bedanken, dass du unsere Hochzeit vom Anfang bis zum Ende begleitet hast. Deine ruhige, professionelle und sympathische Art hat uns sofort ein gutes Gefühl gegeben.",
  },
  {
    name: "Thahn & Pascal",
    place: "Heinsberg-Dremmen",
    image: "",
    text: "Auf Vigny sind wir durch eine Instagram-Werbung aufmerksam geworden. Besonders die Übersicht, die transparente Preisgestaltung und seine Arbeiten haben bei uns einen positiven ersten Eindruck hinterlassen.",
  },
];

const extras = [
  {
    name: "Drohnenaufnahmen",
    price: "350 €",
    text: "Luftaufnahmen für eine zusätzliche Perspektive.",
  },
  {
    name: "Extra Reel",
    price: "190 €",
    text: "Ein zusätzliches Social-Media-Reel.",
  },
  {
    name: "Expresslieferung",
    price: "260 €",
    text: "Schnellere Bearbeitung und Lieferung.",
  },
];
---

<BaseLayout
  title="Hochzeitsvideograf Witten & NRW | VJ Production"
  description="VJ Production – Hochzeitsvideograf aus Witten für NRW und deutschlandweit. Persönliche Hochzeitsfilme, transparente Pakete und echte Kundenstimmen entdecken."
>
  <div class="home-page">

    <!-- STARTSEITENVIDEO -->
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-media" aria-hidden="true">
        <video
          id="heroVideo"
          class="hero-video"
          autoplay
          muted
          loop
          playsinline
          webkit-playsinline="true"
          preload="auto"
          poster="/images/hero-poster.jpg"
        >
          <source src="/videos/Stef%20und%20Jana.mp4" type="video/mp4" />
        </video>
      </div>

      <div class="hero-overlay" aria-hidden="true"></div>

      <div class="hero-content">
        <p class="hero-kicker">
          Hochzeitsvideograf aus Witten · NRW &amp; deutschlandweit
        </p>

        <h1 id="hero-title">
          Euer Tag.<br />
          <em>Für immer fühlbar.</em>
        </h1>

        <p class="hero-subtitle">
          Persönliche Hochzeitsfilme, die nicht nur zeigen,
          wie euer Tag aussah, sondern wie er sich angefühlt hat.
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="/portfolio">
            Meine Filme ansehen <span aria-hidden="true">→</span>
          </a>

          <a class="button button-outline" href="/kontakt">
            Verfügbarkeit anfragen <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <a class="scroll-cue" href="#hochzeitsfilm" aria-label="Zum Hochzeitsfilm scrollen">
        <span></span>
      </a>
    </section>

    <div class="value-strip" aria-label="Vorteile von VJ Production">
      <span>Persönliche Begleitung</span>
      <span>Individuell geschnittene Filme</span>
      <span>Private Online-Galerie</span>
    </div>

    <!-- AUSGEWÄHLTER FILM -->
    <section
      class="featured-story section-wrap"
      id="hochzeitsfilm"
      aria-labelledby="film-title"
    >
      <div class="section-heading">
        <p class="eyebrow">Ein Einblick in meine Arbeit</p>
        <h2 id="film-title">
          Nicht nur Erinnerungen.<br />
          Ein Gefühl, das bleibt.
        </h2>
        <p>
          Schaut selbst, wie sich ein Hochzeitstag
          in bewegten Bildern erzählen lässt.
        </p>
      </div>

      <div class="featured-frame">
        <iframe
          src={featuredFilm.src}
          title={`${featuredFilm.type} – ${featuredFilm.couple}`}
          loading="lazy"
          scrolling="no"
          allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
          allowfullscreen
        ></iframe>
      </div>

      <div class="film-footer">
        <div>
          <p class="eyebrow">{featuredFilm.type}</p>
          <h3>{featuredFilm.couple}</h3>
        </div>
        <a class="text-link" href="/portfolio">
          Alle Hochzeitsfilme ansehen <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- ÜBER MICH -->
    <section class="about-section section-wrap" aria-labelledby="about-title">
      <div class="about-photo">
        <img
          src="/images/Vigny.png"
          alt="Vigny, Hochzeitsvideograf und Gründer von VJ Production"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="about-copy">
        <p class="eyebrow">Der Mensch hinter der Kamera</p>
        <h2 id="about-title">Hallo, ich bin Vigny.</h2>

        <p>
          Ich begleite Hochzeiten ruhig und unaufdringlich,
          damit ihr euren Tag genießen könnt.
          Die schönsten Szenen entstehen oft dann,
          wenn niemand an die Kamera denkt.
        </p>

        <p>
          Kein Film von der Stange: Bildsprache, Musik
          und Schnitt passe ich an euch und die Atmosphäre
          eures Tages an – persönlich, natürlich und mit Gefühl.
        </p>

        <a class="text-link text-link-light" href="/ueber-mich">
          Mehr über mich <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- REGIONALE SICHTBARKEIT -->
    <section class="location-section section-wrap" aria-labelledby="location-title">
      <p class="eyebrow">In NRW zu Hause · Deutschlandweit unterwegs</p>
      <h2 id="location-title">
        Hochzeitsvideograf in Witten und Nordrhein-Westfalen
      </h2>
      <p>
        Von Witten aus begleite ich Hochzeiten in Dortmund,
        Bochum, Essen, Hagen und ganz NRW – auf Wunsch auch
        deutschlandweit. Ob standesamtliche Trauung oder große
        Hochzeitsfeier: Im Mittelpunkt stehen eure Geschichte
        und die echten Momente des Tages.
      </p>
    </section>

    <!-- KUNDENBEWERTUNGEN -->
    <section class="reviews-section" aria-labelledby="reviews-title">
      <div class="section-wrap">
        <div class="section-heading">
          <p class="eyebrow">Erfahrungen</p>
          <h2 id="reviews-title">Worte, die mehr sagen.</h2>
          <p>
            Was Paare über die gemeinsame Zeit
            und ihre Filme erzählen.
          </p>
        </div>

        <div class="reviews-grid">
          {selectedReviews.map((review) => (
            <article class="review-card">
              <div class="review-stars" aria-label="5 von 5 Sternen">
                ★★★★★
              </div>

              <blockquote>„{review.text}“</blockquote>

              <div class="review-person">
                {review.image ? (
                  <img
                    src={review.image}
                    alt={`Foto von ${review.name}`}
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="review-initials" aria-hidden="true">
                    T &amp; P
                  </span>
                )}
                <div>
                  <strong>{review.name}</strong>
                  <span>{review.place}</span>
                </div>
              </div>
            </article>
          ))}
        </div>

        <a class="text-link reviews-link" href="/bewertungen">
          Alle Kundenbewertungen lesen <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- ABLAUF -->
    <section class="process-section section-wrap" aria-labelledby="process-title">
      <div class="section-heading">
        <p class="eyebrow">Von der Anfrage bis zum fertigen Film</p>
        <h2 id="process-title">
          Ganz entspannt zu eurem Hochzeitsfilm.
        </h2>
        <p>
          Damit ihr wisst, was euch erwartet –
          und euren Tag genießen könnt.
        </p>
      </div>

      <div class="process-grid">
        {processSteps.map((step) => (
          <article class="process-step">
            <span class="step-number">{step.number}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- PAKETE -->
    <section class="packages-section" id="pakete" aria-labelledby="packages-title">
      <div class="section-wrap">
        <div class="section-heading">
          <p class="eyebrow">Pakete &amp; Preise</p>
          <h2 id="packages-title">
            So individuell wie eure Hochzeit.
          </h2>
          <p>
            Klare Leistungen und transparente Preise –
            ohne Rätselraten.
          </p>
        </div>

        <div class="packages-grid">
          {packages.map((item) => (
            <article class:list={["package-card", { "is-popular": item.popular }]}>
              {item.popular && (
                <span class="popular-label">Häufig gewählt</span>
              )}

              <p class="package-name">{item.name}</p>
              <p class="package-price">{item.price} <span>€</span></p>
              <p class="package-hours">{item.hours}</p>

              <ul>
                {item.features.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>

              <div class="package-extra">
                <span>Zweiter Videograf optional · ab 350 €</span>
                <a href={`/pakete#${item.secondVideographerTarget}`}>
                  Details ansehen →
                </a>
              </div>

              <a class="package-button" href="/kontakt">
                Paket anfragen <span aria-hidden="true">→</span>
              </a>
            </article>
          ))}
        </div>

        <div class="individual-package">
          <div>
            <p class="eyebrow">Individuell</p>
            <h3>Ihr habt andere Vorstellungen?</h3>
            <p>
              Begleitungsdauer, Filmlänge und Zusatzleistungen
              stimmen wir auf eure Wünsche ab.
              Preis auf Anfrage. Ein zweiter Videograf
              ist ab 350 € möglich.
            </p>
          </div>

          <div class="individual-actions">
            <a class="text-link" href="/pakete#zweiter-videograf-individuell">
              Optionen ansehen →
            </a>
            <a class="button button-primary" href="/kontakt">
              Individuell anfragen →
            </a>
          </div>
        </div>

        <a class="text-link packages-details" href="/pakete">
          Alle Paketdetails ansehen <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- ZUSATZLEISTUNGEN -->
    <section class="services-section section-wrap" aria-labelledby="services-title">
      <div class="section-heading">
        <p class="eyebrow">Für eure Wünsche</p>
        <h2 id="services-title">Noch ein bisschen mehr.</h2>
      </div>

      <div class="extras-grid">
        {extras.map((extra) => (
          <article class="extra-card">
            <h3>{extra.name}</h3>
            <p>{extra.text}</p>
            <strong>{extra.price}</strong>
          </article>
        ))}
      </div>

      <a class="text-link services-link" href="/zusatzleistungen">
        Alle Zusatzleistungen ansehen →
      </a>
    </section>

    <!-- FOTOGRAFIN -->
    <section
      class="partner-section section-wrap"
      id="foto-video-team"
      aria-labelledby="partner-title"
    >
      <div>
        <p class="eyebrow">Foto &amp; Video als Team</p>
        <h2 id="partner-title">Zwei Perspektiven. Eine Geschichte.</h2>
        <p>
          Gemeinsam mit Julia von
          <strong>Junique Photography</strong> begleite ich
          Hochzeiten auch als eingespieltes Foto- und
          Videoteam. So können Bilder und Film harmonisch
          aufeinander abgestimmt entstehen.
        </p>
      </div>

      <a
        class="text-link"
        href="https://juniquephotography.de"
        target="_blank"
        rel="noopener noreferrer"
      >
        Junique Photography ansehen <span aria-hidden="true">↗</span>
      </a>
    </section>

    <!-- KONTAKT -->
    <section class="closing-section section-wrap" aria-labelledby="closing-title">
      <p class="eyebrow">Eure Geschichte verdient es, erzählt zu werden</p>
      <h2 id="closing-title">Lasst uns kennenlernen.</h2>
      <p>
        Erzählt mir von euren Plänen.
        Ich freue mich darauf, euren Tag kennenzulernen.
      </p>
      <a class="button button-primary" href="/kontakt">
        Verfügbarkeit anfragen <span aria-hidden="true">→</span>
      </a>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const video = document.getElementById("heroVideo");

    if (!(video instanceof HTMLVideoElement)) return;

    video.muted = true;
    video.defaultMuted = true;
    video.playsInline = true;
    video.loop = true;

    function tryPlay() {
      if (document.visibilityState === "hidden") return;
      if (!video.paused && !video.ended) return;

      const result = video.play();
      if (result && typeof result.catch === "function") {
        result.catch(() => {});
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", tryPlay, { once: true });
    } else {
      tryPlay();
    }

    video.addEventListener("loadeddata", tryPlay);
    video.addEventListener("canplay", tryPlay);
    window.addEventListener("pageshow", tryPlay);

    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") tryPlay();
    });

    ["pointerdown", "touchstart", "keydown"].forEach((name) => {
      document.addEventListener(name, tryPlay, { once: true, passive: true });
    });
  })();
</script>

<style>
  :global(body) { background: #fff; }

  .home-page {
    --ink: #17181d;
    --muted: #656872;
    --accent: #b46300;
    --line: #e6e6e8;
    color: var(--ink);
    background: white;
    overflow-x: clip;
  }

  .home-page *,
  .home-page *::before,
  .home-page *::after { box-sizing: border-box; }

  .home-page a { text-decoration: none; }

  .section-wrap {
    width: min(1140px, calc(100% - 48px));
    margin-inline: auto;
  }

  .eyebrow {
    margin: 0 0 15px;
    color: var(--accent);
    text-transform: uppercase;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .19em;
    line-height: 1.5;
  }

  .section-heading {
    max-width: 790px;
    margin: 0 auto 43px;
    text-align: center;
  }

  .section-heading h2,
  .about-copy h2,
  .location-section h2,
  .partner-section h2,
  .closing-section h2 {
    margin: 0;
    font-size: clamp(34px, 4.4vw, 54px);
    font-weight: 300;
    line-height: 1.08;
    letter-spacing: -.052em;
    text-wrap: balance;
  }

  .section-heading > p:last-child {
    max-width: 630px;
    margin: 18px auto 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.65;
  }

  .button {
    min-height: 52px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 13px 24px;
    border-radius: 7px;
    font-size: 14px;
    font-weight: 800;
    text-align: center;
    transition: background .2s, transform .2s;
  }

  .button:hover { transform: translateY(-2px); }
  .button-primary { background: var(--accent); color: white; }
  .button-primary:hover { background: #965000; }

  .button-outline {
    color: white;
    border: 1px solid rgba(255,255,255,.6);
    background: rgba(255,255,255,.05);
  }

  .button-outline:hover { background: rgba(255,255,255,.16); }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--accent);
    font-size: 15px;
    font-weight: 750;
    line-height: 1.5;
  }

  .text-link span { transition: transform .2s; }
  .text-link:hover span { transform: translateX(4px); }

  /* VIDEO-HERO */
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: max(660px, 100svh);
    padding: 135px 24px 105px;
    overflow: hidden;
    background: #15151a;
    color: white;
    text-align: center;
  }

  .hero-media,
  .hero-overlay {
    position: absolute;
    inset: 0;
  }

  .hero-media {
    background: #15151a url("/images/hero-poster.jpg") center / cover no-repeat;
  }

  .hero-video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    background: linear-gradient(
      180deg,
      rgba(7,8,12,.46) 0%,
      rgba(7,8,12,.25) 40%,
      rgba(7,8,12,.69) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    width: min(940px, 100%);
  }

  .hero-kicker {
    margin: 0 0 23px;
    color: rgba(255,255,255,.92);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .22em;
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(45px, 7vw, 88px);
    font-weight: 300;
    line-height: 1.04;
    letter-spacing: -.065em;
    text-wrap: balance;
  }

  .hero h1 em {
    font-style: normal;
    font-weight: 500;
  }

  .hero-subtitle {
    max-width: 610px;
    margin: 25px auto 0;
    color: rgba(255,255,255,.9);
    font-size: clamp(15px, 1.7vw, 18px);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .scroll-cue {
    position: absolute;
    z-index: 1;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    display: grid;
    place-items: start center;
    width: 24px;
    height: 39px;
    border: 1px solid rgba(255,255,255,.65);
    border-radius: 30px;
  }

  .scroll-cue span {
    width: 3px;
    height: 8px;
    margin-top: 8px;
    border-radius: 10px;
    background: white;
  }

  .value-strip {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px 45px;
    padding: 24px;
    border-bottom: 1px solid var(--line);
    color: #575a62;
    font-size: 13px;
    font-weight: 600;
    text-align: center;
  }

  .value-strip span + span::before {
    content: "·";
    margin-right: 44px;
    color: var(--accent);
  }

  /* HOCHZEITSFILM */
  .featured-story {
    padding-top: 105px;
    padding-bottom: 100px;
    scroll-margin-top: 80px;
  }

  .featured-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 18px;
    background: #111216;
    box-shadow: 0 25px 65px rgba(23,24,29,.12);
  }

  .featured-frame iframe {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .film-footer {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 22px;
    margin-top: 23px;
  }

  .film-footer h3 {
    margin: 0;
    font-size: clamp(26px, 3vw, 38px);
    font-weight: 350;
    letter-spacing: -.045em;
  }

  /* ÜBER MICH */
  .about-section {
    display: grid;
    grid-template-columns: .92fr 1.08fr;
    overflow: hidden;
    border-radius: 22px;
    background: var(--ink);
    color: white;
  }

  .about-photo {
    position: relative;
    min-height: 520px;
    overflow: hidden;
    background: #303139;
  }

  .about-photo img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 23%;
  }

  .about-copy {
    align-self: center;
    padding: clamp(35px, 5vw, 78px);
  }

  .about-copy h2 { color: white; }

  .about-copy > p:not(.eyebrow) {
    max-width: 560px;
    margin: 20px 0 0;
    color: rgba(255,255,255,.76);
    font-size: 16px;
    line-height: 1.75;
  }

