const reviews = [
  {
    text: "Wir haben 2024 geheiratet und uns ziemlich spontan für einen Videografen entschieden...",
    name: "Jasmin & José Luis",
    place: "Soest / Möhnesee",
    image: "/images/jasmin-jose.jpeg",
  },
  {
    text: "Wie fangen wir an... Während unserer Hochzeitsplanung haben wir erst gesagt, einen Videografen brauchen wir nicht...",
    name: "Jana & Stefan",
    place: "Westoverledingen",
    image: "/images/jana-stefan.jpg",
  },
];
---

<BaseLayout
  title="Hochzeitsvideograf Witten & NRW | VJ Production"
  description="VJ Production ist dein Hochzeitsvideograf aus Witten für NRW und deutschlandweit. Hochzeitsfilme, Hochzeitsvideos und emotionale Erinnerungen cineastisch erzählt."
>
  <section class="hero">
    <video
      class="hero-video"
      id="heroVideo"
      autoplay
      muted
      loop
      playsinline
      webkit-playsinline
      preload="auto"
      poster="/images/hero-poster.jpg"
    >
      <source src="/videos/hero.mp4" type="video/mp4" />
    </video>

    <div class="hero-fallback"></div>
    <div class="hero-overlay"></div>

    <div class="hero-content">
      <h1>Euer Tag. Für immer fühlbar.</h1>
      <h2>Hochzeitsvideograf aus Witten</h2>
      <p>NRW und deutschlandweit. Echte Momente, cineastisch erzählt.</p>

      <div class="hero-actions">
        <a href="/kontakt" class="btn-main">Verfügbarkeit anfragen <span>→</span></a>
        <a href="/portfolio" class="btn-ghost"><span>▷</span> Portfolio ansehen</a>
      </div>
    </div>

    <div class="scroll-indicator" aria-hidden="true"></div>
  </section>

  <section class="intro">
    <div class="intro-inner">
      <h2>Hochzeitsvideograf in Nordrhein-Westfalen</h2>
      <p>
        Als <strong>Hochzeitsvideograf aus Witten</strong> begleite ich Hochzeiten in
        <strong>NRW</strong> und deutschlandweit – besonders rund um
        <strong>Dortmund, Bochum, Essen, Hagen und Witten</strong>. Ich filme unaufdringlich
        und halte echte Momente fest, damit ihr den Tag genießen könnt.
      </p>
      <p>
        Aus dem Material entsteht ein <strong>Hochzeitsfilm</strong>, der emotional ist,
        hochwertig geschnitten und zeitlos erzählt. Ob klassische Hochzeit, moderne Zeremonie
        oder nachträgliches Hochzeitsvideo – ich fange eure Geschichte ein.
      </p>
    </div>
  </section>

  <section class="process">
    <p class="kicker">Ablauf</p>
    <h2>So läuft's ab</h2>

    <div class="timeline">
      {processSteps.map((step) => (
        <article class="timeline-item">
          <span class="step-number">{step.number}</span>
          <div class="step-icon" set:html={step.icon}></div>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="packages">
    <p class="kicker">Pakete</p>
    <h2>Transparente Preise</h2>
    <p class="subtitle">Wählt das Paket, das zu eurer Vision passt</p>

    <div class="package-grid">
      {packages.map((item) => (
        <article class={`package-card ${item.popular ? "popular" : ""}`}>
          {item.popular && <div class="popular-badge">✤ Beliebt</div>}

          <h3>{item.name}</h3>
          <div class="price">{item.price}<span>€</span></div>

          <ul>
            {item.features.map((feature) => (
              <li>{feature}</li>
            ))}
          </ul>

          <a class="package-button" href="/kontakt">Paket anfragen <span>→</span></a>
        </article>
      ))}

      <article class="package-card individual">
        <div class="flex-badge">✤ Flexibel</div>
        <h3>Individuell</h3>
        <div class="price request">Auf Anfrage</div>

        <ul>
          <li>Film-Länge frei wählbar</li>
          <li>Begleitungsdauer nach Wunsch</li>
          <li>Optional: Drohne & Add-ons</li>
          <li>Flexibel auf euren Tag abgestimmt</li>
        </ul>

        <a class="package-button" href="/kontakt">Individuell anfragen <span>→</span></a>
      </article>
    </div>
  </section>

  <section class="late-video">
    <div class="late-card">
      <div class="late-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <rect x="4" y="4" width="16" height="16" rx="1.5"></rect>
          <path d="M8 4v16"></path>
          <path d="M16 4v16"></path>
          <path d="M4 8h4"></path>
          <path d="M4 12h4"></path>
          <path d="M4 16h4"></path>
          <path d="M16 8h4"></path>
          <path d="M16 12h4"></path>
          <path d="M16 16h4"></path>
        </svg>
      </div>

      <div>
        <h2>Nachträgliches Hochzeitsvideo</h2>
        <p>
          Für Paare, die am Hochzeitstag keinen Videografen hatten. Ein professionelles Shooting nach der Hochzeit.
        </p>
        <a href="/nachtraegliches-hochzeitsvideo">Mehr erfahren <span>→</span></a>
      </div>
    </div>
  </section>

  <section class="extras">
    <p class="kicker">Extras</p>
    <h2>Zusatzleistungen</h2>

    <div class="extras-grid">
      {extras.map((extra) => (
        <article class="extra-card">
          <div class="extra-icon" set:html={extra.icon}></div>
          <h3>{extra.title}</h3>
          <p>{extra.text}</p>
          <strong>{extra.price}</strong>
        </article>
      ))}
    </div>

    <a class="details-button" href="/zusatzleistungen">Alle Details <span>→</span></a>
  </section>

  <section class="reviews">
    <p class="kicker">Bewertungen</p>

    <div class="reviews-grid">
      {reviews.map((review) => (
        <article class="review-card">
          <div class="review-top">
            <span class="stars">★★★★★</span>
            <span class="quote">”</span>
          </div>

          <p>"{review.text}"</p>
          <a href="/bewertungen">Mehr lesen →</a>

          <div class="review-person">
            <img
              class="review-thumb"
              src={review.image}
              alt={`Foto von ${review.name}`}
              loading="lazy"
            />

            <div>
              <strong>{review.name}</strong>
              <span>{review.place}</span>
            </div>
          </div>
        </article>
      ))}
    </div>

    <a class="all-reviews" href="/bewertungen">Alle Bewertungen lesen <span>→</span></a>
  </section>

  <section class="cta">
    <div class="cta-inner">
      <h2>Bereit für euren Film?</h2>
      <p>Lasst uns in einem unverbindlichen Gespräch herausfinden, wie ich euren Tag am besten festhalte.</p>
      <a href="/kontakt">Verfügbarkeit anfragen <span>→</span></a>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  const heroVideo = document.getElementById("heroVideo");

  if (heroVideo) {
    heroVideo.muted = true;
    heroVideo.defaultMuted = true;
    heroVideo.playsInline = true;

    const playHeroVideo = () => {
      const playPromise = heroVideo.play();

      if (playPromise !== undefined) {
        playPromise.catch(() => {
          /*
            Manche mobile Browser blockieren Autoplay trotzdem,
            z. B. bei Stromsparmodus oder wenn das Video eine Tonspur enthält.
          */
        });
      }
    };

    playHeroVideo();

    document.addEventListener("touchstart", playHeroVideo, { once: true });
    document.addEventListener("click", playHeroVideo, { once: true });
    window.addEventListener("load", playHeroVideo, { once: true });
    window.addEventListener("pageshow", playHeroVideo);
  }
</script>

<style>
  :global(body) {
    background: #fff;
  }

  .hero {
    position: relative;
    height: 100vh;
    min-height: 690px;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #09090b;
    color: white;
    text-align: center;
  }

  .hero-video,
  .hero-fallback,
  .hero-overlay {
    position: absolute;
    inset: 0;
  }

  .hero-video {
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-fallback {
    z-index: -1;
    background:
      linear-gradient(rgba(0, 0, 0, 0.18), rgba(0, 0, 0, 0.5)),
      url("https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=2200&q=85")
        center/cover;
    filter: saturate(0.9);
  }

  .hero-overlay {
    z-index: 1;
    background:
      radial-gradient(circle at center, rgba(255, 255, 255, 0.04), transparent 32%),
      linear-gradient(to bottom, rgba(0, 0, 0, 0.08), rgba(0, 0, 0, 0.62));
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: min(860px, calc(100% - 40px));
    margin-top: 40px;
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(38px, 4.8vw, 64px);
    font-weight: 300;
    letter-spacing: -0.055em;
    line-height: 1.05;
  }

  .hero h2 {
    margin: 10px 0 0;
    font-size: clamp(30px, 4vw, 52px);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 1.08;
  }

  .hero p {
    margin: 14px auto 0;
    max-width: 740px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 16px;
    line-height: 1.65;
  }

  .hero-actions {
    margin-top: 34px;
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .btn-main,
  .btn-ghost {
    height: 52px;
    min-width: 215px;
    padding: 0 24px;
    border-radius: 7px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    font-size: 14px;
    font-weight: 700;
  }

  .btn-main {
    background: #df7b00;
    color: white;
  }

  .btn-ghost {
    border: 1px solid rgba(255, 255, 255, 0.38);
    background: rgba(255, 255, 255, 0.06);
    color: white;
  }

  .scroll-indicator {
    position: absolute;
    bottom: 32px;
    left: 50%;
    z-index: 2;
    transform: translateX(-50%);
    width: 20px;
    height: 34px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.58);
    animation: mouseMove 1.7s ease-in-out infinite;
  }

  .scroll-indicator::after {
    content: "";
    position: absolute;
    top: 8px;
    left: 50%;
    width: 3px;
    height: 8px;
    border-radius: 999px;
    transform: translateX(-50%);
    background: rgba(255, 255, 255, 0.72);
  }

  @keyframes mouseMove {
    0% {
      transform: translateX(-50%) translateY(0);
    }

    50% {
      transform: translateX(-50%) translateY(10px);
    }

    100% {
      transform: translateX(-50%) translateY(0);
    }
  }

  .intro {
    padding: 88px 20px 96px;
    background: white;
    text-align: center;
  }

  .intro-inner {
    width: min(880px, 100%);
    margin: 0 auto;
  }

  .intro h2 {
    margin: 0 0 28px;
    font-size: clamp(30px, 3.2vw, 42px);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.12;
  }

  .intro p {
    margin: 0 auto 24px;
    color: #555660;
    font-size: 17px;
    line-height: 1.72;
  }

  .intro strong {
    color: #3f4048;
    font-weight: 800;
  }

  .process {
    padding: 96px 20px 108px;
    background: #f6f6f7;
    text-align: center;
  }

  .kicker {
    margin: 0 0 18px;
    color: #df7b00;
    text-transform: uppercase;
    letter-spacing: 0.34em;
    font-size: 12px;
    font-weight: 700;
  }

  .process > h2,
  .packages > h2,
  .extras > h2 {
    margin: 0;
    color: #17181d;
    font-size: clamp(36px, 4.2vw, 54px);
    font-weight: 300;
    letter-spacing: -0.06em;
    line-height: 1.08;
  }

  .timeline {
    position: relative;
    width: min(1180px, 100%);
    margin: 72px auto 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 28px;
  }

  .timeline::before {
    content: "";
    position: absolute;
    top: 39px;
    left: 8%;
    right: 8%;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(230, 188, 99, 0.55), transparent);
  }

  .timeline-item {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .step-number {
    position: absolute;
    top: -14px;
    right: calc(50% - 58px);
    width: 28px;
    height: 28px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    background: #17181d;
    color: white;
    font-size: 12px;
    font-weight: 800;
    z-index: 3;
  }

  .step-icon {
    width: 78px;
    height: 78px;
    margin: 0 auto 26px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    background: white;
    color: #df7b00;
    box-shadow: 0 16px 34px rgba(0, 0, 0, 0.08);
    overflow: visible;
  }

  :global(.step-icon svg) {
    width: 28px !important;
    height: 28px !important;
    display: block !important;
    overflow: visible !important;
  }

  :global(.step-icon svg path),
  :global(.step-icon svg rect),
  :global(.step-icon svg circle) {
    fill: none !important;
    stroke: #df7b00 !important;
    stroke-width: 2 !important;
    stroke-linecap: round !important;
    stroke-linejoin: round !important;
  }

  .timeline-item h3 {
    margin: 0 0 12px;
    color: #17181d;
    font-size: 16px;
    font-weight: 800;
  }

  .timeline-item p {
    margin: 0 auto;
    max-width: 220px;
    color: #747680;
    font-size: 14px;
    line-height: 1.55;
  }

  .packages {
    padding: 88px 20px 104px;
    background: white;
    text-align: center;
  }

  .subtitle {
    margin: 14px 0 54px;
    color: #777984;
    font-size: 15px;
  }

  .package-grid {
    width: min(1120px, 100%);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 34px;
    align-items: start;
  }

  .package-card {
    position: relative;
    min-height: 520px;
    padding: 42px 34px 34px;
    border-radius: 18px;
    background: #f7f7f8;
    text-align: left;
  }

  .package-card.popular {
    background: #17181d;
    color: white;
    transform: translateY(-16px);
    box-shadow: 0 28px 60px rgba(0, 0, 0, 0.2);
