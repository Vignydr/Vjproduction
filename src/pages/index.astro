
---
import BaseLayout from "../layouts/BaseLayout.astro";

const featuredFilm = {
  couple: "Phelina & Mert",
  type: "Wedding Teaser",
  src: "https://galleries.vidflow.co/videos/b6w58mek",
};

const processSteps = [
  {
    number: "01",
    title: "Kennenlernen",
    text: "Wir sprechen über euch, eure Wünsche und euren Hochzeitstag.",
  },
  {
    number: "02",
    title: "Planung",
    text: "Wir stimmen Ablauf, wichtige Momente und Details miteinander ab.",
  },
  {
    number: "03",
    title: "Euer großer Tag",
    text: "Ich begleite euch ruhig und halte die Momente fest, wie sie passieren.",
  },
  {
    number: "04",
    title: "Filmschnitt",
    text: "Aus Bild, Ton und Musik entsteht euer persönlicher Hochzeitsfilm.",
  },
  {
    number: "05",
    title: "Euer Film",
    text: "Ihr erhaltet eure private Vidflow-Galerie zum Ansehen, Herunterladen und Teilen.",
  },
];

const packages = [
  {
    name: "Basic",
    price: "1.290",
    hours: "4 Stunden Begleitung",
    secondVideographerTarget: "zweiter-videograf-basic",
    features: [
      "Highlightfilm (3–5 Min.)",
      "Professioneller Schnitt",
      "Lizenzierte Musik",
      "Lieferung innerhalb 8 Wochen",
      "1 Korrekturschleife",
    ],
  },
  {
    name: "Classic",
    price: "1.990",
    hours: "7 Stunden Begleitung",
    popular: true,
    secondVideographerTarget: "zweiter-videograf-classic",
    features: [
      "Highlightfilm (5–8 Min.)",
      "Kurzfilm für Social Media",
      "Erweiterte Farbkorrektur",
      "Lizenzierte Musik",
      "Lieferung innerhalb 8 Wochen",
      "2 Korrekturschleifen",
    ],
  },
  {
    name: "Premium",
    price: "2.390",
    hours: "Bis zu 12 Stunden Begleitung",
    secondVideographerTarget: "zweiter-videograf-premium",
    features: [
      "Cinematic Highlightfilm (8–12 Min.)",
      "Kurzfilm für Social Media",
      "Erweiterte Farbkorrektur",
      "Drohnenaufnahmen inklusive",
      "Lieferung innerhalb 6 Wochen",
      "3 Korrekturschleifen",
    ],
  },
];

const selectedReviews = [
  {
    name: "Phelina & Mert",
    place: "Dortmund",
    image: "/images/Phelina & Mert .jpg",
    text: "Wir sind unendlich dankbar, dass Vigny unseren großen Tag so wunderschön und emotional festgehalten hat! Die Videos sind einfach traumhaft geworden und wir könnten nicht glücklicher damit sein.",
