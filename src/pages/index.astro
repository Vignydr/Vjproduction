---
import BaseLayout from "../layouts/BaseLayout.astro";

const processSteps = [
  {
    number: "1",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="#df7b00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 17 0Z"></path>
    </svg>`,
    title: "Kennenlernen",
    text: "Wir besprechen eure Vision und Wünsche",
  },
  {
    number: "2",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="#df7b00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M8 2v4"></path>
      <path d="M16 2v4"></path>
      <path d="M3.5 9h17"></path>
      <path d="M5.5 4.5h13A2 2 0 0 1 20.5 6.5v12A2 2 0 0 1 18.5 20.5h-13A2 2 0 0 1 3.5 18.5v-12A2 2 0 0 1 5.5 4.5Z"></path>
    </svg>`,
    title: "Planung",
    text: "Gemeinsam planen wir den perfekten Drehtag",
  },
  {
    number: "3",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="#df7b00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M4 4h16v16H4z"></path>
      <path d="M8 4v16"></path>
      <path d="M16 4v16"></path>
      <path d="M4 8h4"></path>
      <path d="M4 12h4"></path>
      <path d="M4 16h4"></path>
      <path d="M16 8h4"></path>
      <path d="M16 12h4"></path>
      <path d="M16 16h4"></path>
    </svg>`,
    title: "Euer großer Tag",
    text: "Diskret fange ich alle magischen Momente ein",
  },
  {
    number: "4",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="#df7b00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20.8 5.6a5.1 5.1 0 0 0-7.2 0L12 7.2l-1.6-1.6a5.1 5.1 0 0 0-7.2 7.2L12 21.5l8.8-8.7a5.1 5.1 0 0 0 0-7.2Z"></path>
    </svg>`,
    title: "Postproduktion",
    text: "Mit Liebe zum Detail entsteht euer Film",
  },
  {
    number: "5",
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="#df7b00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 2 11 13"></path>
      <path d="M22 2 15 22l-4-9-9-4 20-7Z"></path>
    </svg>`,
    title: "Lieferung",
    text: "Ihr erhaltet euren Film über Vidflow – eine private Video-Galerie mit einfachem Link zum Ansehen, Herunterladen und Teilen",
  },
];

const packages = [
  {
    name: "Basic",
    price: "1.290",
    features: [
      "4 Stunden Begleitung",
      "Highlightfilm (3–5 Min.)",
      "Professioneller Schnitt",
      "Lizenzierte Musik",
      "Lieferung innerhalb 8 Wochen",
      "1 Korrekturschleife",
    ],
  },
  {
    name: "Classic",
    price: "1.990",
    popular: true,
    features: [
      "7 Stunden Begleitung",
      "Highlightfilm (5–8 Min.)",
      "Kurzfilm für Social Media",
      "Erweiterte Farbkorrektur",
      "Lizenzierte Musik",
      "Lieferung innerhalb 8 Wochen",
      "2 Korrekturschleifen",
    ],
  },
  {
    name: "Premium",
    price: "2.790",
    features: [
      "Ganztägige Begleitung (bis zu 10h)",
      "Cinematic Highlightfilm (8–12 Min.)",
      "Kurzfilm für Social Media",
      "Erweiterte Farbkorrektur",
      "Drohnenaufnahmen inklusive",
      "Lieferung innerhalb 6 Wochen",
      "3 Korrekturschleifen",
    ],
  },
