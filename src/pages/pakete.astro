
---
import BaseLayout from "../layouts/BaseLayout.astro";

const packages = [
  {
    name: "Basic",
    subtitle: "Perfekt für intime Hochzeiten",
    price: "1.290",
    hours: "4h",
    films: "1 Film",
    revisions: "1x Revision",
    target: "zweiter-videograf-basic",
    features: [
      "4 Stunden Begleitung",
      "Highlightfilm (3–5 Min.)",
      "Professioneller Schnitt",
      "Lizenzierte Musik",
      "Lieferung innerhalb 8 Wochen",
      "1 Korrekturschleife",
    ],
  },
  {
    name: "Classic",
    subtitle: "Mein beliebtestes Paket",
    price: "1.990",
    hours: "7h",
    films: "2 Filme",
    revisions: "2x Revision",
    target: "zweiter-videograf-classic",
    popular: true,
    features: [
      "7 Stunden Begleitung",
      "Highlightfilm (5–8 Min.)",
      "Kurzfilm für Social Media",
      "Erweiterte Farbkorrektur",
      "Lizenzierte Musik",
      "Lieferung innerhalb 8 Wochen",
      "2 Korrekturschleifen",
    ],
  },
  {
    name: "Premium",
    subtitle: "Das komplette Kinoerlebnis",
    price: "2.390",
    hours: "12h",
    films: "2 Filme",
    revisions: "3x Revision",
    target: "zweiter-videograf-premium",
    features: [
      "Ganztägige Begleitung (bis zu 12h)",
      "Cinematic Highlightfilm (8–12 Min.)",
      "Kurzfilm für Social Media",
      "Erweiterte Farbkorrektur",
      "Drohnenaufnahmen inklusive",
      "Lieferung innerhalb 6 Wochen",
      "3 Korrekturschleifen",
    ],
  },
];

const individualFeatures = [
  "Film-Länge frei wählbar, z. B. 30–45 Min.",
  "Begleitungsdauer nach Wunsch",
  "Optional: Drohnenaufnahmen",
  "Standesamt / freie Trauung / Feier",
  "Optional: Social Media Clip",
  "Optional: Rohmaterial oder extra Versionen",
];

const faqs = [
  {
    question: "Welche Musik wird verwendet?",
    answer:
      "Ich verwende ausschließlich lizenzierte Musik aus professionellen Musikbibliotheken. Wenn ihr euch einen bestimmten Song wünscht, prüfen wir gemeinsam, ob eine rechtssichere Nutzung möglich ist. Falls dafür zusätzliche Lizenzkosten anfallen, sage ich euch das vorher transparent.",
  },
  {
    question: "Wie funktioniert die Anzahlung?",
    answer:
      "Nach der Buchung wird eine Anzahlung fällig. Erst nach Eingang der Anzahlung ist euer Termin verbindlich reserviert.",
  },
  {
    question: "Kann ich Änderungen am fertigen Film vornehmen?",
    answer:
      "Ja. Je nach Paket sind eine oder mehrere Korrekturschleifen enthalten. Kleinere Anpassungen können wir gemeinsam besprechen.",
  },
  {
    question: "Wie lange dauert die Lieferung?",
    answer:
      "Je nach Paket liegt die reguläre Lieferzeit meist zwischen 6 und 8 Wochen. Bei Expresslieferung kann der Film schneller fertiggestellt werden.",
  },
  {
    question: "Darf ich meinen Film auf Social Media teilen?",
    answer:
      "Ja, natürlich. Dafür eignet sich besonders ein zusätzlicher Kurzfilm oder ein Social-Media-Reel.",
  },
];
---

<BaseLayout
  title="Pakete & Preise | Hochzeitsvideograf Witten & NRW | VJ Production"
  description="Hochzeitsvideo-Pakete von VJ Production: Basic ab 1.290 €, Classic ab 1.990 € und Premium ab 2.390 €. Professionelle Hochzeitsfilme aus Witten."
>
  <div class="prices-page">
    <header class="prices-head">
      <p class="eyebrow">Pakete &amp; Preise</p>
      <h1>Euer Tag verdient einen besonderen Film.</h1>
      <p class="intro-text">
        Ob intime Trauung oder große Hochzeitsfeier:
        Wählt die Begleitung, die zu eurem Tag passt.
        Persönlich, transparent und ohne versteckte Kosten.
      </p>
      <p class="tax-note">
        Preise gemäß § 19 UStG ohne Ausweis der Mehrwertsteuer.
      </p>
    </header>

    <section class="packages-section" aria-labelledby="packages-title">
      <div class="section-intro">
        <p class="eyebrow">Eure Möglichkeiten</p>
        <h2 id="packages-title">Drei Pakete. Eure Geschichte.</h2>
      </div>

      <div class="packages-grid">
        {packages.map((item) => (
          <article class:list={["package-card", { "is-popular": item.popular }]}>
            {item.popular && (
              <div class="popular-label">Häufig gewählt</div>
            )}

            <div class="package-top">
              <h3>{item.name}</h3>
              <p class="package-subtitle">{item.subtitle}</p>
              <p class="package-price">{item.price}<span> €</span></p>
            </div>

            <div class="package-meta">
              <div>
                <strong>{item.hours}</strong>
                <span>Begleitung</span>
              </div>
              <div>
                <strong>{item.films}</strong>
                <span>Videos</span>
              </div>
              <div>
                <strong>{item.revisions}</strong>
                <span>Anpassungen</span>
              </div>
            </div>

            <ul class="package-features">
              {item.features.map((feature) => (
                <li>
                  <span aria-hidden="true">✓</span>
                  {feature}
                </li>
              ))}
            </ul>

            <details class="second-videographer" id={item.target}>
              <summary>
                <span>
                  Zweiter Videograf optional<br />
                  <strong>ab 350 €</strong>
                </span>
                <span class="details-action">
                  Mehr erfahren <span aria-hidden="true">⌄</span>
                </span>
              </summary>

              <div class="second-videographer-content">
                <h4>Noch mehr Perspektiven auf euren Tag</h4>
                <p>
                  Auch mit einem Videografen lässt sich euer Hochzeitstag
                  umfassend und authentisch begleiten. Ein zweiter Videograf
                  ist eine optionale Erweiterung für Paare, die sich noch
                  mehr Blickwinkel und gleichzeitig eingefangene Momente wünschen.
                </p>
                <p>
                  Besonders bei getrennten Getting Readys, größeren Hochzeiten
                  oder parallel stattfindenden Programmpunkten können so
                  zusätzliche Perspektiven entstehen.
                </p>
                <p>
                  Der genaue Preis richtet sich nach Dauer und Umfang
                  der zusätzlichen Begleitung.
                </p>
              </div>
            </details>

            <a class="package-button" href="/kontakt">
              Paket anfragen <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="individual-section" aria-labelledby="individual-title">
      <div class="individual-copy">
        <p class="eyebrow">Individuelles Angebot</p>
        <h2 id="individual-title">So einzigartig wie euer Tag.</h2>
        <p>
          Nicht jede Hochzeit passt in ein festes Paket.
          Deshalb können wir gemeinsam eine Begleitung
          zusammenstellen, die zu euren Vorstellungen passt.
        </p>
        <p class="individual-price">Auf Anfrage</p>
        <a href="/kontakt" class="individual-button">
          Individuell anfragen <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="individual-details">
        <h3>Individuell kombinierbar</h3>
        <ul>
          {individualFeatures.map((feature) => (
            <li>
              <span aria-hidden="true">✓</span>
              {feature}
            </li>
          ))}
        </ul>

        <details class="individual-second" id="zweiter-videograf-individuell">
          <summary>
            Zweiter Videograf optional · ab 350 €
            <span aria-hidden="true">⌄</span>
          </summary>
          <p>
            Für zusätzliche Blickwinkel und gleichzeitig stattfindende
            Momente. Die Kosten hängen von Dauer und Umfang der Begleitung ab.
          </p>
        </details>
      </div>
    </section>

    <section class="notes-section" aria-labelledby="notes-title">
      <div class="notes-heading">
        <p class="eyebrow">Gut zu wissen</p>
        <h2 id="notes-title">Wichtige Hinweise</h2>
      </div>

      <div class="notes-grid">
        <article>
          <span class="note-number">01</span>
          <h3>Reisekosten</h3>
          <p>0,50 € pro Kilometer für die Hin- und Rückfahrt.</p>
        </article>
        <article>
          <span class="note-number">02</span>
          <h3>Terminreservierung</h3>
          <p>
            Euer Hochzeitstermin ist nach Eingang der Anzahlung
            verbindlich reserviert.
          </p>
        </article>
        <article>
          <span class="note-number">03</span>
          <h3>Zusatzleistungen</h3>
          <p>
            Drohnenaufnahmen, Extra-Reels und Expresslieferung
            könnt ihr bei Bedarf ergänzen.
          </p>
          <a href="/zusatzleistungen">Alle Zusatzleistungen →</a>
        </article>
      </div>
    </section>

    <section class="faq-section" aria-labelledby="faq-title">
      <div class="faq-heading">
        <p class="eyebrow">Fragen &amp; Antworten</p>
        <h2 id="faq-title">Häufige Fragen</h2>
        <p>Damit ihr schon vor eurer Anfrage wisst, was euch erwartet.</p>
      </div>

      <div class="faq-list">
        {faqs.map((faq, index) => (
          <details open={index === 0}>
            <summary>
              <span>{faq.question}</span>
              <span class="faq-arrow" aria-hidden="true">⌄</span>
            </summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="late-video-card" aria-labelledby="extras-title">
      <div>
        <p class="eyebrow">Eure Möglichkeiten</p>
        <h2 id="extras-title">Noch mehr aus eurem Hochzeitsfilm machen.</h2>
        <p>
          Vom zweiten Videografen über Drohnenaufnahmen bis zum
          Social-Media-Reel: Ihr könnt eure Hochzeitsbegleitung
          mit ausgewählten Zusatzleistungen ergänzen.
        </p>
      </div>
      <a href="/zusatzleistungen">
        Extras entdecken <span aria-hidden="true">→</span>
      </a>
    </section>

    <section class="prices-cta" aria-labelledby="cta-title">
      <p class="eyebrow">Eure Geschichte beginnt hier</p>
      <h2 id="cta-title">Bereit für euren Film?</h2>
      <p>
        Erzählt mir von euren Plänen. Gemeinsam finden wir heraus,
        welche Begleitung zu eurem Hochzeitstag passt.
      </p>
      <a href="/kontakt">
        Verfügbarkeit anfragen <span aria-hidden="true">→</span>
      </a>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    function openDetailsFromHash() {
      const id = decodeURIComponent(window.location.hash.slice(1));
      if (!id.startsWith("zweiter-videograf-")) return;

      const target = document.getElementById(id);
      if (!(target instanceof HTMLDetailsElement)) return;

      target.open = true;
      requestAnimationFrame(() => {
        target.scrollIntoView({
          behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches
            ? "auto"
            : "smooth",
          block: "start",
        });
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", openDetailsFromHash, { once: true });
    } else {
      openDetailsFromHash();
    }

    window.addEventListener("hashchange", openDetailsFromHash);
    window.addEventListener("pageshow", openDetailsFromHash);
  })();
</script>

<style>
  :global(body) { background: white; }

  .prices-page {
    --accent: #b46300;
    --ink: #17181d;
    --muted: #696b73;
    --line: #e6e6e8;
    padding: 144px 24px 94px;
    background: white;
    color: var(--ink);
  }

  .prices-page *,
  .prices-page *::before,
  .prices-page *::after { box-sizing: border-box; }

  .prices-page a { text-decoration: none; }

  .eyebrow {
    margin: 0 0 16px;
    color: var(--accent);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .2em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .prices-head {
    width: min(850px, 100%);
    margin: 0 auto 83px;
    text-align: center;
  }

  .prices-head h1 {
    margin: 0;
    font-size: clamp(42px, 5.6vw, 76px);
    font-weight: 300;
    letter-spacing: -.06em;
    line-height: 1.06;
    text-wrap: balance;
  }

  .intro-text {
    max-width: 660px;
    margin: 24px auto 0;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.75;
  }

  .tax-note {
    margin: 16px 0 0;
    color: #898b94;
    font-size: 13px;
  }

  .packages-section,
  .individual-section,
  .notes-section,
  .late-video-card,
  .prices-cta {
    width: min(1240px, 100%);
    margin-inline: auto;
  }

  .section-intro {
    margin-bottom: 40px;
    text-align: center;
  }

  .section-intro h2,
  .notes-heading h2,
  .faq-heading h2 {
    margin: 0;
    font-size: clamp(32px, 4vw, 49px);
    font-weight: 350;
    letter-spacing: -.05em;
    line-height: 1.12;
  }

  .packages-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: 20px;
  }

  .package-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 36px 29px 28px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: #fafafa;
  }

  .package-card.is-popular {
    background: var(--ink);
    border-color: var(--ink);
    color: white;
    box-shadow: 0 23px 55px rgba(23,24,29,.15);
  }

  .popular-label {
    position: absolute;
    top: -14px;
    right: 22px;
    padding: 8px 13px;
    border-radius: 5px;
    background: #d38b32;
    color: white;
    font-size: 11px;
    font-weight: 800;
  }

  .package-top {
    min-height: 151px;
    text-align: center;
  }

  .package-top h3 {
    margin: 0;
    font-size: 27px;
    font-weight: 600;
    letter-spacing: -.045em;
  }

  .package-subtitle {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .is-popular .package-subtitle {
    color: rgba(255,255,255,.67);
  }

  .package-price {
    margin: 23px 0 0;
    font-size: 45px;
    font-weight: 350;
    line-height: 1.15;
    letter-spacing: -.055em;
    white-space: nowrap;
  }

  .package-price span {
    font-size: 20px;
    font-weight: 400;
  }

  .package-meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    padding: 21px 0;
    border-block: 1px solid var(--line);
  }

  .is-popular .package-meta {
    border-color: rgba(255,255,255,.19);
  }

  .package-meta > div {
    display: grid;
    justify-items: center;
    gap: 5px;
    min-width: 0;
    text-align: center;
  }

  .package-meta strong {
    color: var(--accent);
    font-size: 16px;
    font-weight: 800;
  }

  .is-popular .package-meta strong { color: #ffb45a; }

  .package-meta span {
    color: var(--muted);
    font-size: 11px;
  }

  .is-popular .package-meta span {
    color: rgba(255,255,255,.62);
  }

  .package-features {
    display: grid;
    align-content: start;
    flex: 1;
    gap: 15px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .package-features li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: #53565e;
    font-size: 14px;
    line-height: 1.55;
  }

  .package-features li > span {
    color: var(--accent);
    font-weight: 900;
  }

  .is-popular .package-features li {
    color: rgba(255,255,255,.84);
  }

  .is-popular .package-features li > span {
    color: #ffb45a;
  }

  .second-videographer {
    margin-top: 27px;
    border-top: 1px solid var(--line);
    scroll-margin-top: 110px;
  }

  .is-popular .second-videographer {
    border-color: rgba(255,255,255,.19);
  }

  .second-videographer summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 18px 0;
    cursor: pointer;
    list-style: none;
  }

  .second-videographer summary::-webkit-details-marker,
  .individual-second summary::-webkit-details-marker,
  .faq-list summary::-webkit-details-marker {
    display: none;
  }

  .second-videographer summary > span:first-child {
    color: #60636c;
    font-size: 12px;
    line-height: 1.6;
  }

  .second-videographer summary strong {
    color: var(--ink);
    font-size: 13px;
  }

  .is-popular .second-videographer summary > span:first-child {
    color: rgba(255,255,255,.72);
  }

  .is-popular .second-videographer summary strong { color: white; }

  .details-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--accent);
    font-size: 11px;
    font-weight: 800;
    white-space: nowrap;
  }

  .is-popular .details-action { color: #ffb45a; }
  .details-action > span { font-size: 19px; }
  .second-videographer[open] .details-action > span {
    transform: rotate(180deg);
  }

  .second-videographer-content {
    padding: 5px 0 15px;
  }

  .second-videographer-content h4 {
    margin: 0 0 12px;
    font-size: 16px;
  }

  .second-videographer-content p {
    margin: 0 0 12px;
    color: #646670;
    font-size: 13px;
    line-height: 1.7;
  }

  .is-popular .second-videographer-content p {
    color: rgba(255,255,255,.75);
  }

  .package-button,
  .individual-button,
  .prices-cta > a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 51px;
    padding: 12px 19px;
    border-radius: 7px;
    background: var(--accent);
    color: white;
    font-size: 14px;
    font-weight: 800;
    transition: background .2s;
  }

  .package-button { margin-top: 16px; }

  .package-button:hover,
  .individual-button:hover,
  .prices-cta > a:hover { background: #965000; }

  /* INDIVIDUELL */
  .individual-section {
    display: grid;
    grid-template-columns: .95fr 1.05fr;
    align-items: center;
    gap: clamp(35px, 6vw, 100px);
    margin-top: 25px;
    padding: clamp(34px, 5vw, 65px);
    border: 1px solid var(--line);
    border-radius: 18px;
    background: #f7f7f7;
  }

  .individual-copy h2 {
    margin: 0;
    font-size: clamp(31px, 3.4vw, 44px);
    font-weight: 350;
    letter-spacing: -.05em;
    line-height: 1.12;
  }

  .individual-copy > p:not(.eyebrow):not(.individual-price) {
    margin: 20px 0 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.75;
  }

  .individual-price {
    margin: 26px 0 0;
    font-size: 25px;
    font-weight: 650;
  }

  .individual-button { margin-top: 25px; }

  .individual-details {
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: white;
  }

  .individual-details h3 {
    margin: 0 0 23px;
    font-size: 21px;
    font-weight: 600;
  }

  .individual-details ul {
    display: grid;
    gap: 15px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .individual-details li {
    display: flex;
    gap: 13px;
    color: #53565e;
    font-size: 14px;
    line-height: 1.5;
  }

  .individual-details li span {
    color: var(--accent);
    font-weight: 900;
  }

  .individual-second {
    margin-top: 25px;
    border-top: 1px solid var(--line);
    scroll-margin-top: 110px;
  }

  .individual-second summary {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 17px 0 0;
    color: var(--accent);
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    list-style: none;
  }

  .individual-second[open] summary span {
    transform: rotate(180deg);
  }

  .individual-second p {
    margin: 15px 0 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
  }

  /* HINWEISE */
  .notes-section { margin-top: 106px; }
  .notes-heading { margin-bottom: 32px; }

  .notes-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .notes-grid article {
    padding: 27px 25px;
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  .note-number {
    display: block;
    margin-bottom: 26px;
    color: var(--accent);
    font-size: 12px;
    font-weight: 800;
  }

  .notes-grid h3 {
    margin: 0 0 10px;
    font-size: 19px;
  }

  .notes-grid p {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.75;
  }

  .notes-grid a {
    display: inline-block;
    margin-top: 15px;
    color: var(--accent);
    font-size: 13px;
    font-weight: 800;
  }

  /* FAQ */
  .faq-section {
    width: min(960px, 100%);
    margin: 115px auto 0;
  }

  .faq-heading {
    margin-bottom: 35px;
    text-align: center;
  }

  .faq-heading > p:last-child {
    margin: 15px 0 0;
    color: var(--muted);
    font-size: 15px;
  }

  .faq-list { border-top: 1px solid var(--line); }
  .faq-list details { border-bottom: 1px solid var(--line); }

  .faq-list summary {
    display: flex;
    align-items: center;
    justify-content: space