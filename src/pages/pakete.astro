
---
import BaseLayout from "../layouts/BaseLayout.astro";

const packages = [
  {
    name: "Basic",
    subtitle: "Perfekt für intime Hochzeiten",
    price: "1.290",
    hours: "4h",
    films: "1 Film",
    revisions: "1x Revision",
    target: "zweiter-videograf-basic",
    features: [
      "4 Stunden Begleitung",
      "Highlightfilm (3–5 Min.)",
      "Professioneller Schnitt",
      "Lizenzierte Musik",
      "Lieferung innerhalb 8 Wochen",
      "1 Korrekturschleife",
    ],
  },
  {
    name: "Classic",
    subtitle: "Mein beliebtestes Paket",
    price: "1.990",
    hours: "7h",
    films: "2 Filme",
    revisions: "2x Revision",
    target: "zweiter-videograf-classic",
    popular: true,
    features: [
      "7 Stunden Begleitung",
      "Highlightfilm (5–8 Min.)",
      "Kurzfilm für Social Media",
      "Erweiterte Farbkorrektur",
      "Lizenzierte Musik",
      "Lieferung innerhalb 8 Wochen",
      "2 Korrekturschleifen",
    ],
  },
  {
    name: "Premium",
    subtitle: "Das komplette Kinoerlebnis",
    price: "2.390",
    hours: "12h",
    films: "2 Filme",
    revisions: "3x Revision",
    target: "zweiter-videograf-premium",
    features: [
      "Ganztägige Begleitung (bis zu 12h)",
      "Cinematic Highlightfilm (8–12 Min.)",
      "Kurzfilm für Social Media",
      "Erweiterte Farbkorrektur",
      "Drohnenaufnahmen inklusive",
      "Lieferung innerhalb 6 Wochen",
      "3 Korrekturschleifen",
    ],
  },
];

const individualFeatures = [
  "Film-Länge frei wählbar, z. B. 30–45 Min.",
  "Begleitungsdauer nach Wunsch",
  "Optional: Drohnenaufnahmen",
  "Standesamt / freie Trauung / Feier",
  "Optional: Social Media Clip",
  "Optional: Rohmaterial oder extra Versionen",
];

const faqs = [
  {
    question: "Welche Musik wird verwendet?",
    answer:
      "Ich verwende ausschließlich lizenzierte Musik aus professionellen Musikbibliotheken. Wenn ihr euch einen bestimmten Song wünscht, prüfen wir gemeinsam, ob eine rechtssichere Nutzung möglich ist. Falls dafür zusätzliche Lizenzkosten anfallen, sage ich euch das vorher transparent.",
  },
  {
    question: "Wie funktioniert die Anzahlung?",
    answer:
      "Nach der Buchung wird eine Anzahlung fällig. Erst nach Eingang der Anzahlung ist euer Termin verbindlich reserviert.",
  },
  {
    question: "Kann ich Änderungen am fertigen Film vornehmen?",
    answer:
      "Ja. Je nach Paket sind eine oder mehrere Korrekturschleifen enthalten. Kleinere Anpassungen können wir gemeinsam besprechen.",
  },
  {
    question: "Wie lange dauert die Lieferung?",
    answer:
      "Je nach Paket liegt die reguläre Lieferzeit meist zwischen 6 und 8 Wochen. Bei Expresslieferung kann der Film schneller fertiggestellt werden.",
  },
  {
    question: "Darf ich meinen Film auf Social Media teilen?",
    answer:
      "Ja, natürlich. Dafür eignet sich besonders ein zusätzlicher Kurzfilm oder ein Social-Media-Reel.",
  },
];
---

<BaseLayout
  title="Pakete & Preise | Hochzeitsvideograf Witten & NRW | VJ Production"
  description="Hochzeitsvideo-Pakete von VJ Production: Basic ab 1.290 €, Classic ab 1.990 € und Premium ab 2.390 €. Professionelle Hochzeitsfilme in NRW."
>
  <div class="prices-page" id="vjPricingPage">

    <!-- SEITENKOPF -->
    <header class="pricing-hero">
      <p class="pricing-eyebrow">Pakete &amp; Preise</p>

      <h1>Euer Tag verdient einen besonderen Film.</h1>

      <p class="pricing-intro">
        Ob intime Trauung oder große Hochzeitsfeier:
        Wählt die Begleitung, die zu eurem Tag passt.
        Persönlich, transparent und ohne versteckte Kosten.
      </p>

      <p class="pricing-tax">
        Preise gemäß § 19 UStG ohne Ausweis der Mehrwertsteuer.
      </p>
    </header>

    <!-- PAKETE -->
    <section class="pricing-packages" aria-labelledby="pricing-packages-title">
      <div class="pricing-section-head">
        <p class="pricing-eyebrow">Eure Möglichkeiten</p>
        <h2 id="pricing-packages-title">
          Drei Pakete. Eure Geschichte.
        </h2>
      </div>

      <div class="pricing-packages-grid">
        {packages.map((item) => (
          <article
            class:list={[
              "pricing-package",
              { "pricing-package-featured": item.popular },
            ]}
          >
            {item.popular && (
              <span class="pricing-popular">
                Häufig gewählt
              </span>
            )}

            <div class="pricing-package-intro">
              <h3>{item.name}</h3>
              <p>{item.subtitle}</p>
              <div class="pricing-price">
                {item.price}<span> €</span>
              </div>
            </div>

            <div class="pricing-meta">
              <div>
                <strong>{item.hours}</strong>
                <span>Begleitung</span>
              </div>
              <div>
                <strong>{item.films}</strong>
                <span>Videos</span>
              </div>
              <div>
                <strong>{item.revisions}</strong>
                <span>Anpassungen</span>
              </div>
            </div>

            <ul class="pricing-features">
              {item.features.map((feature) => (
                <li>
                  <span aria-hidden="true">✓</span>
                  {feature}
                </li>
              ))}
            </ul>

            <details class="pricing-second" id={item.target}>
              <summary>
                <span>
                  Zweiter Videograf optional<br />
                  <strong>ab 350 €</strong>
                </span>

                <span class="pricing-second-action">
                  Mehr erfahren
                  <span aria-hidden="true">⌄</span>
                </span>
              </summary>

              <div class="pricing-second-content">
                <h4>Weitere Perspektiven auf euren Tag</h4>

                <p>
                  Auch mit einem Videografen lässt sich
                  euer Hochzeitstag umfassend und
                  authentisch begleiten.
                  Ein zweiter Videograf ist eine
                  optionale Erweiterung für Paare,
                  die sich zusätzliche Blickwinkel wünschen.
                </p>

                <p>
                  Besonders bei getrennten Getting Readys,
                  größeren Hochzeiten oder parallel
                  stattfindenden Momenten können so
                  weitere Perspektiven entstehen.
                </p>

                <p>
                  Der genaue Preis richtet sich nach
                  Dauer und Umfang der Begleitung.
                </p>
              </div>
            </details>

            <a class="pricing-button" href="/kontakt">
              Paket anfragen <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <!-- INDIVIDUELLES PAKET -->
    <section class="pricing-individual" aria-labelledby="individual-title">
      <div class="pricing-individual-copy">
        <p class="pricing-eyebrow">Individuelles Angebot</p>

        <h2 id="individual-title">
          So einzigartig wie euer Tag.
        </h2>

        <p>
          Nicht jede Hochzeit passt in ein festes Paket.
          Deshalb können wir gemeinsam eine Begleitung
          zusammenstellen, die zu euren Vorstellungen passt.
        </p>

        <strong class="pricing-individual-price">
          Auf Anfrage
        </strong>

        <a class="pricing-button" href="/kontakt">
          Individuell anfragen <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="pricing-individual-options">
        <h3>Individuell kombinierbar</h3>

        <ul>
          {individualFeatures.map((feature) => (
            <li>
              <span aria-hidden="true">✓</span>
              {feature}
            </li>
          ))}
        </ul>

        <details
          class="pricing-individual-second"
          id="zweiter-videograf-individuell"
        >
          <summary>
            <span>Zweiter Videograf optional · ab 350 €</span>
            <span aria-hidden="true">⌄</span>
          </summary>

          <p>
            Für zusätzliche Blickwinkel oder gleichzeitig
            stattfindende Momente. Die Kosten hängen von
            Dauer und Umfang der Begleitung ab.
          </p>
        </details>
      </div>
    </section>

    <!-- WICHTIGE HINWEISE -->
    <section class="pricing-notes" aria-labelledby="notes-title">
      <div class="pricing-section-head pricing-section-head-left">
        <p class="pricing-eyebrow">Gut zu wissen</p>
        <h2 id="notes-title">Wichtige Hinweise</h2>
      </div>

      <div class="pricing-notes-grid">
        <article>
          <span class="pricing-number">01</span>
          <h3>Reisekosten</h3>
          <p>0,50 € pro Kilometer für die Hin- und Rückfahrt.</p>
        </article>

        <article>
          <span class="pricing-number">02</span>
          <h3>Terminreservierung</h3>
          <p>
            Euer Hochzeitstermin ist nach Eingang
            der Anzahlung verbindlich reserviert.
          </p>
        </article>

        <article>
          <span class="pricing-number">03</span>
          <h3>Zusatzleistungen</h3>
          <p>
            Drohnenaufnahmen, Extra-Reels und
            Expresslieferung könnt ihr bei Bedarf ergänzen.
          </p>
          <a href="/zusatzleistungen">
            Alle Zusatzleistungen →
          </a>
        </article>
      </div>
    </section>

    <!-- FAQ -->
    <section
      class="pricing-faq"
      id="haeufige-fragen"
      aria-labelledby="pricing-faq-title"
    >
      <div class="pricing-section-head">
        <p class="pricing-eyebrow">Fragen &amp; Antworten</p>

        <h2 id="pricing-faq-title">
          Häufige Fragen
        </h2>

        <p>
          Damit ihr schon vor eurer Anfrage wisst,
          was euch erwartet.
        </p>
      </div>

      <div class="pricing-faq-list">
        {faqs.map((faq, index) => (
          <details open={index === 0}>
            <summary>
              <span>{faq.question}</span>

              <svg
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="m6 9 6 6 6-6"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </summary>

            <div class="pricing-faq-answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- ZUSATZLEISTUNGEN -->
    <section
      class="pricing-extras-promo"
      aria-labelledby="pricing-extras-title"
    >
      <div class="pricing-extras-copy">
        <p class="pricing-eyebrow">Eure Möglichkeiten</p>

        <h2 id="pricing-extras-title">
          Noch mehr aus eurem Hochzeitsfilm machen.
        </h2>

        <p>
          Vom zweiten Videografen über Drohnenaufnahmen
          bis zum Social-Media-Reel: Ergänzt eure
          Hochzeitsbegleitung mit ausgewählten Extras.
        </p>
      </div>

      <a href="/zusatzleistungen" class="pricing-extras-link">
        Extras entdecken
        <span aria-hidden="true">→</span>
      </a>
    </section>

    <!-- ABSCHLIESSENDER ANFRAGEBEREICH -->
    <section
      class="pricing-final-cta"
      aria-labelledby="pricing-final-title"
    >
      <p class="pricing-eyebrow">
        Eure Geschichte beginnt hier
      </p>

      <h2 id="pricing-final-title">
        Bereit für euren Film?
      </h2>

      <p class="pricing-final-description">
        Erzählt mir von euren Plänen.
        Gemeinsam finden wir heraus,
        welche Begleitung zu eurem Hochzeitstag passt.
      </p>

      <a href="/kontakt" class="pricing-final-button">
        Verfügbarkeit anfragen
        <span aria-hidden="true">→</span>
      </a>
    </section>

  </div>
</BaseLayout>

<script is:inline>
  (() => {
    function openDetailsFromHash() {
      const id = decodeURIComponent(
        window.location.hash.slice(1)
      );

      if (!id.startsWith("zweiter-videograf-")) {
        return;
      }

      const target = document.getElementById(id);

      if (!(target instanceof HTMLDetailsElement)) {
        return;
      }

      target.open = true;

      requestAnimationFrame(() => {
        target.scrollIntoView({
          behavior: window.matchMedia(
            "(prefers-reduced-motion: reduce)"
          ).matches
            ? "auto"
            : "smooth",
          block: "start",
        });
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener(
        "DOMContentLoaded",
        openDetailsFromHash,
        { once: true }
      );
    } else {
      openDetailsFromHash();
    }

    window.addEventListener(
      "hashchange",
      openDetailsFromHash
    );
  })();
</script>

<style is:global>
  /* ============================ */
  /* VJ PRODUCTION – PAKETE */
  /* ============================ */

  #vjPricingPage {
    --price-orange: #b46300;
    --price-orange-hover: #965000;
    --price-ink: #17181d;
    --price-muted: #696b73;
    --price-line: #e4e4e7;

    padding: 145px 24px 100px;
    background: #ffffff;
    color: var(--price-ink);
  }

  #vjPricingPage *,
  #vjPricingPage *::before,
  #vjPricingPage *::after {
    box-sizing: border-box;
  }

  #vjPricingPage a {
    text-decoration: none;
  }

  #vjPricingPage a:focus-visible,
  #vjPricingPage summary:focus-visible {
    outline: 3px solid var(--price-orange);
    outline-offset: 4px;
  }

  #vjPricingPage .pricing-eyebrow {
    margin: 0 0 15px;
    color: var(--price-orange);
    font-size: 11px;
    font-weight: 800;
    line-height: 1.5;
    letter-spacing: .2em;
    text-transform: uppercase;
  }

  /* SEITENKOPF */

  #vjPricingPage .pricing-hero {
    max-width: 850px;
    margin: 0 auto 83px;
    text-align: center;
  }

  #vjPricingPage .pricing-hero h1 {
    margin: 0;
    font-size: clamp(42px, 5.6vw, 76px);
    font-weight: 300;
    line-height: 1.07;
    letter-spacing: -.06em;
    text-wrap: balance;
  }

  #vjPricingPage .pricing-intro {
    max-width: 650px;
    margin: 24px auto 0;
    color: var(--price-muted);
    font-size: 17px;
    line-height: 1.75;
  }

  #vjPricingPage .pricing-tax {
    margin: 17px 0 0;
    color: #888a93;
    font-size: 13px;
  }

  #vjPricingPage .pricing-section-head {
    max-width: 780px;
    margin: 0 auto 43px;
    text-align: center;
  }

  #vjPricingPage .pricing-section-head h2 {
    margin: 0;
    font-size: clamp(32px, 4vw, 49px);
    font-weight: 350;
    line-height: 1.12;
    letter-spacing: -.05em;
    text-wrap: balance;
  }

  #vjPricingPage .pricing-section-head > p:last-child:not(.pricing-eyebrow) {
    margin: 16px 0 0;
    color: var(--price-muted);
    font-size: 15px;
    line-height: 1.7;
  }

  /* PAKETKARTEN */

  #vjPricingPage .pricing-packages,
  #vjPricingPage .pricing-individual,
  #vjPricingPage .pricing-notes,
  #vjPricingPage .pricing-extras-promo,
  #vjPricingPage .pricing-final-cta {
    width: min(1240px, 100%);
    margin-left: auto;
    margin-right: auto;
  }

  #vjPricingPage .pricing-packages-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    align-items: stretch;
  }

  #vjPricingPage .pricing-package {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 36px 29px 28px;
    border: 1px solid var(--price-line);
    border-radius: 18px;
    background: #fafafa;
  }

  #vjPricingPage .pricing-package-featured {
    border-color: var(--price-ink);
    background: var(--price-ink);
    color: #ffffff;
    box-shadow: 0 23px 55px rgba(23,24,29,.15);
  }

  #vjPricingPage .pricing-popular {
    position: absolute;
    top: -14px;
    right: 22px;
    padding: 8px 13px;
    border-radius: 5px;
    background: #d38b32;
    color: #ffffff;
    font-size: 11px;
    font-weight: 800;
  }

  #vjPricingPage .pricing-package-intro {
    min-height: 151px;
    text-align: center;
  }

  #vjPricingPage .pricing-package-intro h3 {
    margin: 0;
    font-size: 27px;
    font-weight: 600;
    letter-spacing: -.045em;
  }

  #vjPricingPage .pricing-package-intro > p {
    margin: 10px 0 0;
    color: var(--price-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  #vjPricingPage .pricing-package-featured .pricing-package-intro > p {
    color: rgba(255,255,255,.67);
  }

  #vjPricingPage .pricing-price {
    margin-top: 23px;
    font-size: 45px;
    font-weight: 350;
    line-height: 1.15;
    letter-spacing: -.055em;
    white-space: nowrap;
  }

  #vjPricingPage .pricing-price span {
    font-size: 20px;
    font-weight: 400;
  }

  #vjPricingPage .pricing-meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    padding: 21px 0;
    border-top: 1px solid var(--price-line);
    border-bottom: 1px solid var(--price-line);
  }

  #vjPricingPage .pricing-package-featured .pricing-meta {
    border-color: rgba(255,255,255,.19);
  }

  #vjPricingPage .pricing-meta > div {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    min-width: 0;
    text-align: center;
  }

  #vjPricingPage .pricing-meta strong {
    color: var(--price-orange);
    font-size: 16px;
    font-weight: 800;
  }

  #vjPricingPage .pricing-package-featured .pricing-meta strong {
    color: #ffb45a;
  }

  #vjPricingPage .pricing-meta span {
    color: var(--price-muted);
    font-size: 11px;
  }

  #vjPricingPage .pricing-package-featured .pricing-meta span {
    color: rgba(255,255,255,.65);
  }

  #vjPricingPage .pricing-features {
    display: grid;
    align-content: start;
    flex: 1;
    gap: 15px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  #vjPricingPage .pricing-features li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: #53565e;
    font-size: 14px;
    line-height: 1.55;
  }

  #vjPricingPage .pricing-features li > span {
    color: var(--price-orange);
    font-weight: 900;
  }

  #vjPricingPage .pricing-package-featured .pricing-features li {
    color: rgba(255,255,255,.84);
  }

  #vjPricingPage .pricing-package-featured .pricing-features li > span {
    color: #ffb45a;
  }

  /* ZWEITER VIDEOGRAF */

  #vjPricingPage .pricing-second {
    margin-top: 27px;
    border-top: 1px solid var(--price-line);
    scroll-margin-top: 110px;
  }

  #vjPricingPage .pricing-package-featured .pricing-second {
    border-color: rgba(255,255,255,.19);
  }

  #vjPricingPage .pricing-second summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 18px 0;
    cursor: pointer;
    list-style: none;
  }

  #vjPricingPage .pricing-second summary::-webkit-details-marker,
  #vjPricingPage .pricing-individual-second summary::-webkit-details-marker,
  #vjPricingPage .pricing-faq summary::-webkit-details-marker {
    display: none;
  }

  #vjPricingPage .pricing-second summary::marker,
  #vjPricingPage .pricing-individual-second summary::marker,
  #vjPricingPage .pricing-faq summary::marker {
    content: "";
  }

  #vjPricingPage .pricing-second summary > span:first-child {
    color: var(--price-muted);
    font-size: 12px;
    line-height: 1.6;
  }

  #vjPricingPage .pricing-second summary strong {
    color: var(--price-ink);
    font-size: 13px;
  }

  #vjPricingPage .pricing-package-featured .pricing-second summary > span:first-child {
    color: rgba(255,255,255,.72);
  }

  #vjPricingPage .pricing-package-featured .pricing-second summary strong {
    color: #ffffff;
  }

  #vjPricingPage .pricing-second-action {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--price-orange);
    font-size: 11px;
    font-weight: 800;
    white-space: nowrap;
  }

  #vjPricingPage .pricing-package-featured .pricing-second-action {
    color: #ffb45a;
  }

  #vjPricingPage .pricing-second[open] .pricing-second-action > span {
    transform: rotate(180deg);
  }

  #vjPricingPage .pricing-second-content {
    padding: 5px 0 15px;
  }

  #vjPricingPage .pricing-second-content h4 {
    margin: 0 0 13px;
    font-size: 16px;
  }

  #vjPricingPage .pricing-second-content p {
    margin: 0 0 12px;
    color: var(--price-muted);
    font-size: 13px;
    line-height: 1.7;
  }

  #vjPricingPage .pricing-package-featured .pricing-second-content p {
    color: rgba(255,255,255,.75);
  }

  #vjPricingPage .pricing-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    min-height: 51px;
    margin-top: 17px;
    padding: 12px 19px;
    border-radius: 7px;
    background: var(--price-orange);
    color: #ffffff;
    font-size: 14px;
    font-weight: 800;
    transition: background .2s ease;
  }

  #vjPricingPage .pricing-button:hover {
    background: var(--price-orange-hover);
  }

  /* INDIVIDUELLES PAKET */

  #vjPricingPage .pricing-individual {
    display: grid;
    grid-template-columns: .95fr 1.05fr;
    align-items: center;
    gap: clamp(35px, 6vw, 100px);
    margin-top: 25px;
    padding: clamp(34px, 5vw, 65px);
    border: 1px solid var(--price-line);
