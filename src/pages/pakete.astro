
---
import BaseLayout from "../layouts/BaseLayout.astro";

const packages = [
  {
    name: "Basic",
    subtitle: "Perfekt für intime Hochzeiten",
    price: "1.290",
    hours: "4h",
    films: "1 Film",
    revisions: "1x Revision",
    secondVideographerTarget: "zweiter-videograf-basic",
    features: [
      "4 Stunden Begleitung",
      "Highlightfilm (3–5 Min.)",
      "Professioneller Schnitt",
      "Lizenzierte Musik",
      "Lieferung innerhalb 8 Wochen",
      "1 Korrekturschleife",
    ],
  },
  {
    name: "Classic",
    subtitle: "Mein beliebtestes Paket",
    price: "1.990",
    hours: "7h",
    films: "2 Filme",
    revisions: "2x Revision",
    popular: true,
    secondVideographerTarget: "zweiter-videograf-classic",
    features: [
      "7 Stunden Begleitung",
      "Highlightfilm (5–8 Min.)",
      "Kurzfilm für Social Media",
      "Erweiterte Farbkorrektur",
      "Lizenzierte Musik",
      "Lieferung innerhalb 8 Wochen",
      "2 Korrekturschleifen",
    ],
  },
  {
    name: "Premium",
    subtitle: "Das komplette Kinoerlebnis",
    price: "2.390",
    hours: "12h",
    films: "2 Filme",
    revisions: "3x Revision",
    secondVideographerTarget: "zweiter-videograf-premium",
    features: [
      "Ganztägige Begleitung (bis zu 12h)",
      "Cinematic Highlightfilm (8–12 Min.)",
      "Kurzfilm für Social Media",
      "Erweiterte Farbkorrektur",
      "Drohnenaufnahmen inklusive",
      "Lieferung innerhalb 6 Wochen",
      "3 Korrekturschleifen",
    ],
  },
];

const individualFeatures = [
  "Film-Länge frei wählbar, z. B. 30–45 Min.",
  "Begleitungsdauer nach Wunsch",
  "Optional: Drohnenaufnahmen",
  "Standesamt / freie Trauung / Feier",
  "Optional: Social Media Clip",
  "Optional: Rohmaterial oder extra Versionen",
];

const faqs = [
  {
    question: "Welche Musik wird verwendet?",
    answer:
      "Ich verwende ausschließlich lizenzierte Musik aus professionellen Musikbibliotheken. Wenn ihr euch einen bestimmten Song wünscht, prüfen wir gemeinsam, ob eine rechtssichere Nutzung möglich ist. Falls dafür zusätzliche Lizenzkosten anfallen, sage ich euch das vorher transparent.",
  },
  {
    question: "Wie funktioniert die Anzahlung?",
    answer:
      "Nach der Buchung wird eine Anzahlung fällig. Erst nach Eingang der Anzahlung ist euer Termin verbindlich reserviert.",
  },
  {
    question: "Kann ich Änderungen am fertigen Film vornehmen?",
    answer:
      "Ja. Je nach Paket sind eine oder mehrere Korrekturschleifen enthalten. Kleinere Anpassungen können wir gemeinsam besprechen.",
  },
  {
    question: "Wie lange dauert die Lieferung?",
    answer:
      "Je nach Paket liegt die reguläre Lieferzeit meist zwischen 6 und 8 Wochen. Bei Expresslieferung kann der Film schneller fertiggestellt werden.",
  },
  {
    question: "Darf ich meinen Film auf Social Media teilen?",
    answer:
      "Ja, natürlich. Dafür eignet sich besonders ein zusätzlicher Kurzfilm oder ein Social-Media-Reel.",
  },
];
---

<BaseLayout
  title="Pakete & Preise | Hochzeitsvideograf Witten & NRW | VJ Production"
  description="Hochzeitsvideo Pakete und Preise von VJ Production. Basic ab 1.290 €, Classic ab 1.990 € und Premium ab 2.390 €. Hochzeitsvideograf in Witten, NRW und deutschlandweit."
>
  <div class="prices-page">

    <!-- SEITENKOPF -->
    <header class="prices-head">
      <p class="eyebrow">Pakete & Preise</p>

      <h1>
        Euer Tag verdient<br />
        einen besonderen Film.
      </h1>

      <p class="intro-text">
        Ob intime Trauung oder große Hochzeitsfeier:
        Wählt die Begleitung, die zu eurem Tag passt.
        Persönlich, transparent und ohne versteckte Kosten.
      </p>

      <p class="tax-note">
        Preise gemäß § 19 UStG ohne Ausweis der Mehrwertsteuer.
      </p>
    </header>

    <!-- DREI HAUPTPAKETE -->
    <section
      class="packages-section"
      aria-labelledby="packages-title"
    >
      <div class="section-intro">
        <p class="eyebrow">Eure Möglichkeiten</p>
        <h2 id="packages-title">Drei Pakete. Eure Geschichte.</h2>
      </div>

      <div class="packages-grid">
        {packages.map((item) => (
          <article
            class:list={[
              "package-card",
              { "is-popular": item.popular },
            ]}
          >
            {item.popular && (
              <div class="popular-label">
                Häufig gewählt
              </div>
            )}

            <div class="package-top">
              <h3>{item.name}</h3>
              <p class="package-subtitle">{item.subtitle}</p>

              <p class="package-price">
                {item.price}<span> €</span>
              </p>
            </div>

            <div class="package-meta">
              <div>
                <span class="meta-value">{item.hours}</span>
                <span class="meta-label">Begleitung</span>
              </div>

              <div>
                <span class="meta-value">{item.films}</span>
                <span class="meta-label">Videos</span>
              </div>

              <div>
                <span class="meta-value">{item.revisions}</span>
                <span class="meta-label">Anpassungen</span>
              </div>
            </div>

            <ul class="package-features">
              {item.features.map((feature) => (
                <li>
                  <span class="feature-check" aria-hidden="true">
                    ✓
                  </span>
                  <span>{feature}</span>
                </li>
              ))}
            </ul>

            <!-- ZWEITER VIDEOGRAF -->
            <details
              class="second-videographer"
              id={item.secondVideographerTarget}
            >
              <summary>
                <span class="second-videographer-label">
                  Zweiter Videograf optional<br />
                  <strong>ab 350 €</strong>
                </span>

                <span class="details-action">
                  Mehr erfahren
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      d="m6 9 6 6 6-6"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </summary>

              <div class="second-videographer-content">
                <h4>Weitere Perspektiven auf euren Tag</h4>

                <p>
                  Auch mit einem Videografen lässt sich euer
                  Hochzeitstag umfassend und authentisch
                  begleiten. Ein zweiter Videograf ist eine
                  optionale Erweiterung für Paare, die sich
                  noch mehr Blickwinkel und parallel
                  eingefangene Momente wünschen.
                </p>

                <p>
                  Besonders bei getrennten Getting Readys,
                  größeren Hochzeiten oder gleichzeitig
                  stattfindenden Momenten können zusätzliche
                  Perspektiven entstehen.
                </p>

                <p>
                  Der genaue Preis richtet sich nach Dauer
                  und Umfang der zusätzlichen Begleitung.
                </p>
              </div>
            </details>

            <a class="package-button" href="/kontakt">
              Paket anfragen
              <span aria-hidden="true">→</span>
            </a>
          </article>
        ))}
      </div>
    </section>

    <!-- INDIVIDUELLES PAKET -->
    <section
      class="individual-section"
      aria-labelledby="individual-title"
    >
      <div class="individual-copy">
        <p class="eyebrow">Individuelles Angebot</p>

        <h2 id="individual-title">
          So einzigartig wie euer Tag.
        </h2>

        <p>
          Nicht jede Hochzeit passt in ein festes Paket.
          Deshalb können wir gemeinsam eine Begleitung
          zusammenstellen, die zu euren Vorstellungen passt.
        </p>

        <p class="individual-price">
          Auf Anfrage
        </p>

        <a class="individual-button" href="/kontakt">
          Individuell anfragen
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="individual-details">
        <h3>Individuell kombinierbar</h3>

        <ul class="individual-features">
          {individualFeatures.map((feature) => (
            <li>
              <span aria-hidden="true">✓</span>
              {feature}
            </li>
          ))}
        </ul>

        <details
          class="individual-second"
          id="zweiter-videograf-individuell"
        >
          <summary>
            <span>Zweiter Videograf optional · ab 350 €</span>
            <span aria-hidden="true" class="details-chevron">⌄</span>
          </summary>

          <div class="individual-second-content">
            <p>
              Ein zweiter Videograf kann für zusätzliche
              Blickwinkel oder gleichzeitig stattfindende
              Programmpunkte hinzugebucht werden.
              Die Kosten hängen von Dauer und Umfang ab.
            </p>
          </div>
        </details>
      </div>
    </section>

    <!-- TRANSPARENTE HINWEISE -->
    <section
      class="notes-section"
      aria-labelledby="notes-title"
    >
      <div class="notes-heading">
        <p class="eyebrow">Gut zu wissen</p>
        <h2 id="notes-title">Wichtige Hinweise</h2>
      </div>

      <div class="notes-grid">
        <article>
          <span class="note-number">01</span>
          <h3>Reisekosten</h3>
          <p>
            0,50 € pro Kilometer für die Hin- und Rückfahrt.
          </p>
        </article>

        <article>
          <span class="note-number">02</span>
          <h3>Terminreservierung</h3>
          <p>
            Euer Hochzeitstermin ist nach Eingang
            der Anzahlung verbindlich reserviert.
          </p>
        </article>

        <article>
          <span class="note-number">03</span>
          <h3>Zusatzleistungen</h3>
          <p>
            Drohnenaufnahmen, Extra-Reels und
            Expresslieferung könnt ihr bei Bedarf
            ergänzen.
          </p>

          <a href="/zusatzleistungen">
            Alle Zusatzleistungen →
          </a>
        </article>
      </div>
    </section>

    <!-- FAQ -->
    <section
      class="faq-section"
      aria-labelledby="faq-title"
    >
      <div class="faq-heading">
        <p class="eyebrow">Fragen & Antworten</p>
        <h2 id="faq-title">Häufige Fragen</h2>
        <p>
          Damit ihr schon vor eurer Anfrage wisst,
          was euch erwartet.
        </p>
      </div>

      <div class="faq-list">
        {faqs.map((faq, index) => (
          <details open={index === 0}>
            <summary>
              <span>{faq.question}</span>

              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="m6 9 6 6 6-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </summary>

            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- NACHTRÄGLICHES HOCHZEITSVIDEO -->
    <section
      class="late-video-card"
      aria-labelledby="late-title"
    >
      <div>
        <p class="eyebrow">Eine weitere Möglichkeit</p>

        <h2 id="late-title">
          Nachträgliches Hochzeitsvideo
        </h2>

        <p>
          Ihr hattet an eurem Hochzeitstag keinen
          Videografen? Auch nach der Hochzeit können
          wir eure Geschichte in einem professionellen
          Shooting filmisch festhalten.
        </p>
      </div>

      <a href="/nachtraegliches-hochzeitsvideo">
        Mehr erfahren
        <span aria-hidden="true">→</span>
      </a>
    </section>

    <!-- KONTAKT -->
    <section
      class="prices-cta"
      aria-labelledby="cta-title"
    >
      <p class="eyebrow">Eure Geschichte beginnt hier</p>

      <h2 id="cta-title">
        Bereit für euren Film?
      </h2>

      <p>
        Erzählt mir von euren Plänen. Gemeinsam
        finden wir heraus, welche Begleitung
        zu eurem Hochzeitstag passt.
      </p>

      <a href="/kontakt">
        Verfügbarkeit anfragen
        <span aria-hidden="true">→</span>
      </a>
    </section>

  </div>
</BaseLayout>

<style>
  :global(body) {
    background: #fff;
  }

  .prices-page {
    --accent: var(--vj-accent, #b46300);
    --accent-hover: #965000;
    --ink: #17181d;
    --muted: #696b73;
    --border: #e6e6e8;

    padding: 144px 24px 94px;
    color: var(--ink);
    background: #fff;
  }

  .prices-page *,
  .prices-page *::before,
  .prices-page *::after {
    box-sizing: border-box;
  }

  .prices-page a {
    text-decoration: none;
  }

  .prices-page a:focus-visible,
  .prices-page summary:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  .eyebrow {
    margin: 0 0 16px;
    color: var(--accent);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .2em;
    line-height: 1.5;
  }

  /* SEITENKOPF */
  .prices-head {
    width: min(850px, 100%);
    margin: 0 auto 83px;
    text-align: center;
  }

  .prices-head h1 {
    margin: 0;
    font-size: clamp(42px, 5.6vw, 76px);
    font-weight: 300;
    letter-spacing: -.06em;
    line-height: 1.06;
    text-wrap: balance;
  }

  .intro-text {
    max-width: 660px;
    margin: 24px auto 0;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.75;
  }

  .tax-note {
    margin: 16px 0 0;
    color: #898b94;
    font-size: 13px;
    line-height: 1.5;
  }

  /* ABSCHNITTSTITEL */
  .section-intro {
    margin-bottom: 40px;
    text-align: center;
  }

  .section-intro h2 {
    margin: 0;
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 350;
    letter-spacing: -.05em;
    line-height: 1.1;
  }

  /* PAKETKARTEN */
  .packages-section {
    width: min(1240px, 100%);
    margin-inline: auto;
  }

  .packages-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    align-items: stretch;
  }

  .package-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 36px 29px 28px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: #fafafa;
  }

  .package-card.is-popular {
    border-color: #17181d;
    background: #17181d;
    color: #fff;
    box-shadow: 0 23px 55px rgba(23,24,29,.15);
  }

  .popular-label {
    position: absolute;
    top: -14px;
    right: 22px;
    padding: 8px 13px;
    border-radius: 5px;
    background: #d38b32;
    color: #fff;
    font-size: 11px;
    font-weight: 800;
  }

  .package-top {
    min-height: 151px;
    text-align: center;
  }

  .package-top h3 {
    margin: 0;
    font-size: 27px;
    font-weight: 600;
    letter-spacing: -.045em;
  }

  .package-subtitle {
    margin: 10px 0 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .is-popular .package-subtitle {
    color: rgba(255,255,255,.65);
  }

  .package-price {
    margin: 23px 0 0;
    color: inherit;
    font-size: 45px;
    font-weight: 350;
    line-height: 1.15;
    letter-spacing: -.055em;
    white-space: nowrap;
  }

  .package-price span {
    font-size: 20px;
    font-weight: 400;
  }

  /* PAKET-METADATEN */
  .package-meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    padding: 21px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .is-popular .package-meta {
    border-color: rgba(255,255,255,.19);
  }

  .package-meta > div {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    min-width: 0;
    text-align: center;
  }

  .meta-value {
    color: var(--accent);
    font-size: 16px;
    font-weight: 800;
    line-height: 1.3;
  }

  .is-popular .meta-value {
    color: #ffb45a;
  }

  .meta-label {
    color: var(--muted);
    font-size: 11px;
    line-height: 1.35;
  }

  .is-popular .meta-label {
    color: rgba(255,255,255,.62);
  }

  /* PAKETLEISTUNGEN */
  .package-features {
    flex: 1;
    display: grid;
    align-content: start;
    gap: 15px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .package-features li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    color: #53565e;
    font-size: 14px;
    line-height: 1.55;
  }

  .feature-check {
    flex: 0 0 auto;
    color: var(--accent);
    font-weight: 900;
  }

  .is-popular .package-features li {
    color: rgba(255,255,255,.83);
  }

  .is-popular .feature-check {
    color: #ffb45a;
  }

  /* ZWEITER VIDEOGRAF */
  .second-videographer {
    margin-top: 27px;
    border-top: 1px solid var(--border);
    scroll-margin-top: 110px;
  }

  .is-popular .second-videographer {
    border-color: rgba(255,255,255,.19);
  }

  .second-videographer summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 18px 0;
    list-style: none;
    cursor: pointer;
  }

  .second-videographer summary::-webkit-details-marker {
    display: none;
  }

  .second-videographer summary::marker {
    content: "";
  }

  .second-videographer-label {
    color: #60636c;
    font-size: 12px;
    line-height: 1.55;
  }

  .second-videographer-label strong {
    color: var(--ink);
    font-size: 13px;
  }

  .is-popular .second-videographer-label {
    color: rgba(255,255,255,.69);
  }

  .is-popular .second-videographer-label strong {
    color: #fff;
  }

  .details-action {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    flex: 0 0 auto;
    color: var(--accent);
    font-size: 11px;
    font-weight: 800;
    white-space: nowrap;
  }

  .is-popular .details-action {
    color: #ffb45a;
  }

  .details-action svg {
    width: 15px;
    height: 15px;
    transition: transform .2s ease;
  }

  .second-videographer[open] .details-action svg {
    transform: rotate(180deg);
  }

  .second-videographer-content {
    padding: 5px 0 15px;
  }

  .second-videographer-content h4 {
    margin: 0 0 13px;
    font-size: 16px;
    line-height: 1.4;
  }

  .second-videographer-content p {
    margin: 0 0 12px;
    color: #646670;
    font-size: 13px;
    line-height: 1.7;
  }

  .is-popular .second-videographer-content p {
    color: rgba(255,255,255,.75);
  }

  /* PAKETBUTTONS */
  .package-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    min-height: 51px;
    margin-top: 16px;
    padding: 12px 19px;
    border-radius: 7px;
    background: var(--accent);
    color: #fff;
    font-size: 14px;
    font-weight: 800;
    transition: background .18s ease;
  }

  .package-button:hover {
    background: var(--accent-hover);
  }

  /* INDIVIDUELLES PAKET */
  .individual-section {
    width: min(1240px, 100%);
    display: grid;
    grid-template-columns: .95fr 1.05fr;
    gap: clamp(35px, 6vw, 100px);
    align-items: center;
    margin: 25px auto 0;
    padding: clamp(34px, 5vw, 65px);
    border: 1px solid var(--border);
    border-radius: 18px;
    background: #f7f7f7;
  }

  .individual-copy h2 {
    margin: 0;
    font-size: clamp(31px, 3.4vw, 44px);
    font-weight: 350;
    line-height: 1.12;
    letter-spacing: -.05em;
    text-wrap: balance;
  }

  .individual-copy > p:not(.eyebrow):not(.individual-price) {
    max-width: 530px;
    margin: 20px 0 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.75;
  }

  .individual-price {
    margin: 26px 0 0;
    font-size: 25px;
    font-weight: 650;
    letter-spacing: -.04em;
  }

  .individual-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 13px;
    min-height: 49px;
    margin-top: 25px;
    padding: 12px 21px;
    border-radius: 7px;
    background: var(--accent);
    color: #fff;
    font-size: 14px;
    font-weight: 800;
  }

  .individual-button:hover {
    background: var(--accent-hover);
  }

  .individual-details {
    padding: 28px;
    border: 1px solid #e6e6e8;
    border-radius: 12px;
    background: #fff;
  }

  .individual-details h3 {
    margin: 0 0 23px;
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -.035em;
  }

  .individual-features {
    display: grid;
    gap: 15px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .individual-features li {
    display: flex;
    gap: 13px;
    color: #53565e;
    font-size: 14px;
    line-height: 1.5;
  }

  .individual-features li span {
    color: var(--accent);
    font-weight: 900;
  }

  .individual-second {
    margin-top: 25px;
    border-top: 1px solid var(--border);
    scroll-margin-top: 110px;
  }

  .individual-second summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 17px 0 0;
    color: var(--accent);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.5;
    cursor: pointer;
    list-style: none;
  }

  .individual-second summary::-webkit-details-marker {
    display: none;
  }

