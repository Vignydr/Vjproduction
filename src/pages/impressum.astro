            Bekanntwerden von Rechtsverletzungen werde ich derartige Inhalte umgehend
            entfernen.
          </p>
        </section>

        <p class="updated">Zuletzt aktualisiert: 05.2026</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  :global(body) {
    background: white;
  }

  .legal-page {
    background: white;
    color: #17181d;
    padding: 150px 20px 120px;
  }

  .legal-inner {
    width: min(920px, 100%);
    margin: 0 auto;
  }

  .kicker {
    margin: 0 0 18px;
    color: #df7b00;
    text-transform: uppercase;
    letter-spacing: 0.34em;
    font-size: 12px;
    font-weight: 700;
  }

  h1 {
    margin: 0 0 58px;
    color: #17181d;
    font-size: clamp(48px, 6vw, 82px);
    font-weight: 300;
    letter-spacing: -0.065em;
    line-height: 1.02;
  }

  .legal-content {
    display: grid;
    gap: 34px;
  }

  section {
    padding-bottom: 4px;
  }

  h2 {
    margin: 0 0 10px;
    color: #17181d;
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  p {
    margin: 0 0 14px;
    color: #4f5058;
    font-size: 18px;
    line-height: 1.68;
  }

  a {
    color: #df7b00;
    text-decoration: none;
    font-weight: 600;
  }

  a:hover {
    text-decoration: underline;
  }

  strong {
    color: #17181d;
    font-weight: 800;
  }

  .updated {
    margin-top: 28px;
    color: #9a9ba3;
    font-size: 15px;
  }

  @media (max-width: 620px) {
    .legal-page {
      padding: 130px 16px 80px;
    }

    h1 {
      margin-bottom: 42px;
    }

    p {
      font-size: 16px;
    }

    h2 {
      font-size: 18px;
    }
  }
</style>