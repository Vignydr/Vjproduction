---
import BaseLayout from "../layouts/BaseLayout.astro";

const requirements = [
  "Ihr plant eine freie Trauung oder heiratet an einer besonders schönen Kulisse.",
  "Es gibt persönliche Gelübde, emotionale Reden oder besondere Momente.",
  "Ihr seid offen vor der Kamera und habt Lust auf natürliche, echte Aufnahmen.",
  "Ihr geht liebevoll, emotional und authentisch miteinander um.",
  "Ihr seid bereit für ein von der Fotografin unabhängiges Paarshooting für den Film.",
  "Ihr wünscht euch keinen klassischen Zusammenschnitt, sondern einen Film mit Geschichte.",
];

const includes = [
  {
    title: "Professioneller Hochzeitsfilm",
    text: "Ein emotional erzählter Film eures Tages, der nicht nur dokumentiert, sondern eure Geschichte spürbar macht.",
  },
  {
    title: "Cinematische Aufnahmen",
    text: "Ruhige Bewegungen, echte Nähe, Details, Atmosphäre und Momente, die im Trubel des Tages oft untergehen.",
  },
  {
    title: "Storytelling statt Standardvideo",
    text: "Gelübde, Reden, Stimmen und echte Emotionen werden so verbunden, dass ein Film mit Tiefe entsteht.",
  },
  {
    title: "Persönliche Begleitung",
    text: "Vom ersten Kennenlernen bis zur finalen Umsetzung begleite ich euch ehrlich, ruhig und unkompliziert.",
  },
];

const process = [
  {
    step: "01",
    title: "Kontaktaufnahme",
    text: "Ihr meldet euch kurz mit eurem Datum, eurer Location und ein paar Worten zu euch und eurer Hochzeit.",
  },
  {
    step: "02",
    title: "Kennenlernen",
    text: "Wir schauen gemeinsam, ob eure Hochzeit zum Filmprojekt passt und ob die Vorstellung auf beiden Seiten stimmt.",
  },
  {
    step: "03",
    title: "Auswahl",
    text: "Da nur wenige Plätze vergeben werden, wähle ich die Paare aus, bei denen das Konzept wirklich stimmig ist.",
  },
];
---

<BaseLayout
  title="Filmprojekt 2026 | Hochzeitsvideograf NRW | VJ Production"
  description="Kostenlose videografische Begleitung für ausgewählte Hochzeiten 2026. Exklusives Hochzeitsfilm-Projekt von VJ Production für emotionale Hochzeitsfilme mit Storytelling."
>
  <section class="project-page">
    <section class="project-hero">
      <p class="kicker">Exklusives Filmprojekt 2026</p>

      <h1>Kostenlose videografische Begleitung für ausgewählte Hochzeiten 2026.</h1>

      <p class="hero-text">
        Ich suche besondere Brautpaare für emotionale Hochzeitsfilme mit echtem Storytelling.
        Die Begleitung ist kostenlos, lediglich die Fahrtkosten werden übernommen.
        Voraussetzung ist, dass der entstandene Film sowie ausgewählte Ausschnitte veröffentlicht werden dürfen.
      </p>

      <div class="hero-actions">
        <a href="#bewerben" class="primary-button">Jetzt bewerben <span>→</span></a>
        <a href="#film" class="secondary-button">Beispiel ansehen</a>
      </div>

      <div class="trust-row">
        <span>Maximal 5 Paare</span>
        <span>Nur Fahrtkosten</span>
        <span>Veröffentlichung Voraussetzung</span>
      </div>
    </section>

    <section class="video-section" id="film">
      <div class="section-head">
        <p>Einblick</p>
        <h2>So kann sich ein emotional erzählter Film anfühlen</h2>
        <span>
          Ein Beispiel aus meinem Portfolio. Ruhig, cineastisch und mit Fokus auf echte Nähe.
        </span>
      </div>

      <div class="video-frame">
        <iframe
          src="https://galleries.vidflow.co/videos/b2ayyew1"
          title="Hochzeitsfilm Beispiel von VJ Production"
          loading="lazy"
          allow="fullscreen; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    </section>

    <section class="intro-section">
      <div>
        <p class="kicker">Warum dieses Projekt?</p>
        <h2>Es geht nicht darum, möglichst viele Hochzeiten kostenlos zu filmen.</h2>
      </div>

      <div class="intro-text">
        <p>
          Dieses Projekt ist bewusst begrenzt. Ich möchte 2026 nur wenige Hochzeiten begleiten,
          bei denen ich filmisch freier, kreativer und persönlicher erzählen kann.
        </p>

        <p>
          Der Film soll keine klassische Zusammenfassung des Tages werden. Es geht um ein
          emotionales Storytelling: echte Stimmen, persönliche Gelübde, Reden, kleine Gesten,
          Blicke und Momente, die euren Tag einzigartig machen.
        </p>

        <p>
          Die videografische Begleitung ist kostenlos. Lediglich die Fahrtkosten müssten
          übernommen werden. Voraussetzung ist, dass der entstandene Film sowie ausgewählte
          Ausschnitte veröffentlicht werden dürfen.
        </p>
      </div>
    </section>

    <section class="requirements-section">
      <div class="section-head">
        <p>Für wen?</p>
        <h2>Dieses Projekt passt zu euch, wenn...</h2>
        <span>
          Ich suche Paare, bei denen nicht Perfektion im Vordergrund steht, sondern echte
          Verbindung, Persönlichkeit und Emotionen.
        </span>
      </div>

      <div class="requirements-list">
        {requirements.map((item) => (
          <div class="requirement-item">
            <span></span>
            <p>{item}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="includes-section">
      <div class="section-head">
        <p>Was ihr erhaltet</p>
        <h2>Ein Film, der mehr ist als ein Rückblick.</h2>
      </div>

      <div class="include-grid">
        {includes.map((item) => (
          <article class="include-card">
            <div class="card-dot"></div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="limited-section">
      <div>
        <p class="kicker">Begrenzte Plätze</p>
        <h2>Maximal 5 Paare werden ausgewählt.</h2>
        <p>
          Damit jeder Film die Aufmerksamkeit bekommt, die er verdient, ist dieses Projekt
          bewusst limitiert. Ich möchte mir für jedes Paar genug Zeit nehmen, um nicht einfach
          nur schöne Bilder zu sammeln, sondern eine echte Geschichte zu erzählen.
        </p>
      </div>
    </section>

    <section class="process-section">
      <div class="section-head">
        <p>Ablauf</p>
        <h2>Der Bewerbungsprozess</h2>
        <span>
          Unkompliziert, persönlich und ehrlich. Es geht darum herauszufinden, ob eure Hochzeit
          zu diesem Filmprojekt passt.
        </span>
      </div>

      <div class="process-grid">
        {process.map((item) => (
          <article class="process-card">
            <span>{item.step}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="contact-section" id="bewerben">
      <div class="contact-card">
        <p class="kicker">Bewerbung</p>
        <h2>Ihr könnt euch vorstellen, Teil dieses Projekts zu sein?</h2>
        <p>
          Dann schreibt mir kurz, wer ihr seid, wann und wo ihr heiratet und was euren Tag
          besonders macht. Ich melde mich persönlich bei euch zurück.
        </p>

        <div class="contact-actions">
          <a
            class="whatsapp-button"
            href="https://wa.me/4915561237671?text=Hallo%20Vigny%2C%20wir%20m%C3%B6chten%20uns%20f%C3%BCr%20das%20Filmprojekt%202026%20bewerben.%20"
            target="_blank"
            rel="noopener noreferrer"
          >
            Jetzt per WhatsApp für das Filmprojekt bewerben <span>→</span>
          </a>

          <a class="mail-button" href="mailto:info@vjproduction.de?subject=Bewerbung Filmprojekt 2026">
            Per E-Mail bewerben
          </a>
        </div>

        <div class="contact-info">
          <span>WhatsApp: +49 15561 237671</span>
          <span>E-Mail: info@vjproduction.de</span>
        </div>
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  :global(body) {
    background: white;
  }

  .project-page {
    background: white;
    color: #17181d;
    padding: 135px 20px 108px;
  }

  .project-hero {
    width: min(1080px, 100%);
    margin: 0 auto 96px;
    text-align: center;
  }

  .kicker,
  .section-head p {
    margin: 0 0 18px;
    color: #df7b00;
    text-transform: uppercase;
    letter-spacing: 0.34em;
    font-size: 12px;
    font-weight: 800;
  }

  .project-hero h1 {
    max-width: 1050px;
    margin: 0 auto;
    color: #17181d;
    font-size: clamp(42px, 5.8vw, 78px);
    font-weight: 300;
    letter-spacing: -0.075em;
    line-height: 1.04;
  }

  .hero-text {
    max-width: 870px;
    margin: 30px auto 0;
    color: #5f6068;
    font-size: clamp(17px, 1.7vw, 22px);
    line-height: 1.72;
  }

  .hero-actions {
    margin-top: 40px;
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .primary-button,
  .secondary-button,
  .whatsapp-button,
  .mail-button {
    min-height: 52px;
    padding: 0 30px;
    border-radius: 7px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    font-size: 15px;
    font-weight: 800;
    text-decoration: none;
  }

  .primary-button,
  .whatsapp-button {
    background: #df7b00;
    color: white;
  }

  .secondary-button,
  .mail-button {
    border: 1px solid #dedfe3;
    background: white;
    color: #17181d;
  }

  .trust-row {
    margin: 42px auto 0;
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .trust-row span {
    padding: 10px 16px;
    border-radius: 999px;
    background: #f8f8f9;
    color: #5f6068;
    font-size: 14px;
    font-weight: 700;
  }

  .video-section,
  .requirements-section,
  .includes-section,
  .process-section,
  .contact-section {
    width: min(1120px, 100%);
    margin: 0 auto 96px;
  }

  .section-head {
    margin: 0 auto 46px;
    text-align: center;
  }

  .section-head h2,
  .intro-section h2,
  .limited-section h2,
  .contact-card h2 {
    margin: 0;
    color: #17181d;
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 300;
    letter-spacing: -0.06em;
    line-height: 1.08;
  }

  .section-head span {
    display: block;
    max-width: 720px;
    margin: 20px auto 0;
    color: #777984;
    font-size: 16px;
    line-height: 1.65;
  }

  .video-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 24px;
    background: #17181d;
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.16);
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .intro-section {
    width: min(1120px, 100%);
    margin: 0 auto 96px;
    padding: 58px 60px;
    border-radius: 28px;
    background: #f8f8f9;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 54px;
    align-items: start;
  }

  .intro-text {
    display: grid;
    gap: 22px;
  }

  .intro-text p,
  .limited-section p,
  .contact-card p {
    margin: 0;
    color: #5f6068;
    font-size: 17px;
    line-height: 1.78;
  }

  .requirements-list {
    display: grid;
    gap: 16px;
  }

  .requirement-item {
    padding: 22px 24px;
    border-radius: 18px;
    background: #f8f8f9;
    display: grid;
    grid-template-columns: 12px 1fr;
    gap: 18px;
    align-items: start;
  }

  .requirement-item span,
  .card-dot {
    width: 10px;
    height: 10px;
    margin-top: 8px;
    border-radius: 999px;
    background: #df7b00;
  }

  .requirement-item p {
    margin: 0;
    color: #4f5058;
    font-size: 16px;
    line-height: 1.62;
  }

  .include-grid,
  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .include-card,
  .process-card {
    padding: 30px;
    border-radius: 20px;
    background: white;
    border: 1px solid #dedfe3;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.035);
  }

  .include-card h3,
  .process-card h3 {
    margin: 22px 0 14px;
    color: #17181d;
    font-size: 20px;
    letter-spacing: -0.035em;
    line-height: 1.2;
  }

  .include-card p,
  .process-card p {
    margin: 0;
    color: #5f6068;
    font-size: 15.5px;
    line-height: 1.68;
  }

  .limited-section {
    width: min(1120px, 100%);
    margin: 0 auto 96px;
  }

  .limited-section > div {
    padding: 72px 60px;
    border-radius: 30px;
    background: #17181d;
    color: white;
    text-align: center;
  }

  .limited-section h2 {
    color: white;
  }

  .limited-section p {
    max-width: 820px;
    margin: 28px auto 0;
    color: rgba(255, 255, 255, 0.72);
  }

  .process-grid {
    grid-template-columns: repeat(3, 1fr);
  }

  .process-card span {
    color: #df7b00;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .process-card h3 {
    margin-top: 22px;
  }

  .contact-section {
    margin-bottom: 0;
  }

  .contact-card {
    padding: 72px 40px;
    border-radius: 30px;
    background: #f8f8f9;
    text-align: center;
  }

  .contact-card p {
    max-width: 760px;
    margin: 26px auto 0;
  }

  .contact-actions {
    margin-top: 38px;
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .contact-info {
    margin-top: 30px;
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .contact-info span {
    padding: 10px 16px;
    border-radius: 999px;
    background: white;
    color: #5f6068;
    font-size: 14px;
    font-weight: 700;
  }

  @media (max-width: 1000px) {
    .intro-section {
      grid-template-columns: 1fr;
    }

    .include-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .process-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .project-page {
      padding: 120px 14px 80px;
    }

    .project-hero {
      margin-bottom: 74px;
    }

    .project-hero h1 {
      font-size: clamp(38px, 10vw, 54px);
    }

    .hero-text {
      font-size: 16px;
    }

    .primary-button,
    .secondary-button,
    .whatsapp-button,
    .mail-button {
      width: 100%;
    }

    .video-section,
    .intro-section,
    .requirements-section,
    .includes-section,
    .limited-section,
    .process-section,
    .contact-section {
      margin-bottom: 76px;
    }

    .intro-section,
    .limited-section > div,
    .contact-card {
      padding: 34px 22px;
      border-radius: 22px;
    }

    .include-grid {
      grid-template-columns: 1fr;
    }

    .include-card,
    .process-card {
      padding: 26px;
    }

    .contact-info {
      display: grid;
      gap: 10px;
    }
  }
</style>