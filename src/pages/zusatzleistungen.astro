  line-height: 1.6;
}

.cta a {
  height: 50px;
  font-size: 15px;
}

@media (max-width: 900px) {
  .drone-main,
  .drone-note {
    padding: 42px 30px;
  }

  .drone-main p,
  .drone-note p {
    font-size: 16px;
  }
}

@media (max-width: 620px) {
  .extras-page {
    padding: 120px 14px 80px;
  }
}</style>